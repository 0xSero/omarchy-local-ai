#!/bin/bash

# omarchy:summary=Set up Local AI once: Docker without a password prompt, and GPU support
# omarchy:requires-sudo=true
set -euo pipefail
POLICY=/etc/polkit-1/actions/sero.local-ai.u$(id -u).policy
RULES=/etc/polkit-1/rules.d/49-sero.local-ai.u$(id -u).rules
# Keep a failed setup visible in the terminal opened by the panel.
finish() {
  local rc=$?
  if [[ -t 0 ]]; then
    ((rc == 0)) || echo "Setup did not finish. Resolve the error above, then click Set up Local AI again."
    read -r -p "Press Enter to close. " _ || true
  fi
}
trap finish EXIT
mkdir -p "$HOME/.local/state/omarchy/local-ai"
exec 9>"$HOME/.local/state/omarchy/local-ai/setup.lock"
flock -n 9 || { echo "Local AI setup is already open."; exit 1; }
sudo -v
if omarchy-hw-nvidia; then
  info=$(sudo docker info --format '{{json .Runtimes}}')
  if ! jq -e 'has("nvidia")' <<<"$info" >/dev/null; then
    [[ -z $(sudo docker ps -q) ]] || { echo "Stop your running Docker containers before setting up NVIDIA support. Nothing was changed."; exit 1; }
    echo "Installing NVIDIA container support..."
    omarchy-pkg-add nvidia-container-toolkit
    sudo nvidia-ctk runtime configure --runtime=docker
    sudo systemctl restart docker
    sudo docker info --format '{{json .Runtimes}}' | jq -e 'has("nvidia")' >/dev/null
  fi
fi

# Local AI starts its containers as you, so it needs Docker without a prompt: Omarchy's own Sudoless Docker, which
# explains what that means and asks. Local AI uses it at once; the reboot it mentions is not needed for Local AI.
OMARCHY_DEFER_REBOOT=1 omarchy-setup-security-sudoless-docker
omarchy-sudo-docker --configured && { echo "Local AI needs Sudoless Docker to start models. Nothing else was changed."; exit 1; }
# the group applies from the next login; until then let this account reach the daemon, so Local AI works now
sock=${OMARCHY_DOCKER_SOCKET:-/var/run/docker.sock}
[[ -w $sock ]] || sudo setfacl -m "u:$USER:rw" "$sock"

# sharing a model on your tailnet without a prompt
if command -v tailscale >/dev/null; then
  sudo tailscale set --operator="$USER" || echo "Tailscale is not running; sharing on your tailnet will work once it is and you run setup again."
fi

# earlier versions asked for a password through polkit; nothing uses these any more
if sudo test -e "$POLICY" -o -e "$RULES"; then
  sudo rm -f "$POLICY" "$RULES"
  sudo systemctl reload polkit
fi
echo "Local AI is ready. Return to the panel to choose a model."
