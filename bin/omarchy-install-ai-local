#!/bin/bash

# omarchy:summary=Set up Local AI once: Docker without a password prompt, and GPU support
# omarchy:requires-sudo=true
set -euo pipefail
HERE=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source=../lib/access.sh
. "$HERE/../lib/access.sh"
POLICY=/etc/polkit-1/actions/sero.local-ai.u$(id -u).policy
RULES=/etc/polkit-1/rules.d/49-sero.local-ai.u$(id -u).rules
ERROR=$HOME/.local/state/omarchy/local-ai/setup-error
# Keep a failed setup visible in the terminal opened by the panel.
finish() {
  local rc=$?
  if ((rc)); then
    echo "Setup did not finish; choose Set up Local AI to try again." >"$ERROR"
  else
    rm -f "$ERROR"
  fi
  [[ -z ${KEEPALIVE:-} ]] || kill "$KEEPALIVE" 2>/dev/null || true
  if [[ -t 0 ]]; then
    ((rc == 0)) || echo "Setup did not finish. Resolve the error above, then click Set up Local AI again."
    read -r -p "Press Enter to close. " _ || true
  fi
}
mkdir -p "$HOME/.local/state/omarchy/local-ai"
exec 9>"$HOME/.local/state/omarchy/local-ai/setup.lock"
flock -n 9 || { echo "Local AI setup is already open."; exit 1; }
trap finish EXIT
rm -f "$ERROR"
# one password prompt that says whose it is and what it is for; kept alive so a slow download does not ask again
echo "Local AI setup turns on Docker access for your account (Omarchy's Sudoless Docker) and GPU support."
sudo -p "Password for %u to set up Local AI: " -v
while sudo -n true; do sleep 60; done 2>/dev/null &
KEEPALIVE=$!
if omarchy-hw-nvidia; then
  info=$(sudo docker info --format '{{json .Runtimes}}')
  if ! runtimes_have_nvidia <<<"$info"; then
    [[ -z $(sudo docker ps -q) ]] || { echo "Stop your running Docker containers before setting up NVIDIA support. Nothing was changed."; exit 1; }
    echo "Installing NVIDIA container support..."
    omarchy-pkg-add nvidia-container-toolkit
    sudo nvidia-ctk runtime configure --runtime=docker
    sudo systemctl restart docker
    sudo docker info --format '{{json .Runtimes}}' | runtimes_have_nvidia
  fi
fi

# Local AI starts its containers as you, so it needs Docker without a prompt: Omarchy's own Sudoless Docker, which
# explains what that means and asks. Local AI works at once: this login gets the docker group when Local AI next asks
# Docker (lib/access.sh), so neither a logout nor the reboot Omarchy mentions is needed.
OMARCHY_DEFER_REBOOT=1 omarchy-setup-security-sudoless-docker
sudoless_docker_on || { echo "Local AI needs Sudoless Docker to start models. Nothing else was changed."; exit 1; }

# sharing a model on your tailnet without a prompt
if command -v tailscale >/dev/null; then
  if operator=$(timeout 10 tailscale debug prefs 2>/dev/null | jq -er '.OperatorUser // "" | select(type == "string")'); then
    if [[ -z $operator || $operator == "$USER" ]]; then
      timeout 20 sudo tailscale set --operator="$USER" || echo "Tailscale is not running; sharing on your tailnet will work once it is and you run setup again."
    else
      echo "Tailscale is managed by another account; ask that account to share your models."
    fi
  else
    echo "Could not read Tailscale preferences; its operator was left unchanged."
  fi
fi

# earlier versions asked for a password through polkit; nothing uses these any more
if sudo test -e "$POLICY" -o -e "$RULES"; then
  sudo rm -f "$POLICY" "$RULES"
  sudo systemctl reload polkit
fi
echo "Local AI is ready. Return to the panel to choose a model."
