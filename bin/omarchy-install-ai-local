#!/bin/bash

# omarchy:summary=Set up Local AI once: Docker access for your account, and NVIDIA container support
set -euo pipefail
HERE=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source=../lib/access.sh
. "$HERE/../lib/access.sh"
STATE=$HOME/.local/state/omarchy/local-ai
ERROR=$STATE/setup-error
# Keep a failed setup visible in the terminal opened by the panel.
finish() {
  local rc=$?
  if ((rc)); then
    echo "Setup did not finish; choose Set up Local AI to try again." >"$ERROR"
  else
    rm -f "$ERROR"
  fi
  if [[ -t 0 ]]; then
    ((rc == 0)) || echo "Setup did not finish. Resolve the error above, then click Set up Local AI again."
    read -r -p "Press Enter to close. " _ || true
  fi
}
mkdir -p "$STATE"
exec 9>"$STATE/setup.lock"
flock -n 9 || { echo "Local AI setup is already open."; exit 1; }
trap finish EXIT
rm -f "$ERROR"

# Local AI changes nothing as root itself. It runs two of Omarchy's commands, and names the password each may ask for.
echo "Local AI setup: Docker access for your account (Omarchy's Sudoless Docker) and, on NVIDIA, the container toolkit."

# Local AI starts its containers as you: Omarchy's Sudoless Docker explains what that means and asks first. This login
# reaches Docker at once through the group (lib/access.sh), so the reboot Omarchy mentions is not needed for Local AI.
if ! docker_access_configured; then
  SUDO_PROMPT="Password for %u to turn on Sudoless Docker for Local AI: " OMARCHY_DEFER_REBOOT=1 \
    omarchy-setup-security-sudoless-docker
  docker_access_configured || { echo "Local AI needs Sudoless Docker to start models. Nothing else was changed."; exit 1; }
fi

# NVIDIA: installing the toolkit is all it takes. Its package hook writes /etc/cdi/nvidia.yaml, and Docker reads that
# file when a model starts: no daemon configuration, no Docker restart, no reboot. Already installed, this asks nothing.
if omarchy-hw-nvidia; then
  SUDO_PROMPT="Password for %u to install NVIDIA container support for Local AI: " \
    omarchy-pkg-add nvidia-container-toolkit
fi

# A card taken out or put in, or a driver update, leaves the toolkit's device list behind, and Docker then refuses
# every start through it. The toolkit's package hook writes the list on install, so reinstalling it, with Omarchy's own
# commands, writes it again; Local AI still runs nothing as root.
if omarchy-hw-nvidia && stale=$("$HERE/omarchy-local-ai" cdi) && [[ -n $stale ]]; then
  echo "The NVIDIA device list is out of date (${stale#*$'\t'}): reinstalling NVIDIA container support writes it again."
  SUDO_PROMPT="Password for %u to reinstall NVIDIA container support for Local AI: " omarchy-pkg-drop nvidia-container-toolkit &&
    SUDO_PROMPT="Password for %u to reinstall NVIDIA container support for Local AI: " omarchy-pkg-add nvidia-container-toolkit
fi

# the verdict the panel will show, asked the way a start asks it (under the docker group)
IFS=$'\t' read -r state msg < <("$HERE/omarchy-local-ai" readiness) || true
case $state in
ready) ;;
docker-down) echo "Setup is done, but ${msg:-Docker is not answering}. The panel clears this by itself once Docker answers." ;;
*) echo "${msg:-Local AI is still not ready.}"; exit 1 ;;
esac

# Sharing on your tailnet needs you as Tailscale's operator. Omarchy's Tailscale install sets it; Local AI never does.
if command -v tailscale >/dev/null &&
  operator=$(timeout 10 tailscale debug prefs 2>/dev/null | jq -er '.OperatorUser // ""') && [[ $operator != "$USER" ]]; then
  echo "To share a model on your tailnet, Tailscale's operator must be $USER (it is '${operator:-nobody}')."
  echo "Omarchy sets this when it installs Tailscale; otherwise run as root: tailscale set --operator=$USER"
fi

# Local AI 6.0-6.4 wrote polkit files for this account. Only root can delete them, so setup names them.
if [[ -e /etc/polkit-1/actions/sero.local-ai.u$UID.policy || -e /etc/polkit-1/rules.d/49-sero.local-ai.u$UID.rules ]]; then
  echo "An earlier Local AI left polkit files for your account. Delete them as root:"
  echo "  /etc/polkit-1/actions/sero.local-ai.u$UID.policy"
  echo "  /etc/polkit-1/rules.d/49-sero.local-ai.u$UID.rules"
fi
echo "Local AI is ready. Return to the panel to choose a model."
