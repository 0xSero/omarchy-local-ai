#!/bin/bash

# omarchy:summary=Set up Local AI: the NVIDIA container runtime when an NVIDIA card needs it
# omarchy:requires-sudo=true

# The card and the backend are already here (this plugin). What a first run can still lack is the
# NVIDIA container runtime, which Omarchy does not ship. Docker itself is part of Omarchy.

set -e

if omarchy-hw-nvidia && ! docker info 2>/dev/null | grep -qi nvidia; then
  echo "Setting up the NVIDIA container runtime..."
  omarchy-pkg-add nvidia-container-toolkit
  sudo nvidia-ctk runtime configure --runtime=docker
  sudo systemctl restart docker
fi

echo "Local AI is ready. Click its mark in the bar to run the model for your GPU."
