#!/bin/bash

# omarchy:summary=Run the model validated for your GPU and open a coding agent on it
# omarchy:args=setup | registry | forget <recipe> | snapshot | readiness | run <recipe> <gpu>[,<gpu>...] | stop <recipe> | open <recipe> | update <agent>|plugin | set agent|folder <value> [recipe] | set ping on|off | dirs <folder> | share <recipe> [off] | pin <recipe> [off] | download <recipe> [off] | card <recipe> | outdated | cdi | log | remove
# omarchy:hidden=true

# The backend of the Local AI bar widget. One running model is one folder, $STATE/deploy/<recipe>:
# config.json (which cards, which port, which agent and folder) and status.json (what it is doing now).
# `snapshot` reads those with the GPUs and the vendored recipes and prints what the widget draws.
#
# `run` downloads the weights as you and checks every file against the Hub, then starts the engine on a private
# network and a keyed gateway on the model's own Docker network (gw_addr), as you: setup puts you in the docker group
# once (Omarchy's Sudoless Docker), and a login that began before that runs the verbs that use Docker under the group
# (lib/access.sh), so nothing waits for the next login.
# Nothing here runs as root, so there is no password prompt after setup and none after an update.

# jq programs and child shell programs deliberately keep their own dollar expansions.
# shellcheck disable=SC2016
set -euo pipefail
shopt -s nullglob
exec </dev/null

TARGET=$(readlink -f -- "${BASH_SOURCE[0]}")
PANEL=${TARGET%/bin/*}
# The refreshed catalog's folder is the version of the refresh filter that wrote it (cmd_registry): v4 holds only
# shipped recipes, unchanged in what they run. A catalog an earlier version refreshed (v3) passed weaker checks and is
# never read.
CATALOG=$HOME/.cache/omarchy/local-ai/v4/recipes.json
RECIPES=$PANEL/recipes.json
# a refreshed catalog wins until the plugin is updated: an update brings recipes newer than any earlier refresh
[[ ! $CATALOG -nt $RECIPES ]] || RECIPES=$CATALOG
LABEL=io.omarchy.local-ai
SYS=${LOCAL_AI_SYSFS:-/sys}
AGENTS=(pi claude codex opencode omp crush grok copilot hermes workbuddy)
umask 077

paths() {
  HOME_DIR=$1
  STATE=$HOME_DIR/.local/state/omarchy/local-ai
  MODELS=$HOME_DIR/.cache/omarchy/local-ai/models
  # a cache or state folder moved to another disk behind a symlink is still the user's own
  if command -v realpath >/dev/null; then
    STATE=$(realpath -m -- "$STATE")
    MODELS=$(realpath -m -- "$MODELS")
  fi
  KEY=$STATE/gateway.key
  AUTH=$STATE/gateway.auth
  LOG=$STATE/log
}

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
say() { printf '%s %s\n' "$(now)" "$*" >>"$LOG"; }
die() { printf 'local-ai: %s\n' "$*" >&2; exit 1; }
# Bound daemon calls; image pulls get time to transfer, a start time for the GPU hooks, ordinary operations do not.
# --foreground keeps the call in the worker's process group, so a Stop that kills the group ends it too.
docker() {
  local t=30
  case ${1:-} in pull|wait) t=7200 ;; run) t=120 ;; logs) [[ ${2:-} != --follow ]] || t=7200 ;; esac
  timeout --foreground --kill-after=5 "$t" docker "$@"
}
# notify: a desktop notification; its text can carry engine log lines, so <, > and & are dropped and no notification
# server can read them as markup
notify() {
  local a=() x
  for x in "$@"; do a+=("${x//[<>&]/}"); done
  omarchy-notification-send --app-name "Local AI" "${a[@]}" 2>/dev/null || echo 0
}
# hf_curl: curl with the Hugging Face token, when there is one, as a header read from a pipe: never in an argv, never
# left on disk. In a subshell (a pipeline, or started with &) it becomes curl, so $! is curl's pid and a cancel stops it.
hf_curl() {
  local t=$HOME_DIR/.cache/huggingface/token e=
  ((BASHPID == $$)) || e=exec
  if [[ -s $t ]]; then $e curl -H @<(printf 'Authorization: Bearer %s\n' "$(<"$t")") "$@"; else $e curl "$@"; fi
}
valid_id() { [[ $1 =~ ^[a-z0-9][a-z0-9.-]{0,63}$ ]]; }
valid_key() { [[ $1 =~ ^(nvidia|intel-xpu|amd-rocm):[0-9]{1,2}$ || $1 == cpu:0 ]]; }
dir_of() { printf '%s/deploy/%s' "$STATE" "$1"; }

# status <id> <state> [detail] [percent] [error]: what the widget shows; the log gets each new step once
status() {
  local d was
  d=$(dir_of "$1")
  mkdir -p "$d"
  was=$(jq -r '"\(.state) \(.detail)"' "$d/status.json" 2>/dev/null || true)
  jq -nc --arg s "$2" --arg d "${3:-}" --argjson p "${4:-0}" --arg e "${5:-}" --arg t "$(now)" --argjson pid "$$" \
    '{state: $s, detail: $d, percent: $p, error: $e, pid: $pid, at: $t}' >"$d/status.json.$$"
  mv -f "$d/status.json.$$" "$d/status.json"
  [[ $was == "$2 ${3:-}" ]] || say "$1 $2 ${3:-}${5:+ error: $5}"
}

# recipe <id>: a second copy of a recipe runs as <recipe>--2, and so on
recipe() {
  jq -ce --arg id "${1%--*}" \
    '[.hardware | to_entries[] | .key as $h | .value.recipes[] | select(.id == $id) | . + {hw: $h}][0] // empty' "$RECIPES"
}

# Every string of a recipe that becomes a path, an argument or an image is checked before anything runs.
policy() {
  jq -er --slurpfile all "${2:-$RECIPES}" '
    def name: test("^([A-Za-z0-9_-][A-Za-z0-9_.-]*)?$");
    # a comma-separated list of names or relative paths; no traversal
    def names: test("^(([A-Za-z0-9_-][A-Za-z0-9_./-]*)(,([A-Za-z0-9_-][A-Za-z0-9_./-]*))*)?$")
               and (contains("..") | not);
    def abs: test("^/[A-Za-z0-9_./-]+$") and (contains("..") | not);
    def strings: type == "array" and length > 0 and all(.[]; type == "string" and (contains("\u0000") | not));
    def resources:
      type == "object" and (keys - ["memoryBytes", "memorySwapBytes", "memlockUnlimited", "ipcLock"] | length == 0)
      and all(to_entries[]; if (.key == "memoryBytes" or .key == "memorySwapBytes") then
        (.value | type == "number" and . == floor and . > 0 and . <= 9007199254740991) else (.value | type == "boolean") end)
      and (if has("memorySwapBytes") then has("memoryBytes") and .memorySwapBytes >= .memoryBytes else true end);
    if (.image | test("^[a-z0-9./_:-]+@sha256:[0-9a-f]{64}$") | not) then "image is not pinned by digest"
    elif ($all[0].gateway.image | test("^[a-z0-9./_:-]+@sha256:[0-9a-f]{64}$") | not) then "gateway is not pinned by digest"
    elif ((.cards // 1) | (. < 1 or . > 8)) then "invalid card count"
    elif ([.weights[]? | select(
        (.repository | test("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$") | not) or (.revision | test("^[0-9a-f]{40}$") | not)
        or (.layout != "dir" and .layout != "hub") or (.mountPath | abs | not)
        or (.dir // "" | name | not) or (.files // "" | names | not))] | length) > 0 then "invalid weights"
    elif (.asset != null and ((.asset.name | test("^[A-Za-z0-9_-][A-Za-z0-9_.-]*$") | not) or (.asset.mountPath | abs | not))) then "invalid asset"
    elif ((.launch.port | type) != "number") then "invalid port"
    elif ((.launch.environment | type) != "object" or any(.launch.environment | to_entries[]; (.key | test("^[A-Za-z_][A-Za-z0-9_]*$") | not) or (.value | type != "string" or contains("\u0000")))) then "invalid environment"
    elif ([.launch.arguments[]? | select(type != "string" or contains("\u0000"))] | length) > 0 then "invalid arguments"
    elif (.launch.entrypoint // "" | test("^[A-Za-z0-9_./-]*$") | not) then "invalid entrypoint"
    elif (.launch.shm // "" | test("^([0-9]+[kmg]?)?$") | not) then "invalid shm size"
    elif ((.launch.flags // []) | length > 0) then "arbitrary launch flags are unsupported"
    elif ((.launch.resources // {}) | resources | not) then "invalid resources"
    elif (.prepare != null and (.prepare |
        (type == "object" and (keys == ["args", "at", "gpu", "sizeGb", "verifyArgs"])
         and (.at | test("^/(models|nvx|prepared)(/[A-Za-z0-9_.-]+)*$") and (contains("..") | not))
         and (.args | strings) and (.verifyArgs | strings) and (.gpu | type == "boolean")
         and (.sizeGb | type == "number" and . > 0 and . < 100000)) | not)) then "invalid preparation"
    elif (.prepare != null and (.prepare.at as $out | any(.weights[]?; .mountPath as $raw |
        $out == $raw or ($out | startswith($raw + "/"))))) then "input mount masks prepared output"
    else "ok" end' <<<"$1"
}

# counted: whether this install is counted at all: only once you turn it on (`set ping on`, or Allow on home), never
# with DO_NOT_TRACK; until then nothing is kept either
counted() { [[ ${DO_NOT_TRACK:-0} == 0 && $(jq -r '.ping // ""' "$STATE/settings.json" 2>/dev/null) == on ]]; }
# count <action>: one more started, failed (a start that did not finish), opened (an agent) or downloaded, kept in
# counts.json until a ping delivers it: totals only, never which model, agent or folder. It never fails its caller.
count() {
  [[ $1 =~ ^(started|failed|opened|downloaded)$ ]] && counted || return 0
  (
    exec 6>>"$STATE/counts.lock"
    flock -w 5 6 || exit 0
    { jq -c . "$STATE/counts.json" 2>/dev/null || echo '{}'; } | jq -c --arg a "$1" '.[$a] = ((.[$a] // 0) + 1)' >"$STATE/counts.json.$$" &&
      mv -f "$STATE/counts.json.$$" "$STATE/counts.json"
  ) 2>/dev/null || true
}

# ping: count this install (README, "What Local AI sends"): a random id made on first run, the version, the card kinds
# it has recipes for, how many models run, whether a model has ever answered here, and the actions since the last ping
# that arrived. A ping that does not arrive keeps them for the next. It never fails its caller.
ping() {
  local f=$STATE/install-id hw n=0 d v="" sent launched=false
  counted || return 0
  [[ $(cat "$f" 2>/dev/null) =~ ^[0-9a-f]{32}$ ]] || (umask 077 && od -An -tx1 -N16 /dev/urandom | tr -d ' \n' >"$f") || return 0
  [[ $(<"$f") =~ ^[0-9a-f]{32}$ ]] || return 0
  [[ $(<"$PANEL/manifest.json") =~ \"version\":\ *\"([^\"]+)\" ]] && v=${BASH_REMATCH[1]}
  hw=$(gpus none 2>/dev/null | jq -c '[.[].hw | select(. != "")] | unique') || hw='[]'
  for d in "$STATE"/deploy/*/config.json; do n=$((n + 1)); done
  # every start that finished asked the model through the gateway, which logs each answer
  for d in "$STATE"/usage/*/usage.jsonl; do [[ -s $d ]] && { launched=true; break; }; done
  sent=$(jq -c 'with_entries(select((.key | IN("started", "failed", "opened", "downloaded")) and (.value | type == "number" and . > 0)))' \
    "$STATE/counts.json" 2>/dev/null) || sent=
  [[ -n $sent ]] || sent='{}'
  jq -nc --arg id "$(<"$f")" --arg v "$v" --argjson hw "${hw:-[]}" --argjson n "$n" --argjson l "$launched" --argjson a "$sent" \
    '{id: $id, version: $v, hw: $hw, running: $n, launched: $l, actions: $a}' |
    curl -fsS --proto '=https' --connect-timeout 5 --max-time 10 -o /dev/null -H 'Content-Type: application/json' \
      --data-binary @- https://usage.sybilsolutions.ai/v1/local-ai/ping 2>/dev/null || return 0
  [[ $sent != '{}' ]] || return 0
  # take off what arrived; actions counted while it was on its way stay
  (
    exec 6>>"$STATE/counts.lock"
    flock -w 5 6 || exit 0
    jq -c --argjson s "$sent" 'with_entries(.value -= ($s[.key] // 0)) | with_entries(select(.value > 0))' "$STATE/counts.json" >"$STATE/counts.json.$$" &&
      mv -f "$STATE/counts.json.$$" "$STATE/counts.json"
  ) 2>/dev/null || true
}

# Fetch only the registry's data, pinned to the commit resolved before downloading; every recipe checked before it
# replaces the catalog.
cmd_registry() (
  local sha tmp r
  umask 022
  install -d -m 755 "${CATALOG%/*}"
  exec 8>"${CATALOG%/*}/update.lock"
  flock -w 10 8 || die "a model refresh is already running"
  ping
  tmp=$(mktemp "${CATALOG%/*}/.recipes.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  sha=$(curl -fsSL --proto '=https' --connect-timeout 10 --max-time 30 --max-filesize 1048576 \
    https://api.github.com/repos/sybil-solutions/local-ai-registry/commits/main | jq -er .sha) || die "could not check the registry; existing models are unchanged"
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || die "invalid registry revision"
  curl -fsSL --proto '=https' --connect-timeout 10 --max-time 60 --max-filesize 10485760 \
    "https://raw.githubusercontent.com/sybil-solutions/local-ai-registry/$sha/plugin/v3/recipes.json" >"$tmp" ||
    die "could not download the registry; existing models are unchanged"
  jq -e '.schemaVersion == "omarchy-local-ai/recipes/3" and (.hardware | type == "object" and length > 0)
    and all(.hardware[]; (.recipes | type == "array" and length > 0))
    and all(.hardware[].recipes[]; .id | test("^[a-z0-9][a-z0-9.-]{0,63}$"))' "$tmp" >/dev/null || die "invalid registry catalog"
  # A refresh can only withdraw, reorder or relabel the recipes this plugin version ships; a new recipe, or any change to
  # what one runs, comes with a plugin release. Both checks are against the plugin's own recipes.json, the reviewed
  # file, never an earlier refresh: the gateway must be the one it ships, and each refreshed recipe that has a shipped
  # recipe of the same id under the same card kind becomes THAT SHIPPED RECIPE, with only these display fields taken
  # from the registry, each when it passes its check (else the shipped value stays): name, family and format (text
  # of at most 120 characters, no control characters, bidi controls, line separators or markup), sizeGb (a finite
  # number, not negative), aa (a finite number), reported and each capability the shipped recipe has (booleans).
  # Everything else, its image, launch, weights, serving, needs and the rest, is the shipped recipe's; each card kind
  # keeps its shipped match. A recipe the plugin does not ship is left out, not fatal; one listed twice counts once.
  jq -e --slurpfile own "$PANEL/recipes.json" '.gateway.image == $own[0].gateway.image' "$tmp" >/dev/null ||
    die "the registry changed the gateway; update the plugin to get it"
  r=$(jq --slurpfile own "$PANEL/recipes.json" '
    # no C0 or C1 controls, no bidirectional overrides, isolates or marks, no line or paragraph separators
    def text: type == "string" and length <= 120 and (test("[<>]") | not) and (explode | all(. >= 32 and (. < 127 or . > 159)
      and (. < 8234 or . > 8238) and (. < 8294 or . > 8297) and (. < 8206 or . > 8207) and . != 8232 and . != 8233 and . != 1564));
    def finite: type == "number" and (isinfinite | not) and (isnan | not);
    $own[0].hardware as $shipped
    | .hardware |= (with_entries(select($shipped[.key] != null) | .key as $h
        | .value = {match: $shipped[$h].match, recipes: ([.value.recipes[]? | select(type == "object") | . as $r
            | first($shipped[$h].recipes[] | select(.id == $r.id)) // empty
            | reduce ("name", "family", "format") as $f (.; if ($r[$f] | text) then .[$f] = $r[$f] else . end)
            | if ($r.sizeGb | finite and . >= 0) then .sizeGb = $r.sizeGb else . end
            | if ($r.aa | finite) then .aa = $r.aa else . end
            | if ($r.reported | type == "boolean") then .reported = $r.reported else . end
            | if (.capabilities | type == "object") and ($r.capabilities | type == "object") then
                .capabilities |= with_entries(.key as $k | if ($r.capabilities[$k] | type == "boolean") then .value = $r.capabilities[$k] else . end)
              else . end]
          | reduce .[] as $x ([]; if any(.[]; .id == $x.id) then . else . + [$x] end))})
      | with_entries(select(.value.recipes | length > 0)))' "$tmp") || die "invalid registry catalog"
  printf '%s\n' "$r" >"$tmp"
  while IFS= read -r r; do
    [[ $(policy "$r" "$tmp") == "ok" ]] || die "registry recipe refused: $(policy "$r" "$tmp")"
  done < <(jq -c '.hardware[].recipes[]' "$tmp")
  r=$(jq --arg sha "$sha" --arg at "$(now)" '.registryCommit = $sha | .refreshedAt = $at' "$tmp")
  printf '%s\n' "$r" >"$tmp"
  # the panel must be drawable from it, as the snapshot draws it, before it replaces the catalog in use
  jq -e --argjson host "$(host)" "$NEEDS$SUMMARY"'[.hardware | to_entries[] | .value.match.backend as $b
    | .value.recipes[] | summary($host) | select($b | type == "string")] | length >= 0' "$tmp" >/dev/null ||
    die "the registry's models could not be shown; existing models are unchanged"
  chmod 644 "$tmp"
  mv -f "$tmp" "$CATALOG"
  rm -f -- "$STATE/catalog-fallback"
  printf 'models up to date · %.8s\n' "$sha"
)

# Setup is offered inside the plugin; the terminal shows Omarchy's password prompts and package progress. Whether it is needed is what the
# machine is (lib/access.sh), never which plugin version set it up, so an update never asks for it again.
cmd_readiness() { readiness; }

cmd_setup() { omarchy-launch-tui --app-id=org.omarchy.local-ai-setup "$PANEL/bin/omarchy-install-ai-local"; }

# cdi_stale: the first NVIDIA CDI spec, and why, that no longer matches /dev: a device it lists is gone (a card was
# removed, so /dev/nvidia1 with it) or has moved (a driver update moved /dev/nvidia-uvm from 237 to 238). Docker
# checks every device in the spec, so either stops any start through it. Prints "<spec>\t<why>".
cdi_stale() {
  local d f p ma mi x y
  for d in ${CDI_DIRS:-/etc/cdi /var/run/cdi}; do
    for f in "$d"/nvidia*.yaml; do
      [[ -f $f ]] || continue
      while read -r p ma mi; do
        if [[ ! -e $p ]]; then
          printf '%s\t%s is gone\n' "$f" "$p"
          return
        fi
        read -r x y < <(stat -c '%t %T' "$p") || continue
        if ((16#$x != ma || 16#$y != mi)); then
          printf '%s\t%s has moved\n' "$f" "$p"
          return
        fi
      done < <(awk '/^ *- /{if (p != "" && ma != "") print p, ma, mi; p = ""; ma = ""; mi = 0}
        /^ *- path: \/dev\//{p = $3} p != "" && $1 == "major:"{ma = $2} p != "" && $1 == "minor:"{mi = $2}
        END{if (p != "" && ma != "") print p, ma, mi}' "$f")
    done
  done
}

# nvidia: index, name, memory, temperature, UUID and free memory per card, as nvidia-smi prints them
nvidia() {
  local out
  out=$(timeout 10 nvidia-smi --query-gpu=index,name,memory.total,memory.used,temperature.gpu,uuid,memory.free --format=csv,noheader,nounits 2>/dev/null) || true
  # nvidia-utils without a driver has nvidia-smi print why it failed on stdout: only CSV rows are cards
  grep -E '^[0-9]+, ' <<<"$out" || true
}

# nvidia_apps: every program with a context on an NVIDIA card, as "<card UUID>, <pid>, <process>, <MiB>". The card's
# memory.used also counts what nobody owns (the display's framebuffer) and the desktop's own compositor, so what
# another program holds is the sum of these, not the card's total.
nvidia_apps() {
  local out
  out=$(timeout 10 nvidia-smi --query-compute-apps=gpu_uuid,pid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null) || true
  grep -E '^GPU-' <<<"$out" || true
}

# Intel GPUs the recipes know, by PCI id (Arc Pro B70, Arc Pro B65, Arc B390). The xe driver gives users its temperature but not its memory use. A card with
# a connected monitor drives the desktop, whose compositor and browsers hold part of its memory, so it is offered last.
# The Arc B390 is a Panther Lake iGPU: its memory is host RAM, so it reports none (its card is unifiedMemory).
intel() {
  local a d t f c s product mib rows=()
  while read -r a d; do
    case ${d#*:} in
      e223) product="Intel Arc Pro B70" mib=32768 ;;
      e222) product="Intel Arc Pro B65" mib=32768 ;;
      b080) product="Intel Arc B390" mib=0 ;;
      *) continue ;;
    esac
    [[ -e /dev/dri/by-path/pci-$a-render ]] || continue
    t=null
    f=$(grep -lx pkg /sys/bus/pci/devices/"$a"/hwmon/hwmon*/temp*_label 2>/dev/null | head -1 || true)
    [[ -n $f ]] && t=$(($(<"${f%_label}_input") / 1000))
    s=0
    for c in "$SYS"/bus/pci/devices/"$a"/drm/card*; do
      for f in "$SYS"/class/drm/"${c##*/}"-*/status; do [[ $(cat "$f" 2>/dev/null) == connected ]] && s=1; done
    done
    rows+=("$t" "$(readlink -f "/dev/dri/by-path/pci-$a-render")" "$s" "$product" "$mib")
  done < <(lspci -Dn -d 8086: 2>/dev/null | awk '{print $1, $3}' | sort -u)
  # temperature, render node, whether it drives a display, product and memory, one card a line
  ((${#rows[@]} == 0)) || printf '%s\t%s\t%s\t%s\t%s\n' "${rows[@]}"
}

# smi <name> <amd-smi command...>: its JSON, or {} when it fails. amd-smi can crash its Python on some builds
# (a segfault in libpython3.14, issue #118); a subcommand that died of a signal is not run again for a day, so the
# panel's polling does not crash it every few seconds, and its readings show as unknown until then.
smi() {
  local mark=$STATE/amd-smi-$1.crashed out rc=0
  shift
  [[ -n $(find "$mark" -mmin -1440 2>/dev/null) ]] && { echo '{}'; return; }
  out=$(timeout 10 "$@" 2>/dev/null) || rc=$?
  ((rc > 128)) && { touch "$mark" 2>/dev/null || true; }
  ((rc == 0)) && printf '%s\n' "$out" || echo '{}'
}

# amd-smi comes with ROCm; without it AMD cards are not listed.
amd() {
  # ROCm installs amd-smi in /opt/rocm/bin, which a session started before the
  # install does not have on PATH.
  local amdsmi
  amdsmi=$(command -v amd-smi || echo /opt/rocm/bin/amd-smi)
  [[ -x $amdsmi ]] || { echo '[]'; return; }
  # amd-smi is a `#!/usr/bin/env python3` script whose module is installed for the system Python; a mise or
  # pyenv python3 ahead of /usr/bin on PATH (mise ships with Omarchy) lacks it and every card disappears
  amdsmi=("$amdsmi")
  if [[ -x ${PYTHON3:-/usr/bin/python3} ]] && head -n1 "${amdsmi[0]}" 2>/dev/null | grep -q '^#!.*python3'; then
    amdsmi=("${PYTHON3:-/usr/bin/python3}" "$(readlink -f "${amdsmi[0]}")")
  fi
  jq -nc --argjson s "$(smi static "${amdsmi[@]}" static --json)" \
    --argjson m "$(smi metric "${amdsmi[@]}" metric --mem-usage --temperature --json)" '
    [($s.gpu_data // [])[] | . as $g | ([($m.gpu_data // [])[] | select(.gpu == $g.gpu)][0] // {}) as $u
     | select(($g.asic.market_name // "") != "")
     | {backend: "amd-rocm", index: ($g.gpu | tonumber), product: $g.asic.market_name, totalMiB: ($g.vram.size.value // 0),
        usedMiB: ($u.mem_usage.used_vram.value // null), tempC: ($u.temperature.edge.value // null),
        node: ("/dev/dri/by-path/pci-" + ($g.bus.bdf // "") + "-render")}]' 2>/dev/null || echo '[]'
}

# CPU recipes use host RAM and no device passthrough. Offer only the architecture/ISA in the catalog.
# Apple Silicon under Asahi Linux has no nvidia-smi/amd-smi node: one CPU entry named after the chip in
# the device tree ("M1", "M4 Pro", …) and sized by its unified RAM, so the catalog's memory test sorts an
# 8 GB M1 from a 16 GB one exactly as it sorts GPU cards by VRAM.
cpu() {
  if [[ $(uname -m) == x86_64 ]] && grep -qw avx2 "${CPUINFO:-/proc/cpuinfo}" &&
    jq -e 'any(.hardware[]; .match.backend == "cpu" and (.match.names | index("x8664avx2cpu") != null))' "$RECIPES" >/dev/null; then
    jq -nc --argjson ram "$(awk '/^MemTotal:/{print int($2 * 1024 / 1e9)}' "${MEMINFO:-/proc/meminfo}")" \
      '[{backend:"cpu",index:0,product:"x86-64 AVX2 CPU",totalMiB:0,usedMiB:null,tempC:null,ramGb:$ram}]'
  elif [[ $(uname -m) == aarch64 && -r ${APPLEMODEL:-/proc/device-tree/model} ]] &&
    chip=$(tr -d '\0' <"${APPLEMODEL:-/proc/device-tree/model}" | grep -oE '\bM[0-9]( (Pro|Max|Ultra))?\b' | head -1) &&
    name="apple${chip,,}" && name=${name// /} && [[ -n $name ]] &&
    jq -e --arg n "$name" 'any(.hardware[]; .match.backend == "cpu" and (.match.names | index($n) != null))' "$RECIPES" >/dev/null; then
    jq -nc --arg product "Apple $chip" \
      --argjson ram "$(awk '/^MemTotal:/{print int($2 / 1024)}' "${MEMINFO:-/proc/meminfo}")" \
      '[{backend:"cpu",index:0,product:$product,totalMiB:$ram,usedMiB:null,tempC:null,ramGb:($ram / 1024 | round)}]'
  else echo '[]'; fi
}

# gpus($nvidia; $intel; $amd): the three listings as one; match($recipes): each GPU with the card kind the recipes know
# it as ("" when none) and a key like nvidia:0. An NVIDIA GPU that shares the host's memory (GB10, RTX Spark) has no
# memory of its own to report: nvidia-smi prints [N/A], and the card is unified.
MATCH='def gpus($nv; $xe; $am): ($nv | split("\n") | map(select(length > 0) | split(", ") | {backend: "nvidia", index: (.[0] | tonumber),
      product: .[1], totalMiB: (.[2] | tonumber? // 0), usedMiB: (.[3] | tonumber? // null), tempC: (.[4] | tonumber? // null),
      uuid: (.[5] // ""), freeMiB: (.[6] | tonumber? // null), unified: ((.[2] | tonumber? // null) == null)}))
    + ($xe | split("\n") | map(select(length > 0) | split("\t")) | to_entries | map({backend: "intel-xpu", index: .key,
      product: (.value[3] // "Intel Arc Pro B70"), totalMiB: (.value[4] // "32768" | tonumber), usedMiB: null,
      tempC: (.value[0] | tonumber? // null), node: .value[1], display: ((.value[2] // "") == "1")}))
    + $am;
  def norm: ascii_downcase | gsub("nvidia|geforce|intel|amd|radeon|generation|workstation|edition|[0-9]+gb|[^a-z0-9]"; "");
  def match($r; $ram): [.[] | . as $x
    | ([$r.hardware | to_entries[] | select((.value.match.backend | sub("amd-vulkan"; "amd-rocm")) == $x.backend
        and (.value.match.names | index($x.product | norm)) != null
        # a unified-memory APU reports only its BIOS carve-out as VRAM, so the card is judged by host
        # RAM covering its stated memory once the carve-out is added back (amd-smi reports it as VRAM: a Strix
        # Halo set to 32 GiB has 94 GiB MemTotal), with a tenth of it, at least 8 GiB, more for firmware and kernel
        # reservations (a 128 GiB GB10 or RTX Spark has 119.5 GiB MemTotal)
        and (if (.value.match.unifiedMemory // false) or $x.unified
          then ($ram + (if $x.backend == "amd-rocm" then $x.totalMiB else 0 end)
            + ([8192, .value.match.vramGb * 1024 / 10] | max)) >= .value.match.vramGb * 1024
          else (((.value.match.vramGb * 1024) - $x.totalMiB) | fabs) <= 1024 end)) | .key][0] // "") as $hw
    | ($x.unified or ($hw != "" and ($r.hardware[$hw].match.unifiedMemory // false))) as $uni
    | $x + {key: ($x.backend + ":" + ($x.index | tostring)), hw: $hw,
        totalMiB: (if $uni then $ram else $x.totalMiB end), usedMiB: (if $uni then null else $x.usedMiB end),
        vramGb: (((if $uni then $ram else $x.totalMiB end) / 1024) | round),
        name: ($x.product | gsub("^(NVIDIA GeForce |NVIDIA |Intel |AMD Radeon |AMD )"; ""))}];'

# Every GPU, matched and reserved by any running container, regardless of account or labels.
# Unknown NVIDIA UUID/count requests reserve all NVIDIA cards; memory alone cannot detect idle allocations.
# `gpus none` skips the Docker check, for a snapshot taken while Docker cannot be asked.
gpus() {
  local ids claims='[]' p
  if [[ ${1:-} != none ]] && docker_reachable; then
    ids=$(docker ps -q) || die "could not check Docker GPU allocations; try again"
    if [[ -n $ids ]]; then
      # Read only container names and allocation fields, never container environments or credentials.
      # shellcheck disable=SC2086
      claims=$(docker inspect --format '{"name":{{json .Name}},"devices":{{json .HostConfig.Devices}},"requests":{{json .HostConfig.DeviceRequests}},"privileged":{{json .HostConfig.Privileged}}}' $ids | jq -s '.') ||
        die "could not check Docker GPU allocations; try again"
    fi
  fi
  jq -nc --arg nv "$(nvidia)" --arg xe "$(intel)" --argjson am "$(amd)" --argjson cpu "$(cpu)" --argjson ram "$(awk '/^MemTotal:/ {print int($2 / 1024)}' "${MEMINFO:-/proc/meminfo}")" --slurpfile rec "$RECIPES" --argjson claims "$claims" \
    --arg apps "$(nvidia_apps)" --arg links "$(for p in /dev/dri/by-path/*-render; do printf '%s\t%s\n' "$p" "$(readlink -f "$p")"; done)" "$MATCH"'
    ($links | split("\n") | map(select(length > 0) | split("\t") | {key: .[0], value: .[1]}) | from_entries) as $links
    | def node: $links[.] // .;
    (gpus($nv; $xe; $am) + $cpu | match($rec[0]; $ram)) | map(. as $g
      | (if .backend == "cpu" then "" elif .backend == "nvidia" then "/dev/nvidia" + (.index | tostring) else .node | node end) as $node
      # the containers that claim it, by name, so the panel can say what has it
      | . + {heldBy: (if .backend == "cpu" then [] else [$claims[] | select(
          .privileged == true
          or any(.devices[]?; (.PathOnHost | node) as $p | $node == $p or ($node | startswith($p + "/")))
          or ($g.backend == "nvidia" and any(.requests[]?;
            (.Driver == "nvidia" or any(.Capabilities[]?; index("gpu") != null))
            and ((.DeviceIDs // [] | length) == 0 or any(.DeviceIDs[];
              . == ($g.index | tostring) or (test("^[0-9]+$") | not))))))
          | .name // "" | ltrimstr("/")] end)}
      | .held = (.heldBy | length > 0)
      # the programs outside Docker that hold its memory, biggest first: on NVIDIA the compute apps on this card (by
      # UUID), so the framebuffer of a desktop is not mistaken for another program; amd-smi reports only the total
      # memory of the card, which stands in for them
      | . + (if .backend == "nvidia" and $g.uuid != "" then
          ([$apps | split("\n")[] | select(length > 0) | split(", ") | select(.[0] == $g.uuid)
            | {name: (.[2:-1] | join(", ") | split("/") | last), mib: (.[-1] | tonumber? // 0)}] | sort_by(-.mib)) as $o
          | {others: $o, othersMiB: ($o | map(.mib) | add // 0)}
        elif .backend == "cpu" or .backend == "intel-xpu" then {others: [], othersMiB: null}
        else {others: [], othersMiB: .usedMiB} end))'
}

# host: what a recipe that offloads weights to the machine needs of it besides the card (its `needs`): available RAM,
# the free space under the models folder, and whether that folder is on NVMe, through LUKS or LVM to the drive itself.
# Sizes are GB of 1e9 bytes, as the registry states them. Weights folders already downloaded and checked are listed,
# and every weights folder's bytes so far (a download resumes, and files linked in from another copy take no space).
host() {
  local d=$MODELS ram=0 free=0 src="" avail=0 disk="" prepared have=() got=()
  while [[ ! -d $d && $d == /*/* ]]; do d=${d%/*}; done
  read -r ram free < <(awk '/^MemTotal:/{t = $2} /^MemAvailable:/{a = $2} END{print t + 0, a + 0}' "${MEMINFO:-/proc/meminfo}" 2>/dev/null) || true
  read -r src avail < <(df -B1 --output=source,avail -- "$d" 2>/dev/null | tail -1) || true
  # every drive under the filesystem: nvme when each is a non-rotational NVMe drive, else what the first one is
  [[ $src == /dev/* ]] && disk=$(lsblk -snro TYPE,ROTA,TRAN -- "$src" 2>/dev/null | awk '$1 == "disk" {n++; if ($2 == "0" && $3 == "nvme") v++
    else if (k == "") k = ($2 == "0" ? "ssd" : "hdd")} END {print n && v == n ? "nvme" : k}')
  for d in "$MODELS"/*/.verified2 "$MODELS"/*/*/.verified2; do have+=("${d#"$MODELS"/}"); done
  for d in "$MODELS"/*/ "$MODELS"/*/*/; do got+=("${d#"$MODELS"/}" "$(du -sb -- "$d" 2>/dev/null | cut -f1)"); done
  prepared=$(jq -s 'map(select(type == "object"))' "$MODELS"/prepared/*/.complete.json 2>/dev/null) || prepared='[]'
  jq -nc --argjson r "${ram:-0}" --argjson f "${free:-0}" --argjson a "${avail:-0}" --arg d "$disk" --argjson prepared "$prepared" \
    --argjson cpus "$(nproc 2>/dev/null || echo 0)" --arg cpuName "$(awk -F': *' '/^model name/ {print $2; exit}' /proc/cpuinfo 2>/dev/null)" \
    'def gb: . * 10 | floor / 10; {ramGb: ($r * 1024 / 1e9 | gb), freeRamGb: ($f * 1024 / 1e9 | gb), diskFreeGb: ($a / 1e9 | gb), disk: $d, cpus: $cpus, cpuName: $cpuName,
      prepared: $prepared, have: [$ARGS.positional[] | select(endswith("/.verified2"))],
      got: ([$ARGS.positional[] | select(endswith("/.verified2") | not)] | [range(0; length; 2) as $i | {(.[$i] | rtrimstr("/")): (.[$i + 1] | tonumber? // 0)}] | add // {})}' \
    --args ${have[@]+"${have[@]}"} ${got[@]+"${got[@]}"}
}

# unfit($host): why this machine cannot run the recipe, "" when it can. A recipe's `needs` (the registry's contract):
# host_ram_gb of MemAvailable, disk_gb free under the models folder, and with fast_storage "nvme" that folder on a
# non-rotational NVMe drive, cpus the CPU threads its engine pins work to. A recipe without `needs` always fits; weights already downloaded and checked take no more
# disk, and a download under way needs only what is left of it.
PREP_CONTRACT='def prepared_contract: {image, weights, prepare, launch: (.launch | {entrypoint, environment, resources, shm})};'
NEEDS="$PREP_CONTRACT"'def unfit($h): (.needs // {}) as $n | prepared_contract as $contract | def gb: ceil | tostring;
  ([.weights[]? | if .layout == "hub" then "" else "\(.repository | gsub("/"; "--"))@\(.revision[:12])\(if (.dir // "") != "" then "/" + .dir else "" end)" end]) as $w
  | ([$w[] | $h.got[.] // 0] | add // 0 | . / 1e9) as $got
  | (.prepare.sizeGb // 0) as $pack
  | (if .prepare == null or (($h.prepared // []) | index($contract)) != null then 0 else $pack end) as $missingPack
  | ((if ($w | length) > 0 and all($w[]; . as $x | $h.have | index($x + "/.verified2") != null) then 0
      else [0, ($n.disk_gb // 0) - $got - $pack] | max end) + $missingPack) as $missingDisk
  | [if ($n.host_ram_gb // 0) > $h.freeRamGb then "needs \($n.host_ram_gb | gb) GB RAM, you have \($h.freeRamGb | floor)" else empty end,
     if $missingDisk > $h.diskFreeGb then "needs \($missingDisk | gb) GB free disk, you have \($h.diskFreeGb | floor)" else empty end,
     if ($n.fast_storage // "") == "nvme" and $h.disk != "nvme" then "needs the models folder on an NVMe drive" else empty end,
     if ($n.cpus // 0) > ($h.cpus // 0) then "needs \($n.cpus) CPU threads, you have \($h.cpus // 0)" else empty end]
  | join("; ");'

# wpaths <weights-item>: repository|revision|files|layout|mountPath|the folder the engine mounts|where the files are in it
wpaths() {
  jq -r --arg m "$MODELS" '(.repository | gsub("/"; "--")) as $r
    | (if .layout == "hub" then "\($m)/hf" else "\($m)/\($r)@\(.revision[:12])" end) as $mount
    | [.repository, .revision, .files // "", .layout, .mountPath, $mount, if .layout == "hub"
        then "\($mount)/hub/models--\($r)/snapshots/\(.revision)" else $mount + (if .dir then "/" + .dir else "" end) end]
    | join("|")' <<<"$1"
}

# tree <repository> <revision> <file>: path, size and hash of each file the recipe needs, as the Hub lists them: the
# SHA-256 of a large (LFS) file, and "git:" and the Git blob SHA-1 of any other. A listing kept by an earlier version
# (size only for small files, in a file without the .tsv) is not used.
tree() {
  local repo=$1 rev=$2 files=$3 f="$STATE/trees/${1//\//--}@$2.tsv"
  mkdir -p "$STATE/trees"
  if [[ ! -s $f ]]; then
    hf_curl -fsSL --max-time 60 --max-filesize 10485760 --retry 6 --retry-delay 10 --proto =https \
      "https://huggingface.co/api/models/$repo/tree/$rev?recursive=1" |
      jq -r '.[] | select(.type == "file") | [.path, .size, (.lfs.oid // "git:\(.oid)")] | @tsv' >"$f.tmp" || {
      rm -f "$f.tmp"
      return 1
    }
    mv -f "$f.tmp" "$f"
  fi
  if [[ -n $files ]]; then
    # files is a comma-separated list of basenames: an Engram checkpoint keeps two shards out of a large base model
    awk -F'\t' -v f="$files" 'BEGIN{n = split(f, a, ","); for (i = 1; i <= n; i++) want[a[i]] = 1}
      {b = $1; sub(/.*\//, "", b); if (b in want || $1 in want || b ~ /mmproj/) print}' "$f"
  else
    cat "$f"
  fi
}

size() { stat -c %s -- "$1" 2>/dev/null || echo 0; }

# good <file> <size> <sha256|git:sha1>: the file is complete and matches the hash the Hub lists for it: a large file's
# SHA-256, or a small one's Git blob SHA-1, which is of "blob <size>\0" and then the content
good() {
  [[ -f $1 && $(size "$1") == "$2" ]] || return 1
  if [[ $3 == git:* ]]; then
    [[ $({ printf 'blob %s\0' "$2"; cat -- "$1"; } | sha1sum | cut -c1-40) == "${3#git:}" ]]
  else
    [[ $(sha256sum -- "$1" | cut -c1-64) == "$3" ]]
  fi
}

# fetch <id> <weights-item>: adopt a matching copy from the Hugging Face cache, else download; check every file.
# .verified2 marks a folder checked against every file's hash; an earlier version's .verified checked small files by
# size only, so such a folder is checked again once (a file that matches stays, nothing is downloaded twice).
fetch() {
  local id=$1 repo rev files layout m d lock rows total done=0 path sz sha src pid have
  IFS='|' read -r repo rev files layout _ m d < <(wpaths "$2")
  [[ ! -f $d/.verified2 ]] || return 0
  # one download per weights folder: a second model on the same weights (the same model on another card) waits for
  # the first, then finds them checked; two curls appending to one .part corrupt it. The lock is the whole folder's,
  # <repo>@<rev>.lock beside it, whatever `dir` inside it a recipe uses: the one forget_folder checks (hub-layout
  # weights share one cache folder, and lock their own snapshot)
  lock=${d%/}.lock
  [[ $layout == hub ]] || lock=${m%/}.lock
  (umask 022 && mkdir -p "$(dirname "${d%/}")" "$(dirname "$lock")")
  exec 7>"$lock"
  until flock -n 7; do
    status "$id" download "waiting for the other download of these weights" 0
    [[ ! -f $(dir_of "$id")/cancel ]] || exit 0
    sleep 2
  done
  [[ ! -f $d/.verified2 ]] || { exec 7>&-; return 0; }
  rows=$(tree "$repo" "$rev" "$files") || die "Hugging Face did not list $repo (rate limit or no network): try again in a minute"
  [[ -n $rows ]] || die "Hugging Face listed no model files; refresh models and try again"
  total=$(awk -F'\t' '{s += $2} END {print s + 0}' <<<"$rows")
  (umask 022 && mkdir -p "$d")
  while IFS=$'\t' read -r path sz sha; do
    [[ -n $path ]] || continue
    [[ $path != *..* && $path != /* ]] || die "the Hub listed an unsafe path"
    if ! good "$d/$path" "$sz" "$sha"; then
      src="$HOME_DIR/.cache/huggingface/hub/models--${repo//\//--}/snapshots/$rev/$path"
      (umask 022 && mkdir -p "$(dirname "$d/$path")")
      if good "$src" "$sz" "$sha"; then
        ln -f "$(readlink -f "$src")" "$d/$path" 2>/dev/null || cp -f "$(readlink -f "$src")" "$d/$path"
      else
        # curl retries a 5xx, a 429 or a timeout with a doubling delay (1 s to 2 min, about 4 minutes in all): a short
        # Hugging Face outage on one small file must not end a start whose large files are already here
        hf_curl -fsSL --connect-timeout 15 --max-time 7200 --speed-limit 1024 --speed-time 60 --retry 8 -C - --proto =https --max-filesize "$sz" -o "$d/$path.part" \
          "https://huggingface.co/$repo/resolve/$rev/$path" &
        pid=$!
        while kill -0 "$pid" 2>/dev/null; do
          have=$(size "$d/$path.part")
          status "$id" download "$(((done + have) >> 30)) of $(((total + (1 << 30) - 1) >> 30)) GB" $(((done + have) * 100 / (total + 1)))
          if [[ -f $(dir_of "$id")/cancel ]]; then
            kill "$pid"
            exit 0
          fi
          sleep 2
        done
        wait "$pid" || die "download of $path failed; run again to resume"
        if ! good "$d/$path.part" "$sz" "$sha"; then
          rm -f "$d/$path.part"
          die "$path does not match the pinned revision"
        fi
        mv -f "$d/$path.part" "$d/$path"
      fi
    fi
    done=$((done + sz))
  done <<<"$rows"
  if [[ $layout == "hub" ]]; then
    (umask 022 && mkdir -p "$d/../../refs" && echo -n "$rev" >"$d/../../refs/main")
  fi
  (umask 022 && : >"$d/.verified2")
  exec 7>&-
}

# owned <path>: an existing path of the caller's, with no symlink on the way, is safe to hand the daemon
owned() {
  [[ $(realpath -e -- "$1" 2>/dev/null) == "$1" && $(stat -c %u -- "$1") == "$(id -u)" ]] ||
    die "the model files must be owned by you and cannot be symbolic links"
}

# Existing deployments retain their old names until stopped; new ones are scoped to their owner.
network() {
  local uid
  uid=$(jq -r '.containerUid // empty' "$(dir_of "$1")/config.json" 2>/dev/null) || uid=""
  [[ -z $uid || $uid =~ ^[0-9]+$ ]] || die "invalid container owner"
  printf 'omarchy-local-ai-%s%s' "${uid:+$uid-}" "$1"
}
engine() { printf '%s-engine' "$(network "$1")"; }
# private <id>: the network only the engine and its gateway share. Internal (no route out) and isolated (no address on
# the host), so nothing on the machine reaches the engine but the gateway, whatever the engine binds or authenticates:
# Docker otherwise routes every bridge address from the host, published or not, and any local account could talk to
# an engine that has no key of its own (TabbyAPI with disable_auth, llama-server without --api-key).
private() { printf '%s-private' "$(network "$1")"; }
# docker_private: Docker 28 is the first to isolate a network from the host; an older one keeps the option it does not
# know and gives the bridge a host address anyway, so private_net checks the network after making it as well
docker_private() {
  local v
  v=$(docker version --format '{{.Server.Version}}' 2>/dev/null) || v=""
  [[ ${v%%.*} =~ ^[0-9]+$ ]] && ((${v%%.*} >= 28)) && return 0
  echo "Docker 28 or newer is needed to keep the engine private (this is ${v:-unknown})"
  return 1
}
# private_net <id>: make the model's private network, or keep the one an earlier attempt made. The isolation above is
# IPv4's, so the network has no IPv6 at all (a daemon that turns IPv6 on by default would give the host a route to it):
# it must come out internal, IPv4-isolated and without IPv6.
private_net() {
  docker network create --internal --ipv6=false -o com.docker.network.bridge.gateway_mode_ipv4=isolated \
    --label "$LABEL=1" --label "$LABEL.uid=$(id -u)" "$(private "$1")" >/dev/null 2>&1 || true
  [[ $(docker network inspect -f '{{.Internal}} {{.EnableIPv6}} {{index .Options "com.docker.network.bridge.gateway_mode_ipv4"}}' "$(private "$1")" 2>/dev/null) == "true false isolated" ]]
}
# ipv6_open <id>: the model's private network has IPv6 on. private_net never makes one, but an engine 6.17 or 6.18
# started on a daemon with IPv6 on by default keeps that network, and so an IPv6 route around the gateway, until the
# model is started again; the panel says so and nothing shares it meanwhile
ipv6_open() { [[ $(docker network inspect -f '{{.EnableIPv6}}' "$(private "$1")" 2>/dev/null) == true ]]; }
IPV6_OPEN="its engine network has IPv6 on, which reaches the engine without the key: run it again to rebuild that network"
gateway() { printf '%s-gateway' "$(network "$1")"; }
# gw_addr <id>: the gateway's URL on the model's own Docker network. Only Docker assigns addresses on that bridge and
# no host interface holds them, so another account can never listen there: every keyed request this plugin makes,
# and every agent and tailnet share it sets up, goes to this address and never to 127.0.0.1:<port>, which another
# account could take over the moment the gateway exits.
gw_addr() {
  local ip
  ip=$(docker inspect -f "{{with index .NetworkSettings.Networks \"$(network "$1")\"}}{{.IPAddress}}{{end}}" "$(gateway "$1")" 2>/dev/null) || return 1
  [[ $ip =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
  printf 'http://%s:12434' "$ip"
}
preparer() { printf '%s-prepare' "$(network "$1")"; }
# kv <id>: the tokens the engine's cache holds, from its start log (SGLang's max_total_num_tokens, vLLM's GPU KV cache
# size), or nothing when it does not say. SGLang starts with a cache smaller than its context when the card is short.
kv() {
  docker logs "$(engine "$1")" 2>&1 | grep -m1 -oE 'max_total_num_tokens=[0-9]+|GPU KV cache size: [0-9,]+ tokens' | tr -dc 0-9 || true
}
prepared_contract() { jq -cS "$PREP_CONTRACT prepared_contract" <<<"$1"; }
prepared_path() { printf '%s/prepared/%s' "$MODELS" "$(prepared_contract "$1" | sha256sum | cut -c1-64)"; }
managed_paths() {
  local w d
  while IFS= read -r w; do IFS='|' read -r _ _ _ _ _ _ d < <(wpaths "$w"); printf '%s\n' "$d"; done < <(jq -c '.weights[]?' <<<"$1")
  [[ $(jq -r '.prepare // empty' <<<"$1") == "" ]] || { prepared_path "$1"; echo; }
}

# Typed resources and environment used by preparation, verification and serving.
launch_options() {
  jq -j 'def o($f; $v): if $v != null and $v != "" then "\($f)\u0000\($v)\u0000" else "" end;
    o("--shm-size"; .launch.shm), o("--entrypoint"; .launch.entrypoint),
    o("--memory"; .launch.resources.memoryBytes), o("--memory-swap"; .launch.resources.memorySwapBytes),
    (if .launch.resources.memlockUnlimited then o("--ulimit"; "memlock=-1:-1") else "" end),
    (if .launch.resources.ipcLock then o("--cap-add"; "IPC_LOCK") else "" end),
    (.launch.environment | to_entries[]? | select(.key != "NVIDIA_VISIBLE_DEVICES") | o("--env"; "\(.key)=\(.value)")),
    o("--env"; if any(.weights[]?; .layout == "hub") then "HF_HUB_OFFLINE=1" else null end)' <<<"$1"
}

# Build only in private staging; publish after same-image verification. Stop keeps completed stores.
prepare_model() (
  local id=$1 r=$2 pack stage="" at v w rc opts=() raw=() gpu=()
  shift 2
  [[ $(jq -r '.prepare // empty' <<<"$r") ]] || return 0
  pack=$(prepared_path "$r")
  at=$(jq -r .prepare.at <<<"$r")
  mkdir -p "${pack%/*}"
  owned "${pack%/*}"
  exec 6>"$pack.lock"
  flock -w 7200 6 || die "another preparation is still using this model"
  trap 'rc=$?; if ours "$(preparer "$id")"; then docker rm -f "$(preparer "$id")" >/dev/null 2>&1 || true; fi;
    [[ -z $stage ]] || rm -rf -- "$stage"; exit "$rc"' EXIT
  trap 'exit 143' TERM; trap 'exit 130' INT
  while IFS= read -r -d '' v; do opts+=("$v"); done < <(launch_options "$r")
  while IFS='|' read -r _ _ _ _ v w _; do owned "$w"; raw+=(--volume "$w:$v:ro"); done \
    < <(jq -c '.weights[]?' <<<"$r" | while IFS= read -r w; do wpaths "$w"; done)
  prep_run() {
    local output=$1 mode=$2 args=() visibility=() x result logger
    while IFS= read -r -d '' x; do args+=("$x"); done < <(jq -j --arg mode "$mode" '.prepare[$mode][] | . + "\u0000"' <<<"$r")
    if [[ $mode == args && ${#gpu[@]} -gt 0 ]]; then
      allocation_lock
      cards_free ${prepare_keys[@]+"${prepare_keys[@]}"}
    fi
    ((${#gpu[@]} > 0)) || visibility=(--env NVIDIA_VISIBLE_DEVICES=void)
    timeout --foreground --kill-after=5 120 docker run -d --name "$(preparer "$id")" --network none \
      --security-opt no-new-privileges --label "$LABEL=1" --label "$LABEL.uid=$(id -u)" \
      --user "$(id -u):$(id -g)" --env HOME=/tmp --env HF_HUB_OFFLINE=1 \
      "${opts[@]}" ${gpu[@]+"${gpu[@]}"} ${visibility[@]+"${visibility[@]}"} --volume "$output:$at:$([[ $mode == args ]] && echo rw || echo ro)" \
      "${raw[@]}" "$(jq -r .image <<<"$r")" "${args[@]}" >/dev/null || return 1
    ((${#gpu[@]} == 0)) || settle "$(preparer "$id")" ${prepare_keys[@]+"${prepare_keys[@]}"}
    # A running container now reserves its cards. Unrelated cards can start during the long conversion.
    flock -u 8 2>/dev/null || true
    docker logs --follow "$(preparer "$id")" >&2 & logger=$!
    result=$(timeout --foreground --kill-after=5 7200 docker wait "$(preparer "$id")") || result=timeout
    kill "$logger" 2>/dev/null || true; wait "$logger" 2>/dev/null || true
    docker rm "$(preparer "$id")" >/dev/null 2>&1 || true
    [[ $result == 0 ]]
  }
  [[ ! -e $(dir_of "$id")/cancel ]] || die "preparation cancelled"
  if [[ -e $pack || -L $pack ]]; then
    owned "$pack"
    [[ -f $pack/.complete.json && $(cat "$pack/.complete.json") == "$(prepared_contract "$r")" ]] || die "prepared model is incomplete; remove its managed download and retry"
    echo "checking the prepared model"
    prep_run "$pack" verifyArgs || die "prepared model failed verification; remove its managed download and retry"
    [[ ! -e $(dir_of "$id")/cancel ]] || die "preparation cancelled"
    return
  fi
  [[ ! -e $(dir_of "$id")/cancel ]] || die "preparation cancelled"
  stage=$(mktemp -d "${pack%/*}/.staging.XXXXXX")
  [[ $(jq -r .prepare.gpu <<<"$r") == false ]] || gpu=("$@")
  echo "preparing the model (first start only)"
  prep_run "$stage" args || die "model preparation failed"
  gpu=()
  prep_run "$stage" verifyArgs || die "prepared model failed verification"
  prepared_contract "$r" >"$stage/.complete.json"
  [[ ! -e $(dir_of "$id")/cancel ]] || die "preparation cancelled"
  mv -T -- "$stage" "$pack"
  stage=""
)
# ours <container>: labelled with this user's uid, or a 5.x container (they carry no uid), which the upgrade takes over
ours() {
  local l
  l=$(docker inspect -f "{{index .Config.Labels \"$LABEL\"}}|{{index .Config.Labels \"$LABEL.uid\"}}" "$1" 2>/dev/null) || return 1
  [[ $l == "1|$(id -u)" || $l == "1|" ]]
}

# loadstep <id>: where the engine is in its start, by its own log: "<step>\t<percent>\t<its last line>". The step and
# percent move only on lines vLLM, SGLang and llama.cpp print themselves; an engine that has printed none of them yet
# is "loading" at 1%. The last line changes whenever the engine prints anything, so its silence can be timed. vLLM reads
# the checkpoint again for a draft model (MTP), after "Loading drafter model".
loadstep() {
  docker logs --tail 400 "$(engine "$1")" 2>&1 | tr '\r' '\n' | awk '
    function set(s, p) { step = s; pct = p }
    NF { last = $0 }
    /[Ll]oading safetensors checkpoint shards: +[0-9]+% Completed \| [0-9]+\/[0-9]+/ {
      match($0, /\| [0-9]+\/[0-9]+/); split(substr($0, RSTART + 2, RLENGTH - 2), f, "/")
      if (f[2] > 0) set((f[1] < f[2] ? "reading the " (draft ? "draft model " : "") "weights: file " f[1] + 1 " of " f[2] : "weights read"),
        5 + int(60 * f[1] / f[2])); next }
    /Loading drafter model/ { draft = 1; set("reading the draft model weights", 5); next }
    /Starting to load model|Load weight begin|load_tensors: loading model tensors|Loading model modules/ { set("reading the weights", 5); next }
    /Loading weights took|Model loading took|Load weight end|load_tensors: +[A-Za-z0-9_]+ model buffer size/ { set("weights loaded", 65); next }
    /Dynamo bytecode transform|Compiling a graph|torch\.compile takes/ { set("compiling", 70); next }
    /Available KV cache memory|GPU KV cache size|Memory pool end|llama_kv_cache/ { set("reserving the cache", 80); next }
    /Capturing (CUDA |cuda |XPU )?graphs|Capture cuda graph begin|Graph capturing/ { set("capturing graphs", 85); next }
    /init engine \(profile|Starting vLLM (API )?server|Application startup complete|Uvicorn running|fired up and ready|server is listening|main: model loaded/ {
      set("starting the server", 95); next }
    END { gsub(/\t/, " ", last); printf "%s\t%d\t%s\n", (step == "" ? "loading" : step), (step == "" ? 1 : pct), last }'
}

# resets <node>...: the kernel keeps a crash record (devcoredump) of a card its driver has just reset; one that was not
# there when the start began means the card was reset under the engine, which then waits on it forever
resets() {
  local n
  for n in "$@"; do
    readlink "$SYS/class/drm/${n##*/}/device/devcoredump" 2>/dev/null || true
  done
}

# rundir <id>: what the start writes for the engine (the config asset, its GPUs' by-path links). The engine restarts
# with the machine, so this is in the user's state, never /run or XDG_RUNTIME_DIR: a mount source gone after a reboot
# or a logout comes back as an empty directory and the engine crash-loops
rundir() { echo "$STATE/run/$1"; }

remove() {
  local c
  for c in "$(preparer "$1")" "$(engine "$1")" "$(gateway "$1")"; do
    if ours "$c"; then
      if ! docker rm -f "$c" >/dev/null 2>&1; then
        sleep 3
        docker rm -f "$c" >/dev/null 2>&1 || return 1
      fi
    fi
  done
  docker network rm "$(network "$1")" >/dev/null 2>&1 || true
  docker network rm "$(private "$1")" >/dev/null 2>&1 || true
  rm -rf -- "$(rundir "$1")" 2>/dev/null || say "$1: $(rundir "$1") holds files Docker created as root; delete it as root"
}

# pull <image> <what>: a line each time a layer lands, from the per-layer lines docker prints when it has no terminal;
# each layer counts once, as the containerd store can announce a layer and then find it already there
pull() {
  docker pull "$1" | awk -v what="$2" '/: (Pulling fs layer|Already exists)$/ && !($1 in all) { all[$1]; n++ }
    /: (Pull complete|Already exists)$/ && !($1 in done) { done[$1]; printf "downloading the %s: %d of %d layers\n", what, ++d, n; fflush() }'
}

# allocation_lock: one start at a time for this account, on a lock file in its own runtime directory (else its state
# folder). No other account can open it, so none can hold it and stall every start, as one could a lock on a shared
# path such as /run. Another account's start does not take this lock: a card both take at the same moment is settled
# by Docker (settle).
allocation_lock() {
  local d=${XDG_RUNTIME_DIR:-}
  [[ -n $d && -d $d && -O $d ]] || d=$STATE
  exec 8>>"$d/omarchy-local-ai.allocation.lock"
  flock -w 30 8 || die "another model is starting; try again"
}

# settle <container> <card>...: the container just started on these cards keeps them only if no container created
# before it, running, paused or still starting, claims one of them: the same render node or /dev/nvidia<n>, the same NVIDIA
# card by index or UUID (as --gpus or as a CDI name), every NVIDIA card, or an NVIDIA id it cannot place (a MIG
# device, say), which counts as every card, as gpus() counts it. Otherwise this one is removed and the start ends.
# Two accounts that take a card at the same moment both read that order from Docker, so exactly one start goes on.
settle() {
  local c=$1 k u ids mine v cards=() f='{"devices":{{json .HostConfig.Devices}},"requests":{{json .HostConfig.DeviceRequests}},"privileged":{{json .HostConfig.Privileged}}}'
  shift
  for k in "$@"; do
    [[ $k == nvidia:* ]] || continue
    cards+=("${k#*:}" "nvidia.com/gpu=${k#*:}" "/dev/nvidia${k#*:}")
    u=$(nvidia-smi --query-gpu=uuid --format=csv,noheader -i "${k#*:}" 2>/dev/null) && [[ $u == GPU-* ]] && cards+=("$u" "nvidia.com/gpu=$u")
  done
  ids=$(docker ps -q --filter status=running --filter status=created --filter status=restarting \
    --filter status=paused --filter "before=$c") ||
    die "could not check Docker GPU allocations; try again"
  [[ -n $ids ]] || return 0
  mine=$(docker inspect --format "$f" "$c") || die "could not check Docker GPU allocations; try again"
  # shellcheck disable=SC2086
  v=$(docker inspect --format "$f" $ids | jq -rs --argjson m "$mine" --args '
    [$m.devices[]?.PathOnHost | select(startswith("/dev/dri/"))] as $paths | $ARGS.positional as $cards
    | ($cards | length > 0) as $nv
    | def placed: test("^([0-9]+|GPU-[0-9A-Fa-f-]+)$");
      def nvidia_id: if startswith("nvidia.com/") then (ltrimstr("nvidia.com/gpu=") | placed) else placed end;
    ($paths | length > 0 or $nv) and any(.[]; .privileged == true
      or any(.devices[]?; .PathOnHost as $p | any($paths[]; . == $p or startswith($p + "/")) or ($cards | index($p) != null))
      or ($nv and any(.requests[]?;
        if .Driver == "cdi" then any(.DeviceIDs[]?; startswith("nvidia.com/") and (. as $i | ($cards | index($i) != null) or (nvidia_id | not)))
        elif .Driver == "nvidia" or any(.Capabilities[]?[]?; . == "gpu") then
          (.DeviceIDs // [] | length) == 0 or any(.DeviceIDs[]; . as $i | ($cards | index($i) != null) or (nvidia_id | not))
        else false end)))' "${cards[@]}") ||
    die "could not check Docker GPU allocations; try again"
  [[ $v == true ]] || return 0
  docker rm -f "$c" >/dev/null 2>&1 || true
  die "$* is in use by another program"
}

# card_taken <gpus> <key>: what has the card, or nothing when it is free: a container that claims it, or programs that
# hold more than 2 GB of it ("ollama (5.2 GB)"); the framebuffer of a desktop and its compositor do not count
card_taken() {
  jq -r --arg k "$2" 'first(.[] | select(.key == $k)) // {} | if .held then "another program"
    elif (.othersMiB // 0) > 2048 then
      ([.others // [] | map(select(.name != "")) | group_by(.name)[] | {name: .[0].name, mib: (map(.mib) | add)}]
        | sort_by(-.mib) | map(.name) | .[:2] | join(", ")) as $n
        | (if $n == "" then "another program" else $n end) + " (" + ((.othersMiB / 1024 * 10 | round) / 10 | tostring) + " GB)"
    else empty end' <<<"$1"
}

# card_room <gpus> <key> <recipe>: why the card has no room for the weights of the recipe, or nothing when they fit in
# its free memory (unknown free memory never refuses)
card_room() {
  jq -r --arg k "$2" --argjson r "$3" 'first(.[] | select(.key == $k)) // {}
    | ((($r.sizeGb // 0) * 1024 / ($r.cards // 1)) | floor) as $need
    | select(.freeMiB != null and .freeMiB < $need)
    | "\($r.name // "this model") needs \(($need / 1024 * 10 | round) / 10) GB on \($k); \((.freeMiB / 1024 * 10 | round) / 10) GB is free"' <<<"$1"
}

cards_free() {
  local g k w
  g=$(gpus)
  for k in "$@"; do
    w=$(card_taken "$g" "$k")
    [[ -z $w ]] || die "$k is in use by $w"
  done
  return 0
}

# phase_start <id> <port> <key>: re-read the recipe here, check every path, build both containers
phase_start() (
  valid_id "$1" && [[ $2 =~ ^[0-9]+$ && $2 -ge 12434 && $2 -lt 12450 ]] || die "invalid request"
  local id=$1 port=$2 r g backend run a=() devices=() k v w
  shift 2
  r=$(jq -ce '.recipe // empty' "$(dir_of "$id")/config.json" 2>/dev/null || recipe "$id") || die "no recipe $id"
  v=$(policy "$r")
  [[ $v == "ok" ]] || die "recipe refused: $v"
  (($# == $(jq -r '.cards // 1' <<<"$r"))) || die "this recipe runs on $(jq -r '.cards // 1' <<<"$r") card(s)"
  g=$(gpus)
  for k in "$@"; do
    valid_key "$k" && [[ ${k%%:*} == "${1%%:*}" ]] || die "invalid card $k"
    jq -e --arg k "$k" --arg h "$(jq -r .hw <<<"$r")" 'any(.[]; .key == $k and .hw == $h)' <<<"$g" >/dev/null ||
      die "$k is not a card this recipe runs on"
  done
  backend=$(jq -r --arg h "$(jq -r .hw <<<"$r")" '.hardware[$h].match.backend' "$RECIPES")
  if [[ $backend == "nvidia" ]] && ! nvidia_ready; then
    die "NVIDIA container support is not ready: choose Set up Local AI"
  fi
  if [[ $backend == "nvidia" ]] && v=$(cdi_stale) && [[ -n $v ]]; then
    say "stale NVIDIA device list ${v%%$'\t'*} (${v#*$'\t'}); regenerate it as root: nvidia-ctk cdi generate --output=${v%%$'\t'*}"
    die "the NVIDIA device list is out of date (${v#*$'\t'}): choose Set up Local AI to regenerate it"
  fi
  v=$(docker_private) || die "$v"
  owned "$KEY"
  owned "$STATE/usage/$id"
  # each line on stdout is the widget's next step: the worker reads them, so a long download never shows a still line
  for v in "engine|$(jq -r .image <<<"$r")" "gateway|$(jq -r .gateway.image "$RECIPES")"; do
    docker image inspect "${v#*|}" >/dev/null 2>&1 && continue
    echo "downloading the ${v%%|*} (first start only)"
    pull "${v#*|}" "${v%%|*}" || die "could not pull ${v#*|}"
  done
  echo "starting the engine"

  allocation_lock
  remove "$id"
  trap 'v=$?; if ((v != 0)); then remove "$id" || true; fi; exit "$v"' EXIT
  # Downloads can take hours. Recheck with the launcher's Docker access immediately before allocation.
  cards_free "$@"
  run=$(rundir "$id")
  mkdir -p "$run/by-path"
  a=(docker run -d --name "$(engine "$id")" --restart unless-stopped --security-opt no-new-privileges
    --network "$(private "$id")" --network-alias engine --label "$LABEL=1" --label "$LABEL.uid=$(id -u)")
  if [[ $backend == "nvidia" ]]; then
    # Through CDI (the toolkit's /etc/cdi/nvidia.yaml, which Docker reads without a restart) each card goes by its UUID:
    # CDI's own numbering need not match nvidia-smi's. An install with the nvidia runtime and no CDI list uses --gpus.
    if docker info --format '{{json .DiscoveredDevices}}' 2>/dev/null | nvidia_devices; then
      for k in "$@"; do
        v=$(nvidia-smi --query-gpu=uuid --format=csv,noheader -i "${k#*:}" 2>/dev/null) && [[ $v == GPU-* ]] ||
          die "could not read the UUID of NVIDIA GPU ${k#*:}"
        devices+=(--device "nvidia.com/gpu=$v")
      done
    else
      v=$(printf '%s,' "${@#*:}")
      devices+=(--gpus "\"device=${v%,}\"")
    fi
  elif [[ $backend != cpu ]]; then
    # by GID, not name: the engine image need not share the host's group names.
    [[ $backend == "amd-rocm" ]] && devices+=(--device /dev/kfd \
      --group-add "$(getent group video | cut -d: -f3)" \
      --group-add "$(getent group render | cut -d: -f3)")
    # oneCCL opens every by-path link it finds, so the engine sees only its own cards'
    for k in "$@"; do
      v=$(readlink -f "$(jq -r --arg k "$k" '.[] | select(.key == $k) | .node' <<<"$g")")
      [[ $v =~ ^/dev/dri/renderD[0-9]+$ ]] || die "no render node for $k"
      for w in /dev/dri/by-path/*-render; do
        [[ $(readlink -f "$w") == "$v" ]] && ln -s "../${v##*/}" "$run/by-path/${w##*/}"
      done
      devices+=(--device "$v")
    done
    devices+=(--volume "$run/by-path:/dev/dri/by-path:ro")
    # Intel's runtime lets the copy engine read ordinary host memory in place while the weights load. On a B70 with
    # less RAM than the checkpoint that range is unmapped mid-transfer (xe: "Fault response: Unsuccessful -ENOENT",
    # copy engine reset) and vLLM waits on the lost copy. Staging through the runtime's own buffers is not enough:
    # the engine still registers the mapped file as shared-system memory, so shared-system USM is off as well.
    if [[ $backend == "intel-xpu" ]]; then
      devices+=(--env NEOReadDebugKeys=1 --env TreatNonUsmForTransfersAsSharedSystem=0 --env EnableSharedSystemUsmSupport=0)
    fi
  fi
  local prepare_keys=("$@")
  flock -u 8
  prepare_model "$id" "$r" ${devices[@]+"${devices[@]}"}
  # Preparation may take minutes. Reacquire allocation before the final check and engine start.
  allocation_lock
  cards_free "$@"
  docker network create --label "$LABEL=1" --label "$LABEL.uid=$(id -u)" "$(network "$id")" >/dev/null
  private_net "$id" || die "Docker did not make the engine's network private"
  a+=(${devices[@]+"${devices[@]}"})
  if [[ $(jq -r '.prepare // empty' <<<"$r") ]]; then
    a+=(--volume "$(prepared_path "$r"):$(jq -r .prepare.at <<<"$r"):ro")
  fi
  while IFS='|' read -r _ _ _ _ v w _; do
    owned "$w"
    a+=(--volume "$w:$v:ro")
  done < <(jq -c '.weights[]?' <<<"$r" | while IFS= read -r w; do wpaths "$w"; done)
  v=$(jq -r '.asset.name // empty' <<<"$r")
  [[ -z $v ]] || (umask 022 && jq -r .asset.text <<<"$r" >"$run/$v")
  # the rest of the options, the image and its arguments; the cards are chosen above, never by the recipe
  while IFS= read -r -d '' v; do
    a+=("$v")
  done < <(launch_options "$r"; jq -j --arg run "$run" 'def o($f; $v): if ($v // "") != "" then "\($f)\u0000\($v)\u0000" else "" end;
    o("--volume"; .asset | if . then "\($run)/\(.name):\(.mountPath):ro" else null end),
    "\(.image)\u0000", (.launch.arguments[]? | "\(.)\u0000")' <<<"$r")
  [[ ! -e $(dir_of "$id")/cancel ]] || die "start cancelled"
  if ! "${a[@]}" >/dev/null; then
    remove "$id"
    die "the engine did not start"
  fi
  [[ $backend == cpu ]] || settle "$(engine "$id")" "$@"

  [[ ! -e $(dir_of "$id")/cancel ]] || die "start cancelled"
  # The key goes only to the gateway's bridge address (gw_addr). The port published on 127.0.0.1 carries no key: the
  # panel's keyless /health poll uses it, the check below that it refuses a request without the key, and it is the
  # port number a tailnet share and `ss` reserve.
  if ! docker run -d --name "$(gateway "$id")" --restart unless-stopped --security-opt no-new-privileges \
    --cap-drop ALL --read-only --tmpfs /tmp:rw,nosuid,nodev,size=64m --dns 127.0.0.1 \
    --network "$(network "$id")" --network "$(private "$id")" --user "$(id -u):$(id -g)" --publish "127.0.0.1:$port:12434" \
    --label "$LABEL=1" --label "$LABEL.uid=$(id -u)" \
    --env "UPSTREAM=http://engine:$(jq -r .launch.port <<<"$r")" --env "MODEL=$(jq -r '.servedName // ""' <<<"$r")" \
    --env GATEWAY_KEY_FILE=/run/gateway.key --volume "$KEY:/run/gateway.key:ro" \
    --env GATEWAY_USAGE_LOG=/var/lib/local-ai/usage.jsonl --volume "$STATE/usage/$id:/var/lib/local-ai" \
    "$(jq -r .gateway.image "$RECIPES")" >/dev/null; then
    remove "$id"
    die "the gateway did not start"
  fi
  touch "$(dir_of "$id")/private" 2>/dev/null || true
)

# phase_stop <id>: returns non-zero instead of exiting, so the caller records why the stop failed
phase_stop() {
  valid_id "$1" || return 1
  docker info >/dev/null 2>&1 || { say "Docker is not responding; $1 was not stopped"; return 1; }
  remove "$1"
}

# serve <port> on|off [target URL]: the tailnet's https://<host>:<port> forwards to target (the gateway's bridge address)
serve() {
  if [[ $2 == "on" ]]; then
    timeout 20 tailscale serve --bg --https="$1" "$3" >/dev/null 2>&1
  else
    timeout 20 tailscale serve --https="$1" off >/dev/null 2>&1
  fi
}

# This user's containers, networks and engine mounts, and the engine images they ran or any catalog names (Docker
# keeps an image another container uses)
phase_purge() {
  local c containers images=""
  containers=$(docker ps -aq --filter "label=$LABEL=1") || die "Docker is not responding; nothing was removed"
  for c in $containers; do
    if ours "$c"; then
      images+=$(docker inspect -f '{{.Image}}' "$c" 2>/dev/null || true)$'\n'
      docker rm -f "$c" >/dev/null || die "could not remove a model container; try again"
    fi
  done
  docker network ls -q --filter "label=$LABEL=1" --filter "label=$LABEL.uid=$(id -u)" | xargs -r timeout --kill-after=5 30 docker network rm >/dev/null 2>&1 || true
  { printf '%s' "$images"; jq -r '.gateway.image, .hardware[].recipes[].image' "$PANEL/recipes.json" "$CATALOG" 2>/dev/null; } |
    grep . | sort -u | xargs -r timeout --kill-after=5 30 docker rmi >/dev/null 2>&1 || true
}

# fail <message>: keep the engine's last 400 lines in the log (taking the containers down deletes them; a vLLM engine
# core's cause sits above two tracebacks, past the last 60), name its exception in the message, take the containers
# down and stop
fail() {
  local e hint="" out
  e=$(engine "$WID")
  if docker inspect "$e" >/dev/null 2>&1; then
    out=$(docker logs --tail 400 "$e" 2>&1 || true)
    printf '%s\n' "$out" >>"$WD/err"
    # the exception itself ("ValueError: Free memory on device ..."), not the first traceback line that says "error"
    hint=$(grep -oE '[A-Za-z]+(Error|Exception): .*' <<<"$out" | grep -v 'Engine core initialization failed' | head -1 | cut -c1-200 || true)
    [[ -n $hint ]] || hint=$(grep -i -m1 -e error -e 'out of' -e exception <<<"$out" | cut -c1-160 || true)
  fi
  phase_stop "$WID" || true
  die "$*${hint:+: $hint}"
}

# __worker <id> <key>: download, start, wait for the model, check it answers; status.json tells the widget each step
worker_run() {
  local r t0 w reply served="" code nodes seen quiet last top step pct line k
  WID=$1
  shift
  r=$(jq -ce '.recipe // empty' "$(dir_of "$WID")/config.json" 2>/dev/null || recipe "$WID")
  WD=$(dir_of "$WID")
  WNAME=$(jq -r .name <<<"$r")
  NID=0
  trap 'rc=$?; if ((rc)) && [[ ! -f $WD/cancel ]]; then WHY=$(grep "^local-ai: " "$WD/err" | tail -1 | cut -c11- || true);
    WHY=${WHY:-"the model could not start; see the log and try again"};
    status "$WID" error "" 0 "$WHY"; count failed; notify -r "$NID" -u critical "$WNAME did not start" "$WHY" >/dev/null; fi' EXIT
  exec 2>>"$WD/err"

  rm -f "$STATE/hf.header" # a token file an older version kept
  status "$WID" download "checking the files" 0
  while IFS= read -r w; do
    fetch "$WID" "$w"
  done < <(jq -c '.weights[]?' <<<"$r")

  # The key is written whole to a temporary file and linked into place, never truncated: two first starts at once
  # both make one, the first link wins and the second start uses it. A running gateway never sees it empty.
  if [[ ! -s $KEY ]]; then
    w=$(mktemp "$KEY.XXXXXX")
    head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' >"$w"
    ln "$w" "$KEY" 2>/dev/null || [[ -s $KEY ]] || mv -f "$w" "$KEY"
    rm -f "$w"
  fi
  w=$(mktemp "$AUTH.XXXXXX")
  printf 'Authorization: Bearer %s\n' "$(<"$KEY")" >"$w"
  mv -f "$w" "$AUTH"
  mkdir -p "$STATE/usage/$WID"
  PORTNUM=$(jq -r .port "$WD/config.json")
  status "$WID" starting "checking the engine" 0
  NID=$(notify -p "Starting $WNAME" "Loading it on $(gpus | jq -r --arg k "$1" --argjson n $# '[.[] | select(.key == $k) | .name][0] | if $n > 1 then "\($n) × \(.)" else . end'). This takes a few minutes.")
  phase_start "$WID" "$PORTNUM" "$@" | while IFS= read -r w; do status "$WID" starting "$w" 0; done

  # The bar follows the engine's own log (loadstep), never a clock. A card reset under the engine, or 15 minutes without
  # a line from it, ends the start there instead of at the 30-minute limit.
  t0=$SECONDS
  nodes=()
  for w in "$@"; do
    [[ $w == nvidia:* ]] || nodes+=("$(readlink -f "$(gpus none | jq -r --arg k "$w" '.[] | select(.key == $k) | .node // empty')" || true)")
  done
  seen=$(resets ${nodes[@]+"${nodes[@]}"})
  quiet=$SECONDS last="" top=1
  GW=$(gw_addr "$WID") || fail "the gateway has no address on the model's network"
  while :; do
    code=$(curl -s --noproxy '*' -m 5 -o "$WD/models.json" -w '%{http_code}' -H "@$AUTH" "$GW/v1/models" || true)
    served=$(jq -r '.data[0].id // empty' "$WD/models.json" 2>/dev/null || true)
    [[ $code == "200" && -n $served ]] && break
    [[ $code == "401" ]] && fail "the gateway refuses this install's key"
    ((SECONDS - t0 < 1800)) || fail "the engine did not answer within 30 minutes"
    (($(docker inspect -f '{{.RestartCount}}' "$(engine "$WID")" 2>/dev/null || echo 0) < 2)) || fail "the engine keeps crashing"
    if [[ $(resets ${nodes[@]+"${nodes[@]}"}) != "$seen" ]]; then
      journalctl -k --since "-$((SECONDS - t0 + 60))s" --no-pager 2>/dev/null | grep -E ' (xe|i915|amdgpu) ' | tail -20 >>"$WD/err" || true
      fail "the GPU driver reset the card while the model loaded (kernel lines in the log)"
    fi
    IFS=$'\t' read -r step pct line < <(loadstep "$WID") || true
    [[ $line == "$last" ]] || { last=$line quiet=$SECONDS; }
    ((SECONDS - quiet < 900)) || fail "the engine printed nothing for 15 minutes while ${step:-loading}"
    w=${step:-loading}
    ((SECONDS - t0 < 60)) || w+=" · $(((SECONDS - t0) / 60)) min"
    ((SECONDS - quiet < 120)) || w+=", quiet for $(((SECONDS - quiet) / 60)) min"
    # the bar never goes back, though the draft model weights start their files again
    ((${pct:-1} <= top)) || top=$pct
    status "$WID" starting "$w" "$top"
    sleep 3
  done
  rm -f "$WD/models.json"

  status "$WID" starting "checking it answers" 99
  if curl -fsS --noproxy '*' --max-time 5 "http://127.0.0.1:$PORTNUM/v1/models" >/dev/null 2>&1; then
    fail "the gateway answers without the key"
  fi
  reply=$(curl -fsS --noproxy '*' --max-time 600 -H "@$AUTH" -H 'Content-Type: application/json' "$GW/v1/chat/completions" \
    -d "$(jq -nc --arg m "$served" '{model: $m, max_tokens: 200, messages: [{role: "user", content: "Count from 1 to 60. Nothing else."}]}')") ||
    fail "the model did not answer"
  # A cold first request can include compilation or queueing, so its wall time is not GPU decode speed.
  # vLLM puts thinking in `reasoning`, older engines in `reasoning_content`; 200 tokens can all be thinking
  jq -e '.choices[0].message | any(.content, .reasoning, .reasoning_content; type == "string" and length > 0)' <<<"$reply" >/dev/null ||
    fail "the model returned no answer"
  # what the cache holds, so Open keeps the agent's conversations inside it
  k=$(kv "$WID")
  if [[ -n $k ]]; then
    jq -c --argjson k "$k" '.serve.kv = $k' "$WD/config.json" >"$WD/config.json.$$" && mv -f "$WD/config.json.$$" "$WD/config.json"
  fi
  status "$WID" ready "" 100
  trap - EXIT
  count started
  notify -r "$NID" "$WNAME is ready" "Open your agent on it from Local AI." >/dev/null
}

cmd_run() {
  valid_id "${1:-}" && [[ -n ${2:-} ]] || die "run <recipe> <gpu>[,<gpu>...]"
  require_ready
  local id=${1%--*} keys=() k r d g port busy v n=1
  IFS=, read -ra keys <<<"$2"
  r=$(recipe "$id") || die "no recipe $id"
  [[ $(policy "$r") == "ok" ]] || die "recipe refused: $(policy "$r")"
  ((${#keys[@]} == $(jq -r '.cards // 1' <<<"$r"))) || die "$(jq -r .name <<<"$r") here runs on $(jq -r '.cards // 1' <<<"$r") card(s)"
  [[ $(printf '%s\n' "${keys[@]}" | sort -u | wc -l) == "${#keys[@]}" ]] || die "a card is named twice"
  k=$(jq -r --argjson h "$(host)" "$NEEDS"'unfit($h)' <<<"$r")
  [[ -z $k ]] || die "$(jq -r .name <<<"$r") $k"

  # the log keeps its last 5,000 lines once it passes 1 MB
  if [[ -f $LOG ]] && (($(wc -c <"$LOG") > 1048576)); then
    tail -n 5000 "$LOG" >"$LOG.$$" && mv -f "$LOG.$$" "$LOG"
  fi
  exec 9>"$STATE/claim.lock"
  flock -w 10 9 || die "another model operation is running; try again"
  busy=$(cat "$STATE"/deploy/*/config.json 2>/dev/null | jq -r '.keys[], .port')
  g=$(gpus)
  for k in "${keys[@]}"; do
    valid_key "$k" || die "run <recipe> <gpu>[,<gpu>...]"
    grep -qxF -- "$k" <<<"$busy" && die "$k is in use"
    jq -e --arg k "$k" --arg h "$(jq -r .hw <<<"$r")" 'any(.[]; .key == $k and .hw == $h)' <<<"$g" >/dev/null ||
      die "$(jq -r .name <<<"$r") is not validated for $k"
    v=$(card_taken "$g" "$k")
    [[ -z $v ]] || die "$k is in use by $v"
    v=$(card_room "$g" "$k" "$r")
    [[ -z $v ]] || die "$v"
  done
  while [[ -f $(dir_of "$id")/config.json ]]; do
    n=$((n + 1))
    id="${1%--*}--$n"
  done
  d=$(dir_of "$id")
  for ((port = 12434; port < 12450; port++)); do
    grep -qx "$port" <<<"$busy" || ss -Hltn "sport = :$port" | grep -q . || break
  done
  ((port < 12450)) || die "no free port between 12434 and 12449"
  mkdir -p "$d"
  rm -f "$d/err" "$d/cancel"
  # what Open tells the agent is kept with the model, so a registry update that renames its recipe does not strand it
  jq -nc --arg id "$id" --argjson uid "$(id -u)" --argjson p "$port" --arg a "$(get agent)" --arg f "$(get folder)" --arg t "$(now)" --argjson r "$r" \
    --argjson managed "$(managed_paths "$r" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
    '{id: $id, containerUid: $uid, keys: $ARGS.positional, port: $p, agent: $a, folder: $f, startedAt: $t,
      recipe: $r, managedPaths: $managed, serve: {name: $r.name, ctx: ($r.serving.ctxTokens // 32768), vision: ($r.capabilities.vision // false)}}' \
    --args "${keys[@]}" >"$d/config.json.$$"
  mv -f "$d/config.json.$$" "$d/config.json"
  flock -u 9

  setsid "$0" __worker "$id" "${keys[@]}" </dev/null >/dev/null 2>&1 &
  jq -nc --argjson p "$!" --arg t "$(now)" '{state: "download", detail: "starting", percent: 0, error: "", pid: $p, at: $t}' >"$d/status.json.$$"
  mv -f "$d/status.json.$$" "$d/status.json"
  disown
}

# Stop waits for the starting worker before taking its containers down.
cmd_stop() {
  valid_id "${1:-}" || die "stop <recipe>"
  local d p i unshared=true
  d=$(dir_of "$1")
  [[ -d $d ]] || return 0
  : >"$d/cancel"
  if [[ $(jq -r .state "$d/status.json" 2>/dev/null) =~ ^(download|starting)$ ]]; then
    p=$(jq -r '.pid // 0' "$d/status.json")
    # A reboot can reuse a worker's pid; never signal an unrelated process group (or group zero).
    if [[ $p =~ ^[0-9]+$ && $p -gt 1 ]] && grep -qa 'omarchy-local-ai.*__worker' "/proc/$p/cmdline" 2>/dev/null; then
      kill -- -"$p" 2>/dev/null || true
      for ((i = 0; i < 120; i++)); do
        pgrep -g "$p" >/dev/null || break
        sleep 0.5
      done
      pgrep -g "$p" >/dev/null && die "the model is still stopping; try again"
    fi
  fi
  status "$1" stopping "" 0
  if [[ $(jq -r '.shared // false' "$d/config.json" 2>/dev/null) == "true" ]]; then
    (cmd_share "$1" off) || unshared=false
  fi
  if ! phase_stop "$1"; then
    status "$1" error "" 0 "could not stop it; try again"
    return 1
  fi
  if [[ $unshared == false ]]; then
    status "$1" error "" 0 "model stopped, but Tailscale sharing could not be removed; retry Stop"
    die "sharing could not be removed; the port remains reserved, retry Stop"
  fi
  rm -rf -- "$d"
  say "$1 stopped"
}

# Remove only this recipe's managed download, never the user's Hugging Face cache. A recipe this version no longer
# offers is forgotten by what its deployment recorded (managedPaths), once it has stopped; with --folder, a folder of
# such a recipe that nothing uses any more (unoffered), so no download is stranded by an update.
cmd_forget() {
  [[ ${1:-} != --folder ]] || { forget_folder "${2:-}"; return; }
  valid_id "${1:-}" || die "forget <recipe> | forget --folder <folder>"
  local r w d other live target self="" paths=() busy=()
  exec 9>"$STATE/claim.lock"
  flock -w 10 9 || die "another model operation is running; try again"
  if r=$(recipe "$1"); then
    [[ $(policy "$r") == "ok" ]] || die "recipe refused"
    while IFS= read -r d; do paths+=("$d"); done < <(managed_paths "$r")
  else
    self=$(dir_of "$1")/config.json
    [[ -f $self ]] || die "no recipe $1"
    # failed is not enough: its engine or gateway may still be there (a restart policy brings it back), so Docker must
    # answer and have neither
    [[ $(jq -r .state "${self%/*}/status.json" 2>/dev/null) == error ]] || die "stop $1 before removing its download"
    docker info >/dev/null 2>&1 || die "Docker is not responding; nothing was removed"
    ! ours "$(engine "$1")" && ! ours "$(gateway "$1")" || die "stop $1 before removing its download"
    while IFS= read -r d; do paths+=("$d"); done < <(jq -r '.managedPaths[]? | strings' "$self")
    ((${#paths[@]} > 0)) || die "$1 recorded no download to remove"
  fi
  for d in "${!paths[@]}"; do
    [[ ${paths[d]} == "$MODELS/"* && ${paths[d]} != *"/../"* && ${paths[d]} != *"/.."  ]] || die "invalid download path"
    paths[d]=${paths[d]%/}
  done
  for other in "$STATE"/deploy/*/config.json; do
    [[ $other != "$self" ]] || continue
    live=$(jq -ce '.recipe // empty' "$other" || recipe "$(jq -r .id "$other")") || live=""
    if [[ -n $live ]]; then
      if jq -e 'has("managedPaths")' "$other" >/dev/null; then
        [[ $(jq -cS '.managedPaths | sort' "$other") == "$(managed_paths "$live" | jq -Rsc 'split("\n") | map(select(length>0)) | sort')" ]] ||
          die "stop existing models with incomplete download records before removing downloads"
      fi
      while IFS= read -r d; do busy+=("$d"); done < <(managed_paths "$live")
    elif jq -e --arg root "$MODELS/" '.managedPaths | type == "array" and length > 0 and all(.[]; type == "string" and startswith($root))' "$other" >/dev/null; then
      while IFS= read -r d; do busy+=("$d"); done < <(jq -r '.managedPaths[]' "$other")
    else
      die "stop existing models before removing downloads"
    fi
  done
  for target in "${paths[@]}"; do
    for d in "${busy[@]}"; do
      [[ $target != "${d%/}" && $target != "${d%/}/"* && ${d%/} != "$target/"* ]] || die "stop models using these weights before removing the download"
    done
    if [[ -e $target || -L $target ]]; then
      owned "$target"
    fi
  done
  for target in "${paths[@]}"; do rm -rf -- "$target"; done
  say "$1 download removed"
}

# unoffered: model folders (weights, prepared packs) that no recipe offered here and no model here uses, as
# [{folder, gb}]: what a recipe a later version no longer ships left behind. Hub-layout weights share one cache and
# are not listed.
# deployed_paths: every managed path a model here uses, from its managedPaths and its recipe; fails when a model
# carries neither (one 6.9 or earlier started, or one adopted from 5.x), whose weights cannot be told apart
deployed_paths() {
  local c r d
  for c in "$STATE"/deploy/*/config.json; do
    jq -e '(.managedPaths | type == "array") or (.recipe | type == "object")' "$c" >/dev/null 2>&1 || return 1
    jq -r '.managedPaths[]? | strings' "$c"
    if r=$(jq -ce '.recipe | objects' "$c" 2>/dev/null); then
      while IFS= read -r d; do printf '%s\n' "$d"; done < <(managed_paths "$r")
    fi
  done
}

unoffered() {
  local d n r used deployed
  # nothing is listed while a running model's weights cannot be told apart from leftovers
  deployed=$(deployed_paths) || { echo '[]'; return; }
  used=$({
    jq -r '.hardware[].recipes[].weights[]? | select(.layout != "hub") | "\(.repository | gsub("/"; "--"))@\(.revision[:12])"' "$RECIPES"
    jq -c '.hardware[].recipes[] | select(.prepare != null)' "$RECIPES" | while IFS= read -r r; do d=$(prepared_path "$r"); echo "${d#"$MODELS"/}"; done
    printf '%s\n' "$deployed" | jq -Rr --arg m "$MODELS/" 'select(startswith($m))
      | ltrimstr($m) | split("/") | if .[0] == "prepared" then .[0:2] | join("/") else .[0] end'
  } | sort -u)
  for d in "$MODELS"/*@*/ "$MODELS"/prepared/*/; do
    n=${d%/}
    n=${n#"$MODELS"/}
    # a name with a tab or a newline is not one this plugin makes, and would break the list: it is left alone
    [[ $n != *[$'\t\n']* ]] || continue
    ! grep -qxF -- "$n" <<<"$used" || continue
    printf '%s\t%s\n' "$n" "$(du -sb -- "$d" 2>/dev/null | cut -f1)"
  done | jq -Rsc 'split("\n") | map(select(length > 0) | split("\t") | {folder: .[0], gb: ((.[1] | tonumber? // 0) / 1e8 | floor / 10)})'
}

# forget_folder <folder>: delete one folder unoffered lists, under the models folder, when no download is writing it
forget_folder() {
  local n=$1 t l fd
  [[ $n =~ ^[A-Za-z0-9_.-]+--[A-Za-z0-9_.-]+@[0-9a-f]{12}$ || $n =~ ^prepared/[0-9a-f]{64}$ ]] && [[ $n != *..* ]] ||
    die "forget --folder <folder>"
  exec 9>"$STATE/claim.lock"
  flock -w 10 9 || die "another model operation is running; try again"
  deployed_paths >/dev/null || die "stop existing models before removing downloads"
  unoffered | jq -e --arg n "$n" 'any(.[]; .folder == $n)' >/dev/null || die "$n is offered or in use; it is not removed"
  t=$MODELS/$n
  # the folder's own download lock, and any lock inside it (an earlier version locked the weights' dir in it)
  exec 7>"$t.lock"
  flock -n 7 || die "$n is still downloading"
  while IFS= read -r -d '' l; do
    exec {fd}>>"$l"
    flock -n "$fd" || die "$n is still downloading"
  done < <(find "$t" -name '*.lock' -type f -print0 2>/dev/null)
  owned "$t"
  rm -rf -- "$t"
  rm -f -- "$t.lock"
  say "$n removed: no recipe offered here uses it"
}

# get agent|folder [saved]: the saved default (read here unless passed), or pi (else the first agent installed) and
# ~/Work (else ~)
get() {
  local v=${2-} a
  (($# > 1)) || v=$(jq -r --arg k "$1" '.[$k] // empty' "$STATE/settings.json" 2>/dev/null || true)
  if [[ $1 == "agent" ]]; then
    for a in "$v" "${AGENTS[@]}" pi; do
      [[ -n $a ]] && bin "$a" >/dev/null && break
    done
  else
    for a in "$v" "$HOME_DIR/Work" "$HOME_DIR"; do
      [[ -d $a ]] && break
    done
  fi
  echo "$a"
}

# dirs <folder>: the folder (absolute, links resolved), its parent and its subfolders, for the panel's own folder
# browser. The panel never opens a native file dialog: one runs inside the shell, and its paste could make the shell
# read any amount from another program's clipboard. Hidden folders are left out; at most 400, by name.
cmd_dirs() {
  local d=${1:-$HOME}
  [[ $d == /* && -d $d && -r $d && -x $d ]] || d=$HOME
  d=$(cd -- "$d" && pwd -P)
  find "$d" -mindepth 1 -maxdepth 1 -type d ! -name '.*' -readable -printf '%f\0' 2>/dev/null | sort -z | head -z -n 400 |
    jq -Rsc --arg d "$d" '{path: $d, parent: (if $d == "/" then "" else ($d | sub("/[^/]*$"; "") | if . == "" then "/" else . end) end),
      dirs: (split("\u0000") | map(select(length > 0)))}'
}

# set agent|folder <value> [recipe]: a model choice or the default. Recent folders are kept for next time.
# set ping on|off: whether this install is counted (ping)
cmd_set() {
  local k=${1:-} v=${2:-} f files=("$STATE/settings.json")
  case $k in
  agent) printf '%s\n' "${AGENTS[@]}" | grep -qx -- "$v" || die "unknown agent" ;;
  folder)
    [[ -d $v ]] || die "that folder does not exist"
    v=$(cd -- "$v" && pwd)
    ;;
  ping) [[ ($v == on || $v == off) && -z ${3:-} ]] || die "set ping on|off" ;;
  *) die "set agent|folder <value> [recipe] | set ping on|off" ;;
  esac
  if [[ -n ${3:-} ]]; then
    valid_id "$3" && [[ -f $(dir_of "$3")/config.json ]] || die "$3 is not running"
    if [[ $k == agent ]]; then files=(); fi
    files+=("$(dir_of "$3")/config.json")
  fi
  for f in "${files[@]}"; do
    { cat "$f" 2>/dev/null || echo '{}'; } | jq --arg k "$k" --arg v "$v" \
      '.[$k] = $v | if $k == "folder" then .folders = ([$v] + ((.folders // []) - [$v]))[:6] else . end' >"$f.$$"
    mv -f "$f.$$" "$f"
  done
  # counting turned off drops the actions not yet sent
  [[ $k != ping || $v != off ]] || rm -f -- "$STATE/counts.json"
}

# card <recipe>: the model card (README.md) of the recipe's first weights, at the pinned revision, from Hugging Face;
# kept once fetched. Full screen shows it.
cmd_card() {
  valid_id "${1:-}" || die "card <recipe>"
  local r repo rev f
  r=$(recipe "$1") || die "no recipe $1"
  IFS=$'\t' read -r repo rev < <(jq -r '.weights[0] | [.repository, .revision] | @tsv' <<<"$r") || die "no weights"
  [[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ && $rev =~ ^[0-9a-f]{40}$ ]] || die "invalid weights"
  f=$STATE/cards/${repo//\//--}@$rev.md
  if [[ ! -s $f ]]; then
    mkdir -p "$STATE/cards"
    hf_curl -fsSL --proto '=https' --connect-timeout 10 --max-time 20 --max-filesize 1048576 \
      "https://huggingface.co/$repo/raw/$rev/README.md" >"$f.$$" || { rm -f "$f.$$"; die "could not fetch the model card"; }
    mv -f "$f.$$" "$f"
  fi
  cat "$f"
}

# download <recipe> [off]: a model's weights and its engine image, without running it (Models tab); off cancels and
# forgets it. Its progress is in the snapshot's downloads until it finishes; a finished one is the recipe's
# `downloaded`.
cmd_download() {
  valid_id "${1:-}" || die "download <recipe> [off]"
  local id=${1%--*} r d pid
  d=$STATE/downloads/$id
  if [[ ${2:-} == off ]]; then
    touch "$d/cancel" 2>/dev/null || true
    pid=$(jq -r '.pid // 0' "$d/status.json" 2>/dev/null || echo 0)
    if ((pid > 1)) && grep -qa omarchy-local-ai "/proc/$pid/cmdline" 2>/dev/null; then kill -- "-$pid" 2>/dev/null || true; fi
    rm -rf -- "$d"
    return 0
  fi
  r=$(recipe "$id") || die "no recipe $id"
  [[ $(policy "$r") == "ok" ]] || die "recipe refused: $(policy "$r")"
  [[ ! -f $d/status.json || $(jq -r .state "$d/status.json") == "error" ]] || die "$(jq -r .name <<<"$r") is already downloading"
  rm -rf -- "$d"
  mkdir -p "$d"
  setsid "$0" __download "$id" </dev/null >/dev/null 2>&1 &
  jq -nc --argjson p "$!" --arg t "$(now)" '{state: "download", detail: "starting", percent: 0, error: "", pid: $p, at: $t}' >"$d/status.json.$$"
  mv -f "$d/status.json.$$" "$d/status.json"
  disown
}
download_run() {
  local id=$1 r w img
  # this worker's status lives with the downloads, never with the running models
  dir_of() { printf '%s/downloads/%s' "$STATE" "$1"; }
  r=$(recipe "$id") || die "no recipe $id"
  trap 'rc=$?; if ((rc)) && [[ ! -f $(dir_of "$id")/cancel ]]; then status "$id" error "" 0 "$(grep "^local-ai: " "$(dir_of "$id")/err" 2>/dev/null | tail -1 | cut -c11- || true)"; fi' EXIT
  exec 2>>"$(dir_of "$id")/err"
  rm -f "$STATE/hf.header" # a token file an older version kept
  status "$id" download "checking the files" 0
  while IFS= read -r w; do
    fetch "$id" "$w"
  done < <(jq -c '.weights[]?' <<<"$r")
  img=$(jq -r .image <<<"$r")
  if ! docker image inspect "$img" >/dev/null 2>&1; then
    status "$id" download "downloading the engine" 99
    pull "$img" engine >/dev/null || die "could not pull $img"
  fi
  rm -rf -- "$(dir_of "$id")"
  count downloaded
}

# pin <recipe> [off]: a model not on this machine, kept on home to try later, the latest first
cmd_pin() {
  local f=$STATE/settings.json
  valid_id "${1:-}" || die "pin <recipe> [off]"
  { cat "$f" 2>/dev/null || echo '{}'; } | jq --arg id "${1%--*}" --arg off "${2:-}" \
    '.pins = (if $off == "off" then (.pins // []) - [$id] else [$id] + ((.pins // []) - [$id]) end)' >"$f.$$"
  mv -f "$f.$$" "$f"
}

# bin <agent>: how to start it, preferring a copy in ~/.local/bin that the session's PATH may not have
bin() {
  if [[ -x $HOME_DIR/.local/bin/$1 ]]; then
    echo "$HOME_DIR/.local/bin/$1"
  else
    omarchy-cmd-present "$1" && echo "$1"
  fi
}

# Use the installed agent's manager: mise, which is how Omarchy installs every agent, upgrades only this tool, from home
# rather than a project's config; without mise an agent that updates itself does. The plugin never runs a package
# manager itself, so an agent installed some other way (npm, say) is updated the way it was installed.
cmd_update() (
  local a=${1:-} b tool
  [[ $a != plugin ]] || { update_plugin; exit; }
  printf '%s\n' "${AGENTS[@]}" | grep -qx -- "$a" || die "unknown agent"
  b=$(bin "$a") || die "$a is not installed"
  exec 7>"$STATE/update.lock"
  flock -n 7 || die "an agent update is already running"
  cd -- "$HOME_DIR"
  tool=$a
  case $a in
    grok) tool=npm:@xai-official/grok ;;
    omp) tool=github:can1357/oh-my-pi ;;
    hermes) tool='pipx:hermes-agent[extras=all]' ;;
  esac
  local cmd=()
  if omarchy-cmd-present mise && timeout 10 mise ls --installed --json "$tool" 2>/dev/null | jq -e 'length > 0' >/dev/null; then
    cmd=(mise --yes upgrade --bump "$tool")
    # Omarchy's Hermes launcher uses this interpreter for its native dependencies.
    [[ $a != hermes ]] || export UV_PYTHON=3.13
  else
    case $a in
      omp | hermes | claude) cmd=("$b" update) ;;
      opencode) cmd=("$b" upgrade) ;;
      *) die "update $a with the package manager that installed it" ;;
    esac
  fi
  say "updating $a"
  timeout 840 "${cmd[@]}" >>"$LOG" 2>&1 || die "could not update $a; see the Local AI log"
  say "updated $a"
  jq -c --arg a "$a" '.updates |= del(.[$a])' "$STATE/outdated.json" >"$STATE/outdated.json.$$" 2>/dev/null && mv -f "$STATE/outdated.json.$$" "$STATE/outdated.json" || rm -f "$STATE/outdated.json.$$"
  printf 'Updated %s. New sessions use the updated version.\n' "$a"
)

# The plugin itself: Omarchy installs it as a git checkout and `omarchy plugin update` moves it to the origin's default
# branch, which only ever carries releases. The check reads that branch's commit and fetches nothing; an update is one
# when this checkout does not already contain it (a checkout ahead of the release is not offered the older one).
plugin_latest() {
  local head remote
  [[ -d $PANEL/.git ]] && omarchy-cmd-present omarchy-plugin-update || return 0
  head=$(git -C "$PANEL" rev-parse HEAD 2>/dev/null) || return 0
  remote=$(GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -oBatchMode=yes" timeout 20 git -C "$PANEL" ls-remote origin HEAD 2>/dev/null | cut -f1) || return 0
  [[ $remote =~ ^[0-9a-f]{40}$ && $remote != "$head" ]] || return 0
  git -C "$PANEL" merge-base --is-ancestor "$remote" HEAD 2>/dev/null && return 0
  jq -nc --arg h "$head" --arg l "$remote" '{head: $h, latest: $l}'
}
# The update runs in a terminal that lists what is new (the changelog's headlines, not Omarchy's full diff of every
# recipe) and updates straight away; Omarchy's update does the work with --yes, so its validation, rollback and panel
# reload stay. The panel sees the result on its next poll (the offer ends once this checkout has the release). The
# terminal is released like an agent's (open), so the panel's time limit never ends it.
update_plugin() {
  local id launcher
  id=$(jq -er .id "$PANEL/manifest.json") || die "this plugin has no manifest id"
  say "opening the plugin update"
  omarchy-launch-tui --app-id=org.omarchy.local-ai-update "$TARGET" __update "$id" </dev/null >/dev/null 2>&1 &
  launcher=$!
  sleep 0.3
  if ! kill -0 "$launcher" 2>/dev/null; then
    wait "$launcher" || die "could not open the update terminal; try again"
  fi
  disown "$launcher" 2>/dev/null || true
  printf 'Updating in a terminal: it lists what is new.\n'
}

# what is new, as a short bullet list: each changelog entry newer than this version, cut to its headline (no
# parentheses, code marks or detail after the first comma, colon or sentence), at most eight, then a count
update_notes() {
  local cur=$1 cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 100)}
  awk -v cur="[$cur]" -v w="$((cols > 40 ? cols - 6 : 74))" '
    /^## \[/ { if (index($0, cur)) exit; on = ($2 != "[Unreleased]"); next }
    !on || !/^- / { next }
    {
      t = substr($0, 3); gsub(/ \([^)]*\)/, "", t); gsub(/`/, "", t)
      if (match(t, /(\. |: |, |; )/)) t = substr(t, 1, RSTART - 1)
      sub(/\.$/, "", t); if (length(t) > w) t = substr(t, 1, w - 1) "…"
      if (++n <= 8) print "  • " t
    }
    END { if (n > 8) print "  • and " n - 8 " more" }
  '
}

update_run() {
  local id=$1 cur new
  printf 'Checking for the new version…\n'
  if ! git -C "$PANEL" fetch --quiet origin HEAD 2>/dev/null; then
    printf 'Could not reach the update server. Check the connection and try again.\n'
    read -r -p "Press Enter to close. " _; return 1
  fi
  cur=$(jq -r '.version // "?"' "$PANEL/manifest.json" 2>/dev/null)
  new=$(git -C "$PANEL" show FETCH_HEAD:manifest.json 2>/dev/null | jq -r '.version // "?"' 2>/dev/null)
  clear 2>/dev/null || true
  if [[ $(git -C "$PANEL" rev-parse HEAD) == $(git -C "$PANEL" rev-parse FETCH_HEAD) ]]; then
    printf 'Local AI %s is up to date.\n' "$cur"; sleep 2; return 0
  fi
  printf 'Local AI %s → %s\n\n' "$cur" "${new:-?}"
  git -C "$PANEL" show FETCH_HEAD:CHANGELOG.md 2>/dev/null | update_notes "$cur"
  printf '\nUpdating…\n'
  if omarchy-plugin-update "$id" --yes >/dev/null 2>"$STATE/update.err"; then
    printf 'Local AI is now %s.\n' "${new:-up to date}"; sleep 5
  else
    printf 'Local AI was not updated:\n'; tail -n 3 "$STATE/update.err"
    read -r -p "Press Enter to close. " _; return 1
  fi
}

# outdated: which installed agents have a newer version from mise, the manager update uses, kept in outdated.json for
# the snapshot; an agent that updates itself (claude, omp, hermes, opencode) without mise is not asked, and one installed
# some other way is not offered an update the panel cannot run
cmd_outdated() (
  local a b tool m='{}' out='{}' cur lat p
  cd -- "$HOME_DIR"
  omarchy-cmd-present mise && m=$(timeout 60 mise outdated --json 2>/dev/null | jq -c 'if type == "object" then . else {} end' 2>/dev/null) || m='{}'
  [[ -n $m ]] || m='{}'
  for a in "${AGENTS[@]}"; do
    b=$(bin "$a") || continue
    tool=$a
    case $a in
      grok) tool=npm:@xai-official/grok ;;
      omp) tool=github:can1357/oh-my-pi ;;
      hermes) tool='pipx:hermes-agent' ;;
    esac
    IFS=$'\t' read -r cur lat < <(jq -r --arg t "$tool" --arg a "$a" '
      ([to_entries[] | select(.key == $t or .key == $a or (.key | startswith($t + "["))) | .value][0] // {}) as $x
      | [$x.current // "", $x.latest // ""] | @tsv' <<<"$m") || true
    [[ -n $lat && $lat != "$cur" ]] && out=$(jq -c --arg a "$a" --arg c "$cur" --arg l "$lat" '.[$a] = {current: $c, latest: $l}' <<<"$out")
  done
  p=$(plugin_latest) || p=
  jq -nc --argjson u "$out" --arg t "$(now)" --argjson p "${p:-null}" '{at: $t, updates: $u, plugin: $p}' >"$STATE/outdated.json.$$"
  mv -f "$STATE/outdated.json.$$" "$STATE/outdated.json"
)

# keyed <VAR...>: argv that exports the gateway key into those variables, read from its file, then runs the rest
keyed() {
  printf '%s\0' bash -c 'k=$(<"$1"); shift; while [[ $1 != -- ]]; do export "$1=$k"; shift; done; shift; exec "$@"' \
    local-ai "$KEY" "$@" --
}

# argv <agent> <binary> <endpoint> <model> <context> <vision> <agent-dir>: the command that points the agent
# at the gateway, NUL-separated; the key stays in the environment or in a config file only this user reads
argv() {
  local a=$1 b=$2 ep=$3 m=$4 ctx=$5 vis=$6 ag=$7 input='["text"]'
  # These land in TOML, YAML and JSON configs: a number is digits or the default, a flag is true or false, and every
  # string is quoted by jq (tojson or --arg), never pasted in
  [[ $ctx =~ ^[0-9]{1,9}$ ]] || ctx=32768
  [[ $vis == true ]] || vis=false
  [[ $vis == "true" ]] && input='["text","image"]'
  case $a in
  claude)
    keyed ANTHROPIC_AUTH_TOKEN
    printf '%s\0' env "ANTHROPIC_BASE_URL=$ep" "ANTHROPIC_MODEL=$m" "ANTHROPIC_DEFAULT_SONNET_MODEL=$m" \
      "ANTHROPIC_DEFAULT_OPUS_MODEL=$m" "ANTHROPIC_DEFAULT_HAIKU_MODEL=$m" "$b" --model "$m"
    ;;
  codex)
    keyed LOCAL_AI_KEY
    printf '%s\0' "$b" -c "model_providers.local.name=Omarchy Local" -c "model_providers.local.base_url=$ep/v1" \
      -c "model_providers.local.wire_api=responses" -c "model_providers.local.env_key=LOCAL_AI_KEY" \
      -c "model_provider=local" -c "model=$(jq -nc --arg v "$m" '$v')" -c "model_context_window=$ctx"
    ;;
  opencode)
    # the model comes from the config's `model`, not a --model flag: some OpenCode builds reject the flag (#157)
    keyed OMARCHY_LOCAL_AI_KEY
    printf '%s\0' env "OPENCODE_CONFIG_CONTENT=$(jq -nc --arg u "$ep/v1" --arg m "$m" --argjson ctx "$ctx" --argjson in "$input" '
      {"$schema": "https://opencode.ai/config.json", model: ("omarchy-local/" + $m), small_model: ("omarchy-local/" + $m),
       provider: {"omarchy-local": {npm: "@ai-sdk/openai-compatible", name: "Omarchy Local",
         options: {baseURL: $u, apiKey: "{env:OMARCHY_LOCAL_AI_KEY}"},
         models: {($m): {name: $m, limit: {context: $ctx, output: 8192}, modalities: {input: $in, output: ["text"]}}}}}}')" \
      "$b"
    ;;
  pi | omp)
    # --rawfile, not --arg: jq reads the key itself, so only its path is in argv. A key passed as an
    # argument is readable by other local users in /proc/<pid>/cmdline while jq runs, and the key never rotates.
    jq -nc --arg u "$ep/v1" --arg m "$m" --rawfile k "$KEY" --argjson ctx "$ctx" --argjson in "$input" '
      {providers: {"omarchy-local": {baseUrl: $u, apiKey: ($k | rtrimstr("\n")), api: "openai-completions",
        models: [{id: $m, name: ($m + " · local"), reasoning: true, contextWindow: $ctx, maxTokens: 32768, input: $in,
          thinkingLevelMap: {minimal: "low", low: "low", medium: "medium", high: "xhigh", xhigh: "xhigh", max: null},
          cost: {input: 0, output: 0, cacheRead: 0, cacheWrite: 0}, compat: {supportsDeveloperRole: false}}]}}}' >"$ag/models.json"
    if [[ $a == "omp" ]]; then
      cp -f "$ag/models.json" "$ag/models.yml"
      printf 'modelRoles:\n  default: %s\nsetupVersion: 2\n' "$(jq -nr --arg m "omarchy-local/$m" '$m | tojson')" >"$ag/config.yml"
    fi
    # omp is a fork of pi and reads either variable. SGLang and vLLM take a system message, not "developer",
    # and Qwen3.8's template takes low, medium or xhigh reasoning effort.
    printf '%s\0' env "PI_CODING_AGENT_DIR=$ag" "OMP_CODING_AGENT_DIR=$ag" OMP_NO_WEBP=1 "$b" --provider omarchy-local --model "$m" --thinking xhigh
    ;;
  crush)
    mkdir -p "$ag/crush"
    jq -nc --arg u "$ep/v1" --arg m "$m" --rawfile k "$KEY" --argjson ctx "$ctx" --argjson v "$vis" '
      {providers: {"omarchy-local": {type: "openai", name: "Omarchy Local", base_url: $u, api_key: ($k | rtrimstr("\n")),
        models: [{id: $m, name: $m, context_window: $ctx, default_max_tokens: 8192, supports_attachments: $v}]}},
       models: {large: {provider: "omarchy-local", model: $m}, small: {provider: "omarchy-local", model: $m}}}' >"$ag/crush/crush.json"
    printf '%s\0' env "XDG_CONFIG_HOME=$ag" "XDG_DATA_HOME=$ag" "$b"
    ;;
  copilot)
    keyed COPILOT_PROVIDER_API_KEY
    printf '%s\0' env "COPILOT_PROVIDER_BASE_URL=$ep/v1" "$b" --model "$m"
    ;;
  grok)
    printf '[models]\ndefault = "omarchy-local"\n[features]\nremote_fetch = false\ntelemetry = false\n' >"$ag/config.toml"
    printf '[model.omarchy-local]\nmodel = %s\nbase_url = %s\ncontext_window = %s\nenv_key = "XAI_API_KEY"\n' \
      "$(jq -n --arg v "$m" '$v')" "$(jq -n --arg v "$ep/v1" '$v')" "$ctx" >>"$ag/config.toml"
    keyed XAI_API_KEY
    printf '%s\0' env "GROK_HOME=$ag" "$b" --model omarchy-local
    ;;
  hermes)
    # Hermes takes its endpoint from its own config.yaml, never from OPENAI_BASE_URL: --provider custom and
    # CUSTOM_BASE_URL point this session at the gateway without touching that file, and a matching OPENAI_BASE_URL
    # is what lets it send OPENAI_API_KEY there (and no other key)
    keyed OPENAI_API_KEY
    printf '%s\0' env "CUSTOM_BASE_URL=$ep/v1" "OPENAI_BASE_URL=$ep/v1" "$b" chat --provider custom --model "$m"
    ;;
  workbuddy)
    # WorkBuddy has no OpenAI-compatible env vars: its agent CLI (codebuddy) reads its model catalogue from
    # models.json, which it re-reads live ("Loaded custom models config from user"), and picks the model with
    # CODEBUDDY_MODEL. The entry carries the gateway's chat/completions URL and the key as its apiKey, sent as a
    # Bearer token, so the key never appears in argv.
    # The file is an object, not a list: a list leaves availableModels undefined, and the provider then keeps the
    # model out of availableModels, where WorkBuddy's own filter drops it and it never shows up in the model picker.
    # The app prefixes the id with "custom-local:" itself (productFeatures.CustomModelIdPrefix), and keeps the
    # id as an alias, so the prefixed id is what selects the model.
    # The catalogue goes in WorkBuddy's own directory: $WORKBUDDY_CONFIG_DIR also holds its settings.json, its MCP
    # configuration and its approval state, and pointing it elsewhere would start the app without them. That file
    # is the user's own (0600) and the app re-reads it, so the entry is there before the app needs it.
    wb_models="$HOME_DIR/.workbuddy-ai/models.json"
    mkdir -p "$HOME_DIR/.workbuddy-ai"
    [[ -f $wb_models ]] || printf '{}\n' >"$wb_models"
    jq --arg id "omarchy-local-$m" --arg name "$m · local" --arg url "$ep/v1/chat/completions" \
      --rawfile k "$KEY" --argjson ctx "$ctx" --argjson vis "$vis" '
      (if type == "array" then {models: .} else . end)
      | .models = ((.models // []) | map(select(.id != $id and .id != ("custom-local:" + $id))))
      | .models += [{
          id: $id, name: $name, url: $url, apiKey: ($k | rtrimstr("\n")),
          maxInputTokens: $ctx, maxOutputTokens: 8192,
          supportsToolCall: true, supportsImages: $vis, supportsReasoning: true,
          reasoning: {defaultEffort: "medium", supportedEfforts: ["low", "medium", "high"], canDisableThinking: true}
        }]
      | .availableModels = (((.availableModels // []) | map(select(. != $id and . != ("custom-local:" + $id)))) + [$id])
    ' "$wb_models" >"$wb_models.$$" && mv -f "$wb_models.$$" "$wb_models"
    chmod 600 "$wb_models"
    printf '%s\0' env "CODEBUDDY_MODEL=custom-local:omarchy-local-$m" "CODEBUDDY_DISABLE_BUILTIN_MODELS=1" "$b"
    ;;
  *)
    keyed OPENAI_API_KEY
    printf '%s\0' env "OPENAI_BASE_URL=$ep/v1" "OPENAI_API_BASE=$ep/v1" "OPENAI_MODEL=$m" "$b"
    ;;
  esac
}

# open <id>: the model's agent in its folder, in a terminal
cmd_open() {
  valid_id "${1:-}" || die "open <recipe>"
  local d c s k a b ag dir cmd=() v launcher gw
  d=$(dir_of "$1")
  [[ $(jq -r .state "$d/status.json" 2>/dev/null) == "ready" ]] || die "the model is not ready"
  c=$(<"$d/config.json")
  gw=$(gw_addr "$1") || die "the model's gateway is not running; start the model again"
  # a model started before its config kept this reads it from its recipe; one whose recipe is gone since opens under
  # its id (the gateway maps any model name onto the served one) with the context its engine reports: an agent told
  # less than the engine holds cuts its own replies short once a conversation outgrows it
  s=$(jq -ce '.serve // empty' <<<"$c") ||
    s=$(recipe "$1" | jq -ce '{name, ctx: (.serving.ctxTokens // 32768), vision: (.capabilities.vision // false)}') ||
    s=$(curl -fsS --noproxy '*' -m 5 -o /dev/stdout -H "@$AUTH" "$gw/v1/models" 2>/dev/null |
      jq -ce --arg n "${1%--*}" '{name: $n, ctx: (.data[0].max_model_len // empty), vision: false}') ||
    s=$(jq -nc --arg n "${1%--*}" '{name: $n, ctx: 32768, vision: false}')
  # a cache smaller than the context is what the agent gets, less room for a full reply (32768) beyond the 16384 an
  # agent keeps back for one, and for its own estimate of the conversation: one that outgrows the cache is aborted
  # mid-reply ("out of memory") before the agent compacts it
  k=$(jq -r '.kv // empty' <<<"$s")
  [[ -n $k ]] || k=$(kv "$1")
  if [[ -n $k ]]; then
    s=$(jq -c --argjson k "$k" '([$k - 24576, ($k / 2 | floor)] | max) as $w | if $w < .ctx then .ctx = $w else . end' <<<"$s")
  fi
  a=$(jq -r .agent <<<"$c")
  dir=$(jq -r .folder <<<"$c")
  b=$(bin "$a") || die "$a is not installed"
  [[ -d $dir ]] || die "the chosen folder is gone; choose another folder"
  ag=$STATE/agents/$a
  mkdir -p "$ag"
  # the gateway maps any model name onto the served one, so agents see the recipe's name
  while IFS= read -r -d '' v; do
    cmd+=("$v")
  done < <(argv "$a" "$b" "$gw" "$(jq -r .name <<<"$s")" \
    "$(jq -r .ctx <<<"$s")" "$(jq -r .vision <<<"$s")" "$ag")
  [[ $a == "omp" && $dir -ef $HOME_DIR ]] && cmd+=(--allow-home)
  # an inherited HTTP(S)_PROXY usually exempts 127.0.0.1 but not the bridge address: the agent must reach the gateway
  # directly, or the key would go to the proxy
  v=${gw#http://}; v=${v%:*}
  cmd=(env "NO_PROXY=$v${NO_PROXY:+,$NO_PROXY}" "no_proxy=$v${no_proxy:+,$no_proxy}" "${cmd[@]}")
  say "open $a on $1 in $dir with $(jq -r .ctx <<<"$s") tokens of context"
  # Some terminals keep their launcher alive for the whole session. Release the panel after startup,
  # or its action timeout would kill a healthy agent two minutes later.
  omarchy-launch-tui --app-id=org.omarchy.local-ai bash -c 'cd -- "$1" && shift && exec "$@"' local-ai "$dir" "${cmd[@]}" \
    </dev/null >/dev/null 2>&1 &
  launcher=$!
  sleep 0.3
  if ! kill -0 "$launcher" 2>/dev/null; then
    wait "$launcher" || die "could not open the agent terminal; try again"
  fi
  disown "$launcher" 2>/dev/null || true
  count opened
}

# share <id> [off]: tailscale serve as you; never take over another account's operator.
cmd_share() {
  local f on=${2:-on} p operator t=""
  f=$(dir_of "${1:-}")/config.json
  valid_id "${1:-}" && [[ -f $f ]] || die "the model is not running"
  [[ $on == on || $on == off ]] || die "share <recipe> [off]"
  [[ $on == off || $(jq -r .state "${f%/*}/status.json") == ready ]] || die "the model is not ready to share"
  p=$(jq -r .port "$f")
  if [[ $on == on ]]; then
    # nothing is shared while any program of this account can become root through 6.0-6.4's polkit files (lib/access.sh)
    ! legacy_polkit || die "$LEGACY_POLKIT_REASON"
    ! ipv6_open "$1" || die "$IPV6_OPEN"
    t=$(gw_addr "$1") || die "the model's gateway is not running; start the model again"
  fi
  if ! serve "$p" "$on" "$t"; then
    operator=$(timeout 10 tailscale debug prefs 2>/dev/null | jq -r '.OperatorUser // ""') || operator=""
    [[ -z $operator || $operator == "$USER" ]] || die "another account manages Tailscale; ask that account to change the share"
    die "Tailscale could not change the share; check that it is running and ask its operator for access"
  fi
  jq --argjson s "$([[ $on == "on" ]] && echo true || echo false)" '.shared = $s' "$f" >"$f.$$"
  mv -f "$f.$$" "$f"
}

# summary <usage dir>: one model's usage so far, kept in summary.json beside its log and brought up to date by reading
# only the lines added since (complete ones: a line still being written waits for the next time), 100,000 at a time.
# Tokens are kept per hour, with the counts and sums the averages need, so a snapshot costs what is new, not the whole
# history. One reader brings it up to date while another uses what is there; a log that shrank (cleared or rotated)
# is summed again from its start.
summary() {
  local f=$1/usage.jsonl s=$1/summary.json n seen take head
  [[ -f $f ]] || { echo '{}'; return; }
  # the summary carries the log's time from just before its lines were counted: a log that is not newer has
  # nothing new, and a line written while the summary was made makes it newer again
  if [[ -f $s && ! $f -nt $s ]]; then
    echo "$(<"$s")"
    return
  fi
  touch -r "$f" "$s.mark"
  n=$(wc -l <"$f")
  # the count of lines read leads the summary, so it is read without jq
  seen=0
  if [[ -f $s ]] && IFS= read -r -n 32 head <"$s" && [[ $head =~ ^\{\"lines\":([0-9]+) ]]; then
    seen=${BASH_REMATCH[1]}
  fi
  if ((n < seen)); then seen=0; rm -f "$s"; fi
  if ((n > seen)) || [[ ! -f $s ]]; then
    (
      flock -n 9 || exit 0
      while ((seen < n)) || [[ ! -f $s ]]; do
        take=$((n - seen < 100000 ? n - seen : 100000))
        if sed -n "$((seen + 1)),$((seen + take))p;$((seen + take))q" "$f" | { grep '^{' || true; } |
          jq -sc --argjson n "$((seen + take))" --slurpfile old <(cat "$s" 2>/dev/null || echo '{}') '
            def rate: .completion / ((if .ms > .ttft_ms then .ms - .ttft_ms else .ms end) / 1000);
            def bump(groups; key; val): reduce groups[] as $g (.; .[$g[0] | key | tostring] += ($g | val));
            $old[0] as $o | map(. + {v: ((.prompt // 0) + (.completion // 0))}) as $rs
            | [$rs[] | select(.completion > 8 and .ms > 0) | rate] as $dec
            | [$rs[] | select(.prompt > 64 and .ttft_ms > 0 and .ttft_ms < .ms) | .prompt / (.ttft_ms / 1000)] as $pre
            | [$rs[] | select(.ttft_ms < .ms)] as $tt
            | {lines: $n} + ($o | del(.lines)) + {requests: (($o.requests // 0) + ($rs | length)), total: (($o.total // 0) + ([$rs[].v] | add // 0)),
                hours: (($o.hours // {}) | bump($rs | group_by(.t / 3600 | floor); .t / 3600 | floor; map(.v) | add)),
                first: ([$o.first, ($rs | map(.t) | min)] | map(select(. != null)) | min),
                last: ([$o.last, ($rs | map(.t) | max)] | map(select(. != null)) | max),
                decode: {n: (($o.decode.n // 0) + ($dec | length)), sum: (($o.decode.sum // 0) + ($dec | add // 0))},
                prefill: {n: (($o.prefill.n // 0) + ($pre | length)), sum: (($o.prefill.sum // 0) + ($pre | add // 0))},
                ttftn: (($o.ttftn // 0) + ($tt | length)),
                ttft: (($o.ttft // {}) | bump($tt | group_by(.ttft_ms / 50 | floor); .ttft_ms / 50 | floor; length))}' \
          >"$s.$$" 2>/dev/null && mv -f "$s.$$" "$s"; then :
        else rm -f "$s.$$"; break; fi
        seen=$((seen + take))
      done
      touch -r "$s.mark" "$s"
    ) 9>"$s.lock"
  else
    touch -r "$s.mark" "$s"
  fi
  if [[ -f $s ]]; then echo "$(<"$s")"; else echo '{}'; fi
}

# tokens: this week's and all-time tokens, and your lifetime: requests, the first and last answer, and the tokens of
# each day of the last 20 weeks, from a Monday (the activity grid on home: a column a week, a row a weekday)
tokens() {
  local w0 d
  w0=$(date -d "$(printf '%(%F)T' -1) -$(($(printf '%(%u)T' -1) - 1 + 133)) days 00:00" +%s)
  for d in "$STATE"/usage/*/; do [[ -d $d ]] && summary "${d%/}"; done |
    jq -sc --argjson d0 "$(date -d '6 days ago 00:00' +%s)" --argjson now "$EPOCHSECONDS" --argjson w0 "$w0" '
      # a day is a local calendar day: a daylight-saving change makes one 23 or 25 hours long
      def day: localtime | mktime / 86400 | floor;
      [.[] | select(.requests > 0)] as $all | ($w0 | day) as $l0
      | [$all[] | .hours | to_entries[] | {t: (.key | tonumber * 3600), v: .value}] as $h
      | {week: ([$h[] | select(.t >= $d0) | .v] | add // 0), total: ([$all[].total] | add // 0),
         life: {requests: ([$all[].requests] | add // 0), since: ([$all[].first] | min // $now | strflocaltime("%b %-d")),
           last: ([$all[].last] | max // $now), start: $w0, today: (($now | day) - $l0),
           days: ([$h[] | {d: ((.t | day) - $l0), v} | select(.d >= 0 and .d < 140)]
             | reduce .[] as $x ([range(140) | 0]; .[$x.d] += $x.v))}}' \
    2>/dev/null || echo '{"week":0,"total":0,"life":{"requests":0,"days":[]}}'
}

# session <id> <since>: tokens since this start (to the hour) and in the last seven days (from the midnight tokens
# counts its week from), and over every run of this model: averages, the median first token, and a 24-point line
# from the first answer to the last, so the latest growth sits at the right edge
session() {
  summary "$STATE/usage/$1" | jq -c --argjson s "$2" --argjson now "$EPOCHSECONDS" --argjson d0 "$(date -d '6 days ago 00:00' +%s)" '
    def avg(x): if (x.n // 0) > 0 then x.sum / x.n | round else null end;
    [(.hours // {}) | to_entries[] | {t: (.key | tonumber * 3600), v: .value}] as $h
    | (.first // $s) as $from | (.last // $now) as $last | (($last - $from) / 24 + 1) as $step
    | (.ttftn // 0) as $tn
    | {tokens: ([$h[] | select(.t + 3600 > $s) | .v] | add // 0), week: ([$h[] | select(.t >= $d0) | .v] | add // 0),
       all: {since: ($from | strflocaltime("%b %-d")), last: $last, tokens: (.total // 0), decode: avg(.decode), prefill: avg(.prefill),
         ttft: (if $tn > 0 then [.ttft | to_entries[] | {b: (.key | tonumber), c: .value}] | sort_by(.b)
           | reduce .[] as $x ({s: 0, m: null}; (if .m == null and .s + $x.c > $tn / 2 then .m = $x.b * 50 + 25 else . end) | .s += $x.c) | .m
           else null end),
         line: [range(1; 25) as $i | [$h[] | select(.t < $from + $i * $step) | .v] | add // 0]}}' 2>/dev/null ||
    echo '{"tokens":0,"week":0,"all":{"tokens":0,"line":[]}}'
}


# privatize: a model an older version started has its engine on the gateway's bridge, where the host and so every local
# account can reach it. Move it, while it runs, to its own private network, where the gateway finds it by the same
# name; Docker keeps the change across restarts. Once per model: a marker says it is done, or that it could not be
# done (an old Docker), which the log says once, with the remedy.
privatize() {
  local d id why
  for d in "$STATE"/deploy/*/; do
    id=$(basename "$d")
    valid_id "$id" && [[ -f $d/config.json && ! -f $d/private && ! -f $d/private-failed ]] || continue
    ours "$(engine "$id")" && ours "$(gateway "$id")" || continue
    joined "$(engine "$id")" "$(network "$id")" || { touch "$d/private"; continue; }
    if why=$(docker_private) && private_net "$id" &&
      { joined "$(engine "$id")" "$(private "$id")" ||
        docker network connect --alias engine "$(private "$id")" "$(engine "$id")" >/dev/null 2>&1; } &&
      { joined "$(gateway "$id")" "$(private "$id")" ||
        docker network connect "$(private "$id")" "$(gateway "$id")" >/dev/null 2>&1; } &&
      docker network disconnect "$(network "$id")" "$(engine "$id")" >/dev/null 2>&1; then
      touch "$d/private"
      say "$id: its engine moved to a private network"
    else
      touch "$d/private-failed"
      say "$id: could not move its engine to a private network${why:+ ($why)}; stop and start it"
    fi
  done
}
# joined <container> <network>: whether the container is on that network
joined() {
  [[ " $(docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$1" 2>/dev/null)" == *" $2 "* ]]
}

# adopt: the models a 5.x install left running (its ledger.json) become deployments here, once
adopt() {
  local id c
  [[ -f $STATE/ledger.json ]] || return 0
  while IFS=$'\t' read -r id c; do
    valid_id "$id" && [[ ! -d $(dir_of "$id") ]] || continue
    mkdir -p "$(dir_of "$id")"
    printf '%s\n' "$c" >"$(dir_of "$id")/config.json"
    jq -nc '{state: "ready", detail: "", percent: 100, error: "", pid: 0}' >"$(dir_of "$id")/status.json"
    say "$id adopted from 5.x"
  done < <(jq -r --arg a "$(get agent)" --arg f "$(get folder)" --arg t "$(now)" '.slots // {} | to_entries[]
    | [.key, ({id: .key, keys: (.value.keys // []), port: .value.port, agent: $a, folder: $f, startedAt: (.value.startedAt // $t)} | tojson)]
    | @tsv' "$STATE/ledger.json" 2>/dev/null)
  mv -f "$STATE/ledger.json" "$STATE/ledger.json.5x"
}

# what the widget needs of a recipe
SUMMARY='def downloaded($h): [.weights[]? | if .layout == "hub" then "" else "\(.repository | gsub("/"; "--"))@\(.revision[:12])\(if (.dir // "") != "" then "/" + .dir else "" end)" end] as $w
  | ($w | length) > 0 and all($w[]; . as $x | $x != "" and ($h.have | index($x + "/.verified2")) != null);
def summary($h): {id, name, family, cards: (.cards // 1), format, engine, sizeGb, ctx: .serving.ctxTokens, caps: .capabilities, reported: (.reported // false), aa,
  needs, weights: [.weights[]? | {repository, revision}], unfit: unfit($h), downloaded: downloaded($h)};'

# downloads: each download under way or failed, with its id; one whose worker is gone has stopped
downloads() {
  local f pid
  for f in "$STATE"/downloads/*/status.json; do
    [[ -f $f ]] || continue
    pid=$(jq -r '.pid // 0' "$f" 2>/dev/null || echo 0)
    jq -c --arg id "$(basename "$(dirname "$f")")" --argjson alive "$(grep -qa omarchy-local-ai "/proc/$pid/cmdline" 2>/dev/null && echo true || echo false)" \
      '{id: $id, state, detail, percent, error} | if .state == "download" and ($alive | not) then .state = "error" | .error = "the download stopped" else . end' "$f" 2>/dev/null
  done | jq -sc .
}

cmd_snapshot() {
  local deps=() d id port at st pid sat boot obj why rc code gw ts="" sa="" sf="" sfs="" v="" a rstate="" rmsg=""
  mkdir -p "$STATE/deploy"
  adopt
  # whether a model can start, and if not what the panel offers (lib/access.sh); Docker is asked only when it can answer
  IFS=$'\t' read -r rstate rmsg < <(readiness) || true
  [[ -n $rstate ]] || { rstate=docker-down; rmsg="could not check whether Docker is ready"; }
  [[ $rstate != ready ]] || privatize
  omarchy-cmd-present tailscale && ts=$(timeout 3 tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // "" | rtrimstr(".")' || true)
  # each running model: its config and status in one read, then whether its worker or engine is gone; the final
  # step joins its recipe
  # a worker is gone when its pid is not one of ours (after a reboot the number can belong to anything) or its status
  # was written before this boot
  boot=$(awk '/^btime/ {print $2}' /proc/stat 2>/dev/null || echo 0)
  for d in "$STATE"/deploy/*/; do
    [[ -f $d/status.json ]] && sf=$d/status.json || sf=/dev/null
    { IFS=$'\t' read -r id port at st pid sat && IFS= read -r obj; } < <(jq -r --slurpfile s "$sf" --arg ts "$ts" '
      ($s[0] // {state: "error", error: "no status"}) as $st
      | ([.id, .port, .startedAt, $st.state // "error", $st.pid // 0, $st.at // .startedAt] | @tsv),
        (. + ($st | {state, detail, percent, error})
          + {shared: (if $ts != "" and (.shared // false) then "https://\($ts):\(.port)" else "" end)} | tojson)' "$d/config.json" 2>/dev/null) ||
      continue
    why="" gw=""
    case $st in
    download | starting | stopping)
      if (($(date -d "$sat" +%s 2>/dev/null || echo 0) < boot)); then
        why="the machine restarted while it was ${st/#download/downloading}"
      elif ! grep -qa omarchy-local-ai "/proc/$pid/cmdline" 2>/dev/null; then
        why="stopped unexpectedly"
      fi
      ;;
    ready)
      # liveness from the keyless /health (200 engine up, 503 engine gone): the poll never sends the key, so a
      # listener that took over a vacated port learns nothing; refused or an empty reply means the gateway is gone
      rc=0
      code=$(curl -s --noproxy '*' -m 2 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/health") || rc=$?
      if ((rc == 7 || rc == 52)) || [[ $code == "502" || $code == "503" ]]; then why="the engine stopped"; fi
      # where you send the key yourself (the model's page copies it): the gateway's bridge address, as for the agents
      [[ $rstate != ready ]] || gw=$(gw_addr "$id") || gw=""
      if [[ $rstate == ready && -z $why ]] && ipv6_open "$id"; then why=$IPV6_OPEN; fi
      ;;
    esac
    deps+=("{\"d\":$obj,\"u\":$(session "$id" "$(date -d "$at" +%s)"),\"why\":\"$why\",\"gw\":\"$gw\"}")
  done
  { IFS= read -r -d '' sa && IFS= read -r -d '' sf && IFS= read -r -d '' sfs; } < <(jq -j '.agent // "", "\u0000",
    .folder // "", "\u0000", (.folders // [] | tojson), "\u0000"' "$STATE/settings.json" 2>/dev/null) || true
  [[ $(<"$PANEL/manifest.json") =~ \"version\":\ *\"([^\"]+)\" ]] && v=${BASH_REMATCH[1]}
  # the page, from the recipes in use. The GPUs are read before it: a Docker that does not answer fails the snapshot as
  # it always has (the panel keeps the last one) and never reads as a catalog the page cannot be drawn from. A refreshed
  # catalog it cannot be drawn from stays where it is, and the shipped recipes answer this call (catalog_fallback), so
  # the panel never stops refreshing and the next refresh can replace it.
  local g
  page() {
  jq -nc --argjson g "$g" --slurpfile deps <(printf '%s\n' "${deps[@]}") \
    --arg rstate "$rstate" --arg rmsg "$rmsg" --argjson tokens "$(tokens)" --slurpfile rec "$RECIPES" \
    --arg setupError "$(cat "$STATE/setup-error" 2>/dev/null || true)" --arg ts "$ts" --arg agent "$(get agent "$sa")" --arg folder "$(get folder "$sf")" --arg version "$v" \
    --arg cdi "$(cdi_stale 2>/dev/null || true)" --argjson downloads "$(downloads)" --argjson unoffered "$(unoffered)" \
    --argjson outdated "$(jq -c '{at, updates, plugin}' "$STATE/outdated.json" 2>/dev/null || echo '{"at":"","updates":{}}')" \
    --arg head "$(git -C "$PANEL" rev-parse HEAD 2>/dev/null || true)" \
    --arg reporting "$(if [[ ${DO_NOT_TRACK:-0} != 0 ]]; then echo env; else jq -r '.ping // "unset"' "$STATE/settings.json" 2>/dev/null || echo unset; fi)" \
    --argjson folders "${sfs:-[]}" --argjson pins "$(jq -c '.pins // [] | map(strings)' "$STATE/settings.json" 2>/dev/null || echo '[]')" \
    --arg agents "$(for a in "${AGENTS[@]}"; do bin "$a" >/dev/null && echo "$a"; done)" --argjson host "$(host)" "$NEEDS$SUMMARY"'
    ($agents | split("\n") | map(select(length > 0))) as $agents
    # a running model with its session, in error when its worker or engine is gone; a second copy of a recipe runs
    # as <recipe>--2: its recipe is the one before the last "--", and its name when recipes.json no longer has it
    | ([$deps[] | .d + {session: .u, address: .gw} + (if .why != "" then {state: "error", error: .why} else {} end)
      | (.id | if test("--") then .[:rindex("--")] else . end) as $rid
      | {name: $rid, offered: any($rec[0].hardware[].recipes[]; .id == $rid)}
        + ([$rec[0].hardware[].recipes[] | select(.id == $rid)][0] // {} | summary($host) | del(.id, .unfit) | with_entries(select(.value != null))) + .]) as $deps
    | ([$deps[].keys[]]) as $busy
    | ([$g[] | select((.held or (.othersMiB // 0) > 2048) and (.key as $k | $busy | index($k) == null)) | .key]) as $taken
    | {version: $version, setupError: $setupError, readiness: {state: $rstate, message: $rmsg}, host: ($host | del(.have, .got)), week: $tokens.week, total: $tokens.total, life: $tokens.life, defaults: {agent: $agent, folder: $folder}, reporting: $reporting, agents: $agents, folders: $folders, pins: $pins, tailnet: $ts,
       cdi: (if $cdi == "" then null else ($cdi | split("\t") | {spec: .[0], why: .[1]}) end),
       downloads: $downloads, updates: $outdated.updates, updatesAt: $outdated.at,
       # what a recipe this version no longer offers left behind: folders to remove, downloads to clear
       unoffered: {folders: $unoffered, downloads: [$downloads[] | select(.id as $i | any($rec[0].hardware[].recipes[]; .id == $i) | not)]},
       # a plugin release found by the last check, while this checkout is still the one that check saw
       pluginUpdate: ($outdated.plugin != null and $outdated.plugin.head == $head), catalog: {commit: ($rec[0].registryCommit // ""), at: ($rec[0].refreshedAt // "")},
       gpus: [$g[] | . + {busy: (.key as $k | $busy | index($k) != null)}],
       kinds: [$g | map(select(.hw != "")) | group_by(.hw)[] | {hw: .[0].hw, keys: map(.key),
         # a card that drives a display comes last, so Start picks a card the desktop is not using
         free: ([.[] | select(.key as $k | ($busy + $taken) | index($k) == null)] | sort_by(.display // false) | map(.key)),
         taken: [.[] | select(.key as $k | $taken | index($k) != null) | .key],
         # the registry lists the recipes of a kind best first: the first on one card is its recommended model
         models: [$rec[0].hardware[.[0].hw].recipes[] | select((.cards // 1) == 1) | summary($host)],
         groups: [$rec[0].hardware[.[0].hw].recipes[] | select((.cards // 1) > 1) | summary($host)]}],
       deployments: $deps}'
  }
  g=$(gpus "$([[ $rstate == ready ]] || echo none)") || die "could not check the GPUs; try again"
  page && return 0
  [[ $RECIPES == "$CATALOG" ]] || return 1
  catalog_fallback "the panel could not be drawn from it"
  g=$(gpus "$([[ $rstate == ready ]] || echo none)") || die "could not check the GPUs; try again"
  page
}

# catalog_fallback <why>: answer this call from the recipes this version ships instead of the refreshed catalog, which
# stays where it is (a refresh checks a catalog before installing it, so this is one damaged since, or one a case
# the check did not foresee breaks); the log says why once per reason, not on every poll
catalog_fallback() {
  RECIPES=$PANEL/recipes.json
  [[ $(cat "$STATE/catalog-fallback" 2>/dev/null) != "$1" ]] || return 0
  printf '%s\n' "$1" >"$STATE/catalog-fallback"
  say "the refreshed model list is not used ($1); using the one this version ships"
}

paths "$HOME"
# Access is loaded here: the tests load every definition above this line and stub readiness.
# shellcheck source=../lib/access.sh
. "$PANEL/lib/access.sh"
mkdir -p "$STATE"
if [[ $RECIPES == "$CATALOG" ]] && ! jq -e '.hardware | type == "object"' "$CATALOG" >/dev/null 2>&1; then
  catalog_fallback "it does not load"
fi
# the verbs that use Docker run under the docker group, whatever groups this login began with
case ${1:-} in snapshot | run | stop | remove | readiness | download | open | share | forget) docker_group_reexec "$TARGET" "$@" ;; esac
case ${1:-} in
setup | registry | forget | snapshot | readiness | run | stop | open | update | outdated | set | dirs | share | pin | download | card) "cmd_$1" "${@:2}" ;;
# the stale NVIDIA device list, if any, as "<spec>\t<why>" (setup rewrites it)
cdi) cdi_stale ;;
log) exec omarchy-launch-tui --app-id=org.omarchy.local-ai-log less +G "$LOG" ;;
remove)
  for d in "$STATE"/deploy/*/; do
    cmd_stop "$(basename "$d")" || die "could not stop every model; files were kept"
  done
  phase_purge
  # everything else goes even when one folder cannot: Docker creates a missing mount source as root
  left=()
  # the catalog an earlier version refreshed (v3) goes too
  for p in "$MODELS" "${CATALOG%/*}" "${CATALOG%/*/*}/v3" "$STATE"; do rm -rf -- "$p" 2>/dev/null || left+=("$p"); done
  ((${#left[@]} == 0)) || die "everything else was removed; these hold files Docker created as root, delete them as root: ${left[*]}"
  ;;
__worker) worker_run "${@:2}" ;;
__download) download_run "${@:2}" ;;
__update) update_run "${@:2}" ;;
*)
  sed -n 's/^# omarchy:args=//p' "$0"
  exit 2
  ;;
esac
