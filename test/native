#!/usr/bin/env bash
# The native view is generated from this plugin's own UI, so a card change is made once here.
# This checks the generator's contract without an Omarchy checkout: it writes the view into a
# temporary tree, checks the generated files against the sources they claim to come from, and checks
# that --check actually fails on drift. With OMARCHY=<checkout> it also checks the real copy.
set -euo pipefail
ROOT=$(cd -- "${1:-$(dirname -- "${BASH_SOURCE[0]}")/..}" && pwd -P)
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
n=0
pass() { n=$((n+1)); echo "ok $n - $1"; }
fail() { echo "not ok - $1${2:+: $2}" >&2; exit 1; }

mkdir -p "$TMP/omarchy/shell/plugins/agents"
python3 "$ROOT/scripts/export_native_view.py" --omarchy "$TMP/omarchy" >/dev/null
OUT="$TMP/omarchy/shell/plugins/agents"

[[ $(ls "$OUT" | sort | tr '\n' ' ') == "LocalAi.js LocalAiRow.qml LocalAiTotal.qml " ]] || fail "the generator writes exactly the three shared files" "$(ls "$OUT")"
pass "the generator writes the three shared files and nothing else"

# ui.js is the source of the row data: the native copy is that file plus the one native-only tail.
python3 - "$ROOT" "$OUT" <<'PY' || exit 1
import pathlib, sys
root, out = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
source = (root / "ui/ui.js").read_text()
native = (out / "LocalAi.js").read_text()
normalized = native.replace("; LocalAi.qml only draws", "; Panel.qml only draws", 1)
if not normalized.startswith(source):
    print("LocalAi.js is not ui.js plus the native tail", file=sys.stderr); sys.exit(1)
tail = normalized[len(source):]
if tail != (root / "native/backend-command.js").read_text():
    print("the native tail is not native/backend-command.js", file=sys.stderr); sys.exit(1)
if native.count("function backendCommand(") != 1:
    print("backendCommand must appear exactly once", file=sys.stderr); sys.exit(1)
PY
[[ $? == 0 ]] || fail "LocalAi.js is ui.js plus the native tail"
pass "LocalAi.js is ui/ui.js plus native/backend-command.js, and nothing else"

# Every function the row data defines must reach the native view.
missing=$(python3 - "$ROOT" "$OUT" <<'PY'
import pathlib, re, sys
root, out = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
names = set(re.findall(r"^function (\w+)\(", (root / "ui/ui.js").read_text(), re.M))
native = (out / "LocalAi.js").read_text()
print(" ".join(sorted(n for n in names if f"function {n}(" not in native)))
PY
)
[[ -z $missing ]] || fail "the native copy is missing ui.js functions" "$missing"
pass "every function ui.js defines reaches the native view"

# The row component and the token bars are the plugin's own files, with only the import renamed.
for pair in "ui/CardRow.qml LocalAiRow.qml TokenTotal LocalAiTotal" "ui/TokenTotal.qml LocalAiTotal.qml LocalAiTotal LocalAiTotal"; do
  set -- $pair
  expected=$(sed -e "s|$3 {|$4 {|g" -e 's|^import "ui\.js" as Ui$|import "LocalAi.js" as Ui|' "$ROOT/$1")
  [[ $expected == "$(cat "$OUT/$2")" ]] || fail "$2 is $1 with the documented renames" "$(diff <(printf '%s\n' "$expected") "$OUT/$2" | head -5)"
done
pass "the row component and the token bars are this plugin's own files, component and import renamed"

grep -q 'import "ui.js"' "$OUT/LocalAiRow.qml" "$OUT/LocalAiTotal.qml" && fail "the native view imports this plugin's files" "$(grep -l 'import \"ui.js\"' "$OUT"/*.qml)"
pass "the native view imports no file from this plugin's ui directory"

# The copy renames the component it nests, so the plugin's own file must keep its own name.
grep -q '^  TokenTotal {' "$ROOT/ui/CardRow.qml" || fail "the plugin's row component no longer nests TokenTotal" "$(grep -n 'TokenTotal\|LocalAiTotal' "$ROOT/ui/CardRow.qml" | head -3)"
grep -q 'LocalAiTotal' "$ROOT/ui/CardRow.qml" && fail "the plugin's row component references Omarchy's component name"
grep -q 'LocalAiTotal {' "$OUT/LocalAiRow.qml" || fail "the generated row component does not nest LocalAiTotal"
pass "the copy renames the component it nests and this plugin's own file keeps its own name"

python3 "$ROOT/scripts/export_native_view.py" --omarchy "$TMP/omarchy" --check >/dev/null || fail "--check accepts what the generator just wrote"
pass "--check accepts a tree the generator just wrote"

printf '\n' >>"$OUT/LocalAiRow.qml"
python3 "$ROOT/scripts/export_native_view.py" --omarchy "$TMP/omarchy" --check >/dev/null 2>&1 && fail "--check accepts a drifted file"
pass "--check refuses a file that drifted from this plugin's UI"

if [[ -n ${OMARCHY:-} ]]; then
  [[ -d $OMARCHY/shell/plugins/agents ]] || fail "OMARCHY is not an Omarchy checkout" "$OMARCHY"
  python3 "$ROOT/scripts/export_native_view.py" --omarchy "$OMARCHY" --check >/dev/null || fail "the native view in OMARCHY has drifted from this plugin"
  pass "the native view in $OMARCHY is current with this plugin's UI"
fi

echo "1..$n"
