#!/usr/bin/env bash
# The plugin's test suite: an isolated state dir, a synthetic recipes.json, and shims for docker,
# curl, nvidia-smi, tailscale, and hf, so the whole load/accept/rollback/unload path runs on any
# machine with bash and jq. TAP-flavored: first failure ends the file. No GPU, no daemon, no network.
set -euo pipefail
ROOT=$(cd -- "${1:-$(dirname -- "${BASH_SOURCE[0]}")/..}" && pwd -P)   # -P: the CLI resolves itself with readlink -f, so a checkout reached through a symlink must compare equal
CLI="$ROOT/bin/omarchy-local-ai"
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
export OMARCHY_AI_USER_HOME="$TMP/home" OMARCHY_AI_STATE="$TMP/state" OMARCHY_AI_RECIPES="$TMP/recipes.json" \
  OMARCHY_AI_MODEL_ROOT="$TMP/home/.cache/omarchy/local-ai/models" OMARCHY_AI_CACHE_ROOT="$TMP/home/.cache/omarchy/local-ai/cache" \
  OMARCHY_AI_HF_HOME="$TMP/home/.cache/huggingface" OMARCHY_AI_PORT=12434 OMARCHY_AI_POLL=0 OMARCHY_AI_TIMEOUT=5 \
  OMARCHY_AI_FOREGROUND=1 OMARCHY_AI_NO_HOST_HF=1 OMARCHY_AI_NO_HOST_AMD=1 OMARCHY_AI_DOCKER=direct SHIM="$TMP/shim" OMARCHY_AI_DRI_PATH="$TMP/dri" \
  PATH="$TMP/bin:/usr/bin:/bin"   # shims plus the base system only; the developer's own agents must not leak in
mkdir -p "$TMP/bin" "$TMP/home" "$SHIM"
ln -s "$BASH" "$TMP/bin/bash"
ln -s "$(PATH="$PATH:/opt/homebrew/bin:/usr/local/bin" command -v jq)" "$TMP/bin/jq"
n=0
pass() { n=$((n+1)); echo "ok $n - $1"; }
fail() { echo "not ok - $1${2:+: $2}" >&2; exit 1; }
skip() { n=$((n+1)); echo "ok $n - # skip $1"; }
snap() { jq -r "$1" "$OMARCHY_AI_STATE/snapshot.json"; }
sha_of_file() { { command -v sha256sum >/dev/null 2>&1 && sha256sum -- "$1" || shasum -a 256 -- "$1"; } | cut -c1-64; }
mode() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }   # GNU first; BSD stat has no -c (and GNU stat -f prints instead of failing)

# ---------------------------------------------------------------- shims
cat >"$TMP/bin/nvidia-smi" <<'EOF'
#!/usr/bin/env bash
case "$*" in
  # the plugin asks one question now: rows that carry the driver version as a sixth column
  *",driver_version"*)
    if [[ -n ${SHIM_GPUS:-} ]]; then sed "s/$/ , ${SHIM_DRIVER:-580.65.06}/" <<<"$SHIM_GPUS"
    else echo "0, NVIDIA GeForce RTX 4090, 24564, 300, 24264, ${SHIM_DRIVER:-580.65.06}"; fi ;;
  *driver_version*) echo "${SHIM_DRIVER:-580.65.06}" ;;
  *) if [[ -n ${SHIM_GPUS:-} ]]; then printf '%s\n' "$SHIM_GPUS"; else echo "0, NVIDIA GeForce RTX 4090, 24564, 300, 24264"; fi ;;
esac
EOF
cat >"$TMP/bin/docker" <<'EOF'
#!/usr/bin/env bash
# a docker that remembers containers in $SHIM/containers/<name> and images in $SHIM/images
echo "docker $*" >>"$SHIM/docker.log"
[[ ${OMARCHY_AI_DOCKER:-} == prompt && ${SHIM_ROOT:-} != 1 ]] && { echo "permission denied while trying to connect to the Docker daemon socket" >&2; exit 1; }   # not in the docker group
case "$1" in
  network) nn=${@: -1}; case $2 in inspect) [[ -f $SHIM/net-$nn ]] && { echo 1; exit 0; } || exit 1 ;; create) touch "$SHIM/net-$nn" ;; rm) rm -f "$SHIM/net-$nn" ;; esac; exit 0 ;;
  ps) for d in "$SHIM"/containers/*/; do [[ -d $d ]] || continue; n=${d%/}; n=${n##*/}; grep -q "^io.omarchy.local-ai=1" "$d/labels" 2>/dev/null && echo "$n"; done; exit 0 ;;
  image) [[ $2 == inspect ]] && { grep -qxF "$3" "$SHIM/images" 2>/dev/null; exit $?; }; exit 0 ;;
  info) [[ -n ${SHIM_DOCKER_DOWN:-} ]] && { echo "$SHIM_DOCKER_DOWN" >&2; exit 1; }
    echo "Runtimes: io.containerd.runc.v2 ${SHIM_RUNTIMES:-nvidia} runc"
    [[ ${SHIM_RUNTIMES:-} == *amd* ]] && echo "  cdi: amd.com/gpu=0"
    exit 0 ;;
  pull) [[ ${SHIM_PULL_FAIL:-} == 1 ]] && { echo "${SHIM_PULL_ERR:-error pulling image configuration: no space left on device}" >&2; exit 1; }
    if [[ -n ${SHIM_PULL_SLOW:-} ]]; then   # docker's own progress lines, at the pace of a real pull
      echo "layer1: Downloading [>          ]  1.0MB/4.0MB"; sleep "$SHIM_PULL_SLOW"
      echo "layer1: Downloading [========>    ]  3.0MB/4.0MB"; sleep "$SHIM_PULL_SLOW"
    fi
    echo "$2" >>"$SHIM/images"; exit 0 ;;
  run)
    name=""; labels=""; role=""; args=("$@")
    for ((i=0;i<${#args[@]};i++)); do
      [[ ${args[$i]} == --name ]] && name=${args[$((i+1))]}
      [[ ${args[$i]} == --label ]] && labels+="${args[$((i+1))]}"$'\n'
      [[ ${args[$i]} == --entrypoint && ${args[$((i+1))]} == python3 ]] && role=download
    done
    if [[ $role == download ]]; then # the weights downloader: write a fake file into the mounted dir (a partial one first when slow)
      fname=model.safetensors; for a in "${args[@]}"; do [[ $a == HF_PATTERN=* ]] && fname=${a#HF_PATTERN=}; done   # a GGUF recipe fetches its one file
      for ((i=0;i<${#args[@]};i++)); do [[ ${args[$i]} == --volume ]] && { src=${args[$((i+1))]%%:*}; mkdir -p "$src"; [[ -n ${SHIM_DOWNLOAD_SLOW:-} ]] && { head -c 1024 /dev/zero >"$src/$fname"; sleep "$SHIM_DOWNLOAD_SLOW"; }; head -c 4096 /dev/zero >"$src/$fname"; }; done
      [[ ${SHIM_DOWNLOAD_FAIL:-} == 1 ]] && exit 1; exit 0
    fi
    [[ ${SHIM_RUN_FAIL:-} == "$name" ]] && exit 125
    mkdir -p "$SHIM/containers/$name"; printf '%s' "$labels" >"$SHIM/containers/$name/labels"; echo running >"$SHIM/containers/$name/state"
    [[ ${SHIM_CRASHLOOP:-} == 1 && $name == *-engine && ( -z ${SHIM_CRASHLOOP_UNLESS:-} || "$*" != *"$SHIM_CRASHLOOP_UNLESS"* ) ]] && { echo restarting >"$SHIM/containers/$name/state"; echo 3 >"$SHIM/containers/$name/restarts"; }   # exits at once under --restart: docker keeps it "running"
    exit 0 ;;
  inspect)
    fmt=""; name=""
    for a in "$@"; do case $a in -f) ;; '{{'*) fmt=$a ;; inspect) ;; *) name=$a ;; esac; done
    [[ -d $SHIM/containers/$name ]] || exit 1
    st=$(cat "$SHIM/containers/$name/state"); [[ $st == running || $st == restarting ]] && r=true || r=false
    case $fmt in
      *Restarting*) [[ $st == restarting ]] && rs=true || rs=false; echo "$r|$rs|$(cat "$SHIM/containers/$name/restarts" 2>/dev/null || echo 0)" ;;
      *'|'*) echo "$r|$(grep -E "^io.omarchy.local-ai=" "$SHIM/containers/$name/labels" | head -1 | cut -d= -f2-)|$(grep -E "^io.omarchy.local-ai.recipe=" "$SHIM/containers/$name/labels" | head -1 | cut -d= -f2-)" ;;
      *Labels*) key=${fmt#*\"}; key=${key%%\"*}; grep -E "^$key=" "$SHIM/containers/$name/labels" | head -1 | cut -d= -f2- ;;
      *Running*) echo "$r" ;;
      *) echo "[]" ;;
    esac; exit 0 ;;
  logs) [[ -n ${SHIM_LOGS:-} ]] && { printf '%s\n' "$SHIM_LOGS"; exit 0; }; printf 'Traceback (most recent call last):\n  File "/x/hub.py", line 1, in download\n    ^^^^\nOSError: [Errno 30] Read-only file system: /models/.cache\n'; exit 0 ;;
  stop) echo stopped >"$SHIM/containers/$2/state"; exit 0 ;;
  start) echo running >"$SHIM/containers/$2/state"; exit 0 ;;
  rename) mv "$SHIM/containers/$2" "$SHIM/containers/$3"; exit 0 ;;
  rm) rm -rf "$SHIM/containers/${@: -1}"; exit 0 ;;
esac
exit 0
EOF
cat >"$TMP/bin/curl" <<'EOF'
#!/usr/bin/env bash
# the gateway: healthy when the engine and gateway "containers" run; dialects from SHIM_APIS
url=${@: -1}
if [[ $url == */api/models/*/tree/* ]]; then [[ -f $SHIM/tree.json ]] || exit 22; cat "$SHIM/tree.json"; exit 0; fi   # the Hub's file tree of a revision, when a test provides one
if [[ $url == *recipes.json ]]; then # the registry's copy of the recipe file (SHIM_RECIPES_DOWN: no route)
  [[ ${SHIM_RECIPES_DOWN:-} == 1 ]] && { echo "curl: (6) Could not resolve host" >&2; exit 6; }
  out=/dev/stdout; for ((i=1;i<=$#;i++)); do [[ ${!i} == -o ]] && { j=$((i+1)); out=${!j}; }; done; cat "$SHIM/remote-recipes.json" >"$out"; exit 0
fi
data=""; auth=""; for ((i=1;i<=$#;i++)); do [[ ${!i} == -d ]] && { j=$((i+1)); data=${!j}; }; [[ ${!i} == -H ]] && { j=$((i+1)); h=${!j}; [[ $h == @* ]] && h=$(cat "${h#@}" 2>/dev/null); [[ $h == "Authorization: Bearer "* ]] && auth=${h#Authorization: Bearer }; }; done
printf '%s\n' "$*" >>"$SHIM/curl.log"   # this shim's argv is what /proc/<pid>/cmdline would show
if [[ $auth != "$(cat "$SHIM/../state/gateway.key" 2>/dev/null)" && ${SHIM_KEYLESS_GATEWAY:-} != 1 ]]; then   # the gateway refuses unkeyed requests; -f makes that exit 22
  [[ $* == *'%{http_code}'* ]] && { [[ ${SHIM_FOREIGN_PORT:-} == 1 ]] && { printf 'hello\n200'; exit 0; }; printf '{"error":{"type":"authentication_error","message":"invalid or missing API key"}}\n401'; exit 0; }; exit 22; fi
up=0; for g in "$SHIM"/containers/*-gateway/; do [[ -d $g ]] || continue; n=${g%/}; n=${n##*/}; e=${n%-gateway}-engine; [[ $(cat "$SHIM/containers/$n/state" 2>/dev/null) == running && $(cat "$SHIM/containers/$e/state" 2>/dev/null) == running ]] && up=1; done; (( up )) || exit 7   # some pair answers
apis=${SHIM_APIS:-chat,messages,responses}
case $url in
  */v1/models) echo "{\"data\":[{\"max_model_len\":${SHIM_CONTEXT:-0},\"id\":\"${SHIM_SERVED:-Test-Model}\"}]}" ;;   # SHIM_SERVED: what the engine calls its model (a GGUF recipe serves a path)
  */v1/chat/completions)
    if [[ $data == *'What single color fills'* ]]; then echo "{\"choices\":[{\"message\":{\"content\":\"${SHIM_MEDIA_REPLY:-Red}\"}}]}"
    elif [[ $data == *'"tools"'* ]]; then echo '{"choices":[{"message":{"content":null,"tool_calls":[{"function":{"name":"shell","arguments":"{\"command\":\"echo LOCAL_AI_TOOL_OK\"}"}}]}}],"usage":{"completion_tokens":12}}'
    elif [[ $data == *"Count from 1 to 80"* ]]; then # the speed probe: 80 words, usage optional, an optional delay to look like a CPU
      [[ -n ${SHIM_SLOW:-} ]] && sleep "$SHIM_SLOW"
      words=$(seq -s ' ' 1 80)
      [[ ${SHIM_LEAK_THINK:-} == 1 ]] && words="I should count.</think>$words"   # a reasoning model with the parser off
      if [[ ${SHIM_NO_USAGE:-} == 1 ]]; then echo "{\"choices\":[{\"message\":{\"content\":\"$words\"}}]}"
      else echo "{\"choices\":[{\"message\":{\"content\":\"$words\"}}],\"usage\":{\"completion_tokens\":${SHIM_TOKENS:-60}}}"; fi
    else echo "{\"choices\":[{\"message\":{\"content\":\"${SHIM_REPLY:-LOCAL_AI_READY}\"}}],\"usage\":{\"completion_tokens\":${SHIM_TOKENS:-12}}}"; fi ;;
  */v1/messages) [[ $apis == *messages* ]] || exit 22; echo '{"content":[{"type":"text","text":"LOCAL_AI_READY"}]}' ;;
  */v1/responses) [[ $apis == *responses* ]] || exit 22; echo '{"output":[{"type":"message","content":[{"type":"output_text","text":"LOCAL_AI_READY"}]}]}' ;;
esac
EOF
cat >"$TMP/bin/tailscale" <<'EOF'
#!/usr/bin/env bash
# status needs no operator; serve is never called (it would refuse a plain user)
case "$*" in
  "status --json") # SHIM_TS: default connected with both families; v6 = IPv6-only tailnet; off = logged in but down; newip = address changed
    case "${SHIM_TS:-}" in
      v6) echo '{"BackendState":"Running","Self":{"DNSName":"","Online":true,"TailscaleIPs":["fd7a:115c:a1e0::7"]}}' ;;
      off) echo '{"BackendState":"Stopped","Self":{"DNSName":"box.tail.ts.net.","Online":false,"TailscaleIPs":["100.64.0.7"]}}' ;;
      newip) echo '{"BackendState":"Running","Self":{"DNSName":"box.tail.ts.net.","Online":true,"TailscaleIPs":["100.64.0.9"]}}' ;;
      *) echo '{"BackendState":"Running","Self":{"DNSName":"box.tail.ts.net.","Online":true,"TailscaleIPs":["100.64.0.7","fd7a:115c:a1e0::7"]}}' ;;
    esac ;;
  serve*) echo "Access denied: serve config denied. Use 'sudo tailscale set --operator=\$USER' to not require root." >&2; exit 1 ;;
esac
EOF
cat >"$TMP/bin/pkexec" <<'EOF'
#!/usr/bin/env bash
# polkit: the prompt was dismissed when SHIM_PKEXEC_FAIL=1; otherwise the command runs, marked as the root side
echo "pkexec $*" >>"$SHIM/pkexec.log"
[[ ${SHIM_PKEXEC_FAIL:-} == 1 ]] && { echo "Error executing command as another user: Request dismissed" >&2; exit 126; }
# real pkexec starts from a clean environment: only what the plugin's env file carries reaches the root phase
args=(); for v in "${!SHIM_@}"; do args+=("$v=${!v}"); done
exec env -i PATH="$PATH" HOME="$HOME" TMPDIR="${TMPDIR:-/tmp}" SHIM="$SHIM" OMARCHY_AI_TEST_ROOT=1 SHIM_ROOT=1 PKEXEC_UID="${SHIM_PKEXEC_UID:-$(id -u)}" "${args[@]}" "$@"
EOF
cat >"$TMP/bin/lspci" <<'EOF'
#!/usr/bin/env bash
# an lspci whose pci.ids is older than the card: the marketing name is missing, the id is not
[[ -n ${SHIM_LSPCI:-} ]] || exit 0
printf '0000:45:00.0 VGA compatible controller [0300]: ASPEED Technology, Inc. ASPEED Graphics Family [1a03:2000] (rev 41)\n'
printf '0000:84:00.0 VGA compatible controller [0300]: Intel Corporation Device [8086:e223]\n'
printf '0000:c3:00.0 VGA compatible controller [0300]: Intel Corporation Battlemage G31 [Arc Pro B70] [8086:e223]\n'
printf '0000:c4:00.0 VGA compatible controller [0300]: Intel Corporation Device [8086:e223]\n'
EOF
printf '#!/usr/bin/env bash\n[[ ${SHIM_PORT_BUSY:-} == 1 ]] && echo "LISTEN 0 4096 127.0.0.1:12434 0.0.0.0:*"\nexit 0\n' >"$TMP/bin/ss"
for tk in pacman nvidia-ctk systemctl; do printf '#!/usr/bin/env bash\necho "%s $*" >>"$SHIM/toolkit.log"\n' "$tk" >"$TMP/bin/$tk"; done
for a in pi claude codex; do printf '#!/usr/bin/env bash\necho "$0 $* ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL:-} ANTHROPIC_AUTH_TOKEN=${ANTHROPIC_AUTH_TOKEN:-} LOCAL_AI_KEY=${LOCAL_AI_KEY:-}"\n' >"$TMP/bin/$a"; done
printf '#!/usr/bin/env bash\necho "launch $*"\n' >"$TMP/bin/omarchy-launch-tui"
printf '#!/usr/bin/env bash\necho pi\n' >"$TMP/bin/omarchy-default-agent"
find "$TMP/bin" -type f -exec chmod +x {} +   # not the jq symlink: its target is not ours to chmod on CI

# ---------------------------------------------------------------- fixture recipes.json
digest=$(printf 'a%.0s' {1..64}); rev=$(printf 'b%.0s' {1..40})
recipe() { # recipe <id> <tools> <mountkind hf|dir|asset>
  jq -n --arg id "$1" --arg dg "$digest" --argjson tools "$2" --arg kind "$3" --arg rev "$rev" '
    {id:$id, model:{id:"test",name:"Test Model",repository:"org/test",revision:$rev,servedName:"Test-Model",precision:"4 bpw",sizeGb:0.000001},
     engine:"tabbyapi", capabilities:{chat:true,tools:$tools}, serving:{ctxTokens:131072,concurrency:2}, speed:{tps:60},
     weights:{subdir:(if $kind=="hf" then "" else "Test-Model" end)}, image:{provenance:"upstream",attestation:null},
     launch:{image:("ghcr.io/x/engine@sha256:"+$dg), containerPort:5000, entrypoint:"/opt/venv/bin/python3", arguments:["main.py"], environment:{A:"1"},
       mounts:(if $kind=="hf" then [{source:"~/.cache/huggingface",target:"/root/.cache/huggingface",read_only:false}]
               elif $kind=="asset" then [{source:"${MODEL_ROOT}/test",target:"/workspace/models",read_only:true},{source:"asset/cfg.yml",target:"/app/config.yml",read_only:true}]
               else [{source:"${MODEL_ROOT}/test",target:"/workspace/models",read_only:true}] end),
       shm:"8g", ipc:null, networkMode:"bridge", capAdd:[], securityOpt:[]},
     validated:{harness:"test",acceptedAt:"2026-09-03T00:00:00Z"}}'
}
write_recipes() { # write_recipes <recipe-json> [hardware-id] [backend]
  jq -n --argjson r "$1" --arg hw "${2:-rtx-4090-24gb}" --arg backend "${3:-nvidia}" --arg dg "$digest" '
    {schemaVersion:"omarchy-local-ai/recipes/1", registryCommit:"deadbeef", generatedAt:"2026-09-03T00:00:00Z",
     gateway:{image:("ghcr.io/x/gateway@sha256:"+$dg)}, assets:{"cfg.yml":"model_name: Test-Model\n"},
     hardware:{($hw):{match:{backend:$backend,vramGb:24,names:[($hw|sub("-[0-9]+gb$";"")|gsub("-";""))],name:$hw}, recipe:$r}}}' >"$OMARCHY_AI_RECIPES"
}
write_recipes_alts() { # write_recipes_alts <recommended-json> <alt-json>...
  local r=$1; shift; local alts='[]'; for a in "$@"; do alts=$(jq -c --argjson a "$a" '.+[$a]' <<<"$alts"); done
  write_recipes "$r"; jq --argjson alts "$alts" '.hardware["rtx-4090-24gb"].recipes=$alts' "$OMARCHY_AI_RECIPES" >"$OMARCHY_AI_RECIPES.tmp" && mv "$OMARCHY_AI_RECIPES.tmp" "$OMARCHY_AI_RECIPES"
}
write_recipes_two() { # write_recipes_two <recipe-json> <hardware-id> <recipe-json> <hardware-id>: two card types, one recipe each
  write_recipes "$1" "$2"
  jq --argjson r "$3" --arg hw "$4" '.hardware[$hw]={match:{backend:"nvidia",vramGb:24,names:[($hw|sub("-[0-9]+gb$";"")|gsub("-";""))],name:$hw}, recipe:$r}' "$OMARCHY_AI_RECIPES" >"$OMARCHY_AI_RECIPES.tmp" && mv "$OMARCHY_AI_RECIPES.tmp" "$OMARCHY_AI_RECIPES"
}
write_recipes "$(recipe good true asset)"

# ---------------------------------------------------------------- tests
"$CLI" snapshot >/dev/null
[[ $(snap .state) == idle ]] || fail "fresh snapshot is idle" "$(snap .state)"; pass "fresh snapshot is idle"
[[ $(snap .selected.name) == "Test Model" ]] || fail "hardware matched the recipe"; pass "hardware match picks the recipe for the detected GPU"
[[ $(snap .selected.onDisk) == false ]] || fail "not downloaded yet"; pass "weights reported absent before any download"

"$CLI" load
[[ $(snap .state) == ready ]] || fail "load reaches ready" "$(snap .state) $(snap .error)"; pass "load: download, start, accept, ready"

# the pull is a step of its own on the card while it runs
: >"$SHIM/images"   # forget the images so the second load pulls again
SHIM_PULL_SLOW=2 "$CLI" load & pull_pid=$!
d=""
for ((i=0; i<200; i++)); do d=$(snap .operation.detail 2>/dev/null); [[ $d == "pulling image" ]] && break; sleep 0.1; done   # every ledger step costs seconds under the shims on a slow host: wait for the step, up to 20 s
[[ $d == "pulling image" ]] || fail "pull detail mid-flight" "$d"
wait "$pull_pid" || fail "load with a slow pull" "$(snap .error)"; pass "an image pull is reported as its own step while it runs"
[[ -f $OMARCHY_AI_MODEL_ROOT/test/Test-Model/model.safetensors ]] || fail "weights land in the subdir"; pass "weights downloaded into <mount>/<subdir>"
[[ $(snap .selected.onDisk) == true ]] || fail "marker present"; pass "marker records the download"
grep -q -- "--publish 127.0.0.1:12434:12434" "$SHIM/docker.log" || fail "gateway publishes the port"; pass "gateway publishes 127.0.0.1:12434, engine port stays private"
grep -q -- "--network-alias engine" "$SHIM/docker.log" || fail "engine on the private network"; pass "engine joins the private network as 'engine'"
grep -q -- "--volume $OMARCHY_AI_STATE/assets/cfg.yml:/app/config.yml:ro" "$SHIM/docker.log" || fail "asset mounted"; pass "config asset written from recipes.json and mounted read-only"
[[ $(cat "$OMARCHY_AI_STATE/assets/cfg.yml") == "model_name: Test-Model" ]] || fail "asset content"; pass "asset content matches the vendored file"
[[ $(snap '.apis|join(",")') == "chat,messages,responses" ]] || fail "all dialects accepted" "$(snap .apis)"; pass "acceptance probes chat, messages, and responses"
[[ $(snap '.agents.launchable|join(",")') == "pi,claude,codex" ]] || fail "launchable agents" "$(snap .agents.launchable)"; pass "every installed agent is launchable when every dialect passed"
[[ -s $OMARCHY_AI_STATE/gateway.key ]] || fail "key generated"; pass "gateway key generated on first start"
k=$(cat "$OMARCHY_AI_STATE/gateway.key")
grep -rq -- "$k" "$OMARCHY_AI_STATE/ledger.json" "$OMARCHY_AI_STATE/snapshot.json" "$OMARCHY_AI_STATE/log" && fail "key leaked into ledger, snapshot, or log"; pass "the key is in gateway.key only: not in the ledger, the snapshot, or the log"
[[ $(snap .share.keyFile) == "$OMARCHY_AI_STATE/gateway.key" && $(snap '.share|has("key")') == false ]] || fail "snapshot names the key file" "$(snap .share)"; pass "the snapshot carries the key file's path, never the key"
[[ $(mode "$OMARCHY_AI_STATE") == 700 ]] || fail "state dir mode" "$(ls -ld "$OMARCHY_AI_STATE")"; pass "the state directory is 0700"
for f in ledger.json snapshot.json log gateway.key; do m=$(mode "$OMARCHY_AI_STATE/$f"); [[ $m == 600 ]] || fail "mode of $f" "$m"; done; pass "ledger, snapshot, log, and key are 0600"
[[ $(mode "$OMARCHY_AI_STATE/assets/cfg.yml") == 644 ]] || fail "asset mode"; pass "mounted assets stay world-readable for the engine's uid"
argv=$("$CLI" open-agent claude); [[ $argv != *"$(cat "$OMARCHY_AI_STATE/gateway.key")"* ]] || fail "key in claude argv" "$argv"; pass "open-agent claude: the key is not in the launch argv"
out=$(eval "$argv"); [[ $out == *ANTHROPIC_BASE_URL=http://127.0.0.1:12434* && $out == *ANTHROPIC_AUTH_TOKEN=$(cat "$OMARCHY_AI_STATE/gateway.key")* ]] || fail "claude launch env" "$out"; pass "open-agent claude: endpoint and key in the environment, nothing on disk"
argv=$("$CLI" open-agent codex); out=$(eval "$argv"); [[ $out == *wire_api=responses* && $out == *model=Test-Model* && $out == *LOCAL_AI_KEY=$(cat "$OMARCHY_AI_STATE/gateway.key")* && $argv != *"$(cat "$OMARCHY_AI_STATE/gateway.key")"* ]] || fail "codex launch" "$out"; pass "open-agent codex: responses provider by flags, key by environment only"
grep -q -- "$(cat "$OMARCHY_AI_STATE/gateway.key")" "$SHIM/curl.log" && fail "key in curl argv" "$(grep -c . "$SHIM/curl.log") calls"; grep -q -- "-H @$OMARCHY_AI_STATE/gateway.auth" "$SHIM/curl.log" || fail "auth header file not used"; [[ $(mode "$OMARCHY_AI_STATE/gateway.auth") == 600 ]] || fail "auth file mode"; pass "acceptance GET and POST: the key is never in curl's argv; the header comes from a 0600 file"
[[ ! -e $OMARCHY_AI_USER_HOME/.claude.json && ! -e $OMARCHY_AI_USER_HOME/.codex ]] || fail "no user files touched"; pass "no user config files were created or edited"
"$CLI" open-agent pi >/dev/null; m=$(mode "$OMARCHY_AI_STATE/agents/pi/models.json"); [[ $m == 600 ]] || fail "agent config mode" "$m"; pass "agent launch configs that embed the key are 0600"

