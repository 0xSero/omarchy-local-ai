# a whole directory you already have (a safetensors model under ~/models) is verified file by file against the
# Hub's tree of the pinned revision and adopted: into the recipe's directory, or into the HF cache's own layout
blob_sha1() { { printf 'blob %d\0' "$(wc -c <"$1" | tr -d ' ')"; cat "$1"; } | { command -v sha1sum >/dev/null 2>&1 && sha1sum || shasum -a 1; } | cut -c1-40; }
mk_tree() { # mk_tree <dir>: the Hub's answer for that directory's files (large ones as LFS, small ones as plain blobs)
  local f rel; echo "["; local first=1
  for f in "$1"/*; do rel=${f##*/}; [[ $first == 1 ]] || echo ","; first=0
    if [[ $(wc -c <"$f" | tr -d ' ') -gt 1000 ]]; then printf '{"type":"file","path":"%s","size":%s,"oid":"%s","lfs":{"oid":"%s","size":%s}}' "$rel" "$(wc -c <"$f" | tr -d ' ')" "$(blob_sha1 "$f")" "$(sha_of_file "$f")" "$(wc -c <"$f" | tr -d ' ')"
    else printf '{"type":"file","path":"%s","size":%s,"oid":"%s","lfs":null}' "$rel" "$(wc -c <"$f" | tr -d ' ')" "$(blob_sha1 "$f")"; fi
  done; echo "]"
}
