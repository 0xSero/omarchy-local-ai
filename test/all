"$CLI" open-agent claude >/dev/null 2>&1 || true; [[ $(snap .state) == error && $(snap .error) == *"load a model first"* ]] || fail "refusal in ledger" "$(snap .error)"; pass "a refused verb writes its reason where the panel reads it"
"$CLI" load; [[ $(snap .state) == ready && $(snap .error) == "" ]] || fail "op clears refusal"; pass "a finished operation clears an earlier refusal"
"$CLI" open-agent nope >/dev/null 2>&1 || true; [[ $(snap .state) == ready && $(snap .error) != "" ]] || fail "refusal beside ready" "$(snap .state) $(snap .error)"; pass "a refused agent launch keeps a running model ready and shows the reason"
OMARCHY_AI_FOREGROUND=0 "$CLI" open-agent pi >/dev/null; [[ $(snap .error) == "" ]] || fail "launch clears refusal"; pass "a launch that works clears the earlier refusal"
[[ $("$CLI" agent-args ../../x -- a 2>&1 || true) == *"one of:"* ]] || fail "agent-args name"; "$CLI" agent-args pi -- --yolo "--name=a b" >/dev/null; argv=$("$CLI" open-agent pi); [[ $argv == *"--yolo --name=a\\ b"* ]] || fail "agent-args" "$argv"; "$CLI" agent-args pi >/dev/null; argv=$("$CLI" open-agent pi); [[ $argv != *yolo* ]] || fail "agent-args clear"; pass "agent-args adds the person's flags to that agent, and clears them"
mkdir -p "$TMP/work"; "$CLI" agent-dir "$TMP/work" >/dev/null; [[ $(cat "$OMARCHY_AI_STATE/agent-dir") == "$TMP/work" ]] || fail "agent-dir"; [[ $("$CLI" agent-dir "$TMP/nope" 2>&1 || true) == *"not a directory"* ]] || fail "agent-dir refusal"; pass "agent-dir records a directory and refuses a missing one"
jq '.op={name:"starting",recipeId:"x",pid:999999,startedAt:"t",detail:"loading the model",percent:0}' "$OMARCHY_AI_STATE/ledger.json" >"$TMP/l" && cat "$TMP/l" >"$OMARCHY_AI_STATE/ledger.json"
"$CLI" snapshot >/dev/null; [[ $(snap .error) == *"stopped unexpectedly while loading the model"* && $(snap .operation.name) == "" ]] || fail "vanished worker" "$(snap .error)"; pass "a worker killed without its exit trap is reported by the next refresh, not shown as starting forever"
# an older install: key copied into the ledger, files world-readable; the next snapshot scrubs and tightens
jq '.share={key:"leaked-old-key"}' "$OMARCHY_AI_STATE/ledger.json" >"$TMP/l.json" && mv "$TMP/l.json" "$OMARCHY_AI_STATE/ledger.json"; chmod 644 "$OMARCHY_AI_STATE/ledger.json" "$OMARCHY_AI_STATE/snapshot.json"
"$CLI" snapshot >/dev/null; grep -q leaked-old-key "$OMARCHY_AI_STATE/ledger.json" && fail "old key not scrubbed"
[[ $(mode "$OMARCHY_AI_STATE/ledger.json") == 600 ]] || fail "old ledger mode"; pass "an older install's ledger is scrubbed of the key and made 0600 on the next snapshot"
rm -f "$OMARCHY_AI_STATE/gateway.recipe.json"   # a gateway started by an older plugin: the recipe is recovered from the running container
"$CLI" share; "$CLI" snapshot >/dev/null; [[ $(snap .share.active) == true && $(snap .share.url) == http://box.tail.ts.net:12434 && $(snap .state) == ready ]] || fail "share after refusal" "$(snap .share) $(snap .state)"; pass "share works after an earlier refusal and for a gateway started by an older plugin"
"$CLI" share; "$CLI" snapshot >/dev/null; [[ $(snap .share.active) == false && $(snap .state) == ready ]] || fail "share off after refusal"; pass "share off leaves the model ready"
"$CLI" unload

# a gateway that serves without the key never becomes ready
SHIM_KEYLESS_GATEWAY=1 "$CLI" load
[[ $(snap .state) == error && $(snap .error) == *"without the key"* ]] || fail "keyless gateway refused" "$(snap .state) $(snap .error)"; pass "a gateway that answers without the key is refused at acceptance"

# docker trouble is said in the words that fix it, before anything is pulled
SHIM_DOCKER_DOWN="permission denied while trying to connect to the Docker daemon socket at unix:///var/run/docker.sock" "$CLI" load
[[ $(snap .error) == *"usermod -aG docker"* ]] || fail "docker group hint" "$(snap .error)"; pass "a user outside the docker group is told the exact command"
SHIM_RUNTIMES=runc SHIM_PKEXEC_FAIL=1 "$CLI" load
[[ $(snap .error) == *"NVIDIA container toolkit"* ]] || fail "toolkit hint" "$(snap .error)"; pass "a missing NVIDIA container toolkit, with the prompt dismissed, is named with its install steps"
SHIM_DOCKER_DOWN="Cannot connect to the Docker daemon at unix:///var/run/docker.sock. Is the docker daemon running?" "$CLI" load
[[ $(snap .error) == *"Docker is not running"* ]] || fail "daemon down hint" "$(snap .error)"; pass "a stopped daemon is named as such"
"$CLI" unload >/dev/null; rm -f "$SHIM/images"; SHIM_PULL_FAIL=1 "$CLI" load
[[ $(snap .error) == *"out of disk space"* ]] || fail "pull disk hint" "$(snap .error)"; pass "a failed pull says why in docker's words, translated"
SHIM_PULL_FAIL=1 SHIM_PULL_ERR="Error response from daemon: Get https://ghcr.io/v2/: dial tcp: i/o timeout" "$CLI" load
[[ $(snap .error) == *"no route to the image registry"* ]] || fail "pull network hint" "$(snap .error)"; pass "a pull without network says so"
"$CLI" load; [[ $(snap .state) == ready ]] || fail "recover after pull errors" "$(snap .error)"

# Omarchy keeps users out of the docker group: with the socket unwritable, one Start is ONE pkexec, the
# card's refresh makes no docker call, Stop and share are one pkexec each, and a failed acceptance
# costs one more for the rollback
"$CLI" unload >/dev/null; rm -f "$SHIM/images" "$OMARCHY_AI_STATE"/weights/*.json; : >"$SHIM/pkexec.log"
export OMARCHY_AI_DOCKER=prompt
n0=$(grep -c . "$SHIM/docker.log"); "$CLI" snapshot >/dev/null; [[ $(grep -c . "$SHIM/docker.log") == "$n0" ]] || fail "snapshot touched docker in prompt mode"; pass "prompt mode: the card's refresh makes no docker call"
SHIM_PKEXEC_UID=1006 "$CLI" load; [[ $(snap .state) == ready ]] || fail "prompt load" "$(snap .error)"; pass "prompt mode: a Start from nothing reaches ready"
[[ $(grep -c "pkexec" "$SHIM/pkexec.log") == 1 ]] || fail "one prompt per Start" "$(cat "$SHIM/pkexec.log")"; pass "prompt mode: images, weights, and both containers behind one password prompt"
grep -q "_root .* start" "$SHIM/pkexec.log" && grep -q -- "--user 1006:1006" "$SHIM/docker.log" || fail "root phase ran the gateway as the user" "$(grep -- --user "$SHIM/docker.log" | tail -1)"; pass "prompt mode: the gateway runs as the uid pkexec reports, never as root and never as a uid from a user-owned file"
sha() { printf '%s' "$1" | { command -v sha256sum >/dev/null 2>&1 && sha256sum || shasum -a 256; } | cut -c1-64; }
out=$(OMARCHY_AI_TEST_ROOT=1 PKEXEC_UID=$(id -u) "$CLI" _root "$OMARCHY_AI_STATE/root.env" 0000 stop 2>&1 || true); [[ $out == *"changed while the password prompt was open"* ]] || fail "env pin" "$out"; pass "root phase: an env file that is not what the prompt was raised for runs nothing"
command cp -f "$OMARCHY_AI_STATE/recipe.json" "$TMP/recipe.orig"; jq '.launch.mounts[0].source="${MODEL_ROOT}/../../../etc"' "$TMP/recipe.orig" >"$OMARCHY_AI_STATE/recipe.json"
out=$(OMARCHY_AI_TEST_ROOT=1 PKEXEC_UID=$(id -u) "$CLI" _root "$OMARCHY_AI_STATE/root.env" "$(sha "$(cat "$OMARCHY_AI_STATE/root.env")")" start "$OMARCHY_AI_STATE/recipe.json" 0 2>&1 || true); [[ $out == *"recipe.json changed while the password prompt was open"* ]] || fail "recipe pin" "$out"; pass "root phase: a recipe swapped under the prompt runs nothing"
command cp -f "$TMP/recipe.orig" "$OMARCHY_AI_STATE/recipe.json"
[[ $(snap .share.active) == false ]] || fail "share state"; : >"$SHIM/pkexec.log"; "$CLI" share; [[ $(snap .share.active) == true && $(grep -c pkexec "$SHIM/pkexec.log") == 1 ]] || fail "prompt share" "$(snap .share) $(cat "$SHIM/pkexec.log")"; pass "prompt mode: share is one prompt"
SHIM_PKEXEC_FAIL=1 "$CLI" share || true; [[ $(snap .share.active) == true && $(snap .share.error) == *"still shared"* ]] || fail "share off dismissed" "$(snap .share)"; pass "prompt mode: a dismissed Stop-sharing prompt keeps the card saying shared, with the reason"
"$CLI" share; : >"$SHIM/pkexec.log"; "$CLI" unload; [[ $(snap .state) == idle && $(grep -c pkexec "$SHIM/pkexec.log") == 1 ]] || fail "prompt unload" "$(snap .state)"; pass "prompt mode: Stop is one prompt"
"$CLI" load; : >"$SHIM/pkexec.log"; SHIM_REPLY=nope "$CLI" load; [[ $(snap .error) == *"chat acceptance failed"* && $(grep -c pkexec "$SHIM/pkexec.log") == 2 ]] || fail "prompt rollback" "$(snap .error) $(cat "$SHIM/pkexec.log")"; pass "prompt mode: a failed acceptance costs one more prompt to bring the previous model back"
[[ $(snap .state) == ready ]] || fail "prompt restore" "$(snap .state)"; pass "prompt mode: the previous model is back and ready"
SHIM_PKEXEC_FAIL=1 "$CLI" unload; [[ $(snap .error) != "" ]] || fail "dismissed prompt"; pass "prompt mode: a dismissed prompt is a reason on the card"
"$CLI" unload >/dev/null; SHIM_RUNTIMES=runc "$CLI" load; grep -q "pacman -S --noconfirm --needed nvidia-container-toolkit" "$SHIM/toolkit.log" && grep -q "nvidia-ctk runtime configure" "$SHIM/toolkit.log" || fail "toolkit setup" "$(cat "$SHIM/toolkit.log" 2>/dev/null)"; pass "prompt mode: a missing NVIDIA container toolkit is installed inside the same prompt"
export OMARCHY_AI_DOCKER=direct
: >"$SHIM/toolkit.log"; "$CLI" unload >/dev/null; SHIM_RUNTIMES=runc "$CLI" load; grep -q "pacman" "$SHIM/toolkit.log" || fail "direct toolkit"; pass "direct mode: a missing toolkit is set up behind one prompt, then Start continues"
"$CLI" load; [[ $(snap .state) == ready ]] || fail "recover" "$(snap .error)"

# a download can be stopped; partial weights stay and the next load resumes
"$CLI" unload >/dev/null; rm -f "$OMARCHY_AI_STATE/weights/good.json"; rm -rf "$OMARCHY_AI_MODEL_ROOT/test"
OMARCHY_AI_FOREGROUND=0 SHIM_DOWNLOAD_SLOW=20 "$CLI" load; for ((i=0;i<100;i++)); do [[ $(snap .state) == download && -s $OMARCHY_AI_MODEL_ROOT/test/Test-Model/model.safetensors ]] && break; sleep 0.1; done
[[ $(snap .state) == download ]] || fail "download in flight" "$(snap .state) $(snap .error)"
"$CLI" unload; [[ $(snap .state) == idle && $(snap .error) == "" && $(snap .operation.name) == "" ]] || fail "cancel" "$(snap .state) '$(snap .error)' $(snap .operation)"; pass "unload during a download stops it cleanly: idle, no error"
[[ -s $OMARCHY_AI_MODEL_ROOT/test/Test-Model/model.safetensors && ! -f $OMARCHY_AI_STATE/weights/good.json && $(snap .selected.partialBytes) -gt 0 && $(snap .selected.onDisk) == false ]] || fail "partial kept" "$(ls -la "$OMARCHY_AI_MODEL_ROOT/test/Test-Model" 2>&1) $(snap .selected)"; pass "partial weights stay on disk, unmarked, and the snapshot says how much is there"
"$CLI" load; [[ $(snap .state) == ready && $(snap .selected.onDisk) == true ]] || fail "resume" "$(snap .state) $(snap .error)"; pass "the next load resumes and completes"

# nothing can run without the recipe file, but the card still gets a sentence
echo '{"broken":' >"$TMP/broken.json"; out=$(OMARCHY_AI_RECIPES="$TMP/broken.json" "$CLI" snapshot 2>/dev/null || true)
[[ $(jq -r .state <<<"$out") == error && $(jq -r .error <<<"$out") == *"recipes.json"* ]] || fail "broken recipes" "$out"; pass "a broken recipes.json still prints an error state for the card"
# a worker that dies on something unforeseen leaves a reason, not a silent idle or a stale "starting"

SHIM_RUN_FAIL=omarchy-local-ai-good-engine OMARCHY_AI_MODEL_ROOT=/nonexistent-root/x "$CLI" load 2>/dev/null || true
[[ $(snap .error) != "" ]] || fail "unexpected death recorded" "$(snap .state) '$(snap .error)'"; pass "an unforeseen worker failure leaves a reason (and the previous model, when there was one)"

# failures during start are logged and rolled back
SHIM_RUN_FAIL=omarchy-local-ai-good-engine "$CLI" load
[[ $(snap .error) == *"engine failed to start"* || $(snap .error) == *"engine exited"* ]] || fail "start failure" "$(snap .state) $(snap .error)"
[[ $(cat "$SHIM/containers/omarchy-local-ai-good-engine/state") == running && $(cat "$SHIM/containers/omarchy-local-ai-good-gateway/state") == running && ! -d $SHIM/containers/omarchy-local-ai-good-engine-previous ]] || fail "start failure rollback" "$(ls "$SHIM/containers")"; pass "engine start failure is reported (the previous model restored when there was one)"
grep -q "rollback" "$OMARCHY_AI_STATE/log" || fail "logged"; pass "every worker step is in the log"

# an engine that crashes at once under docker's restart policy is caught in seconds, with its last line, and rolled back
SHIM_CRASHLOOP=1 OMARCHY_AI_TIMEOUT=60 "$CLI" load
[[ $(snap .error) == *"engine keeps crashing: OSError: [Errno 30] Read-only file system"* ]] || fail "crash loop" "$(snap .state) $(snap .error)"   # the previous model is back, so the state is ready with the reason beside it
[[ $(cat "$SHIM/containers/omarchy-local-ai-good-engine/state") == running && ! -d $SHIM/containers/omarchy-local-ai-good-engine-previous ]] || fail "crash loop rollback" "$(ls "$SHIM/containers")"; pass "a crash-looping engine is reported with its last log line and the previous model comes back"

# dynamic recipes: the vendored file is the floor, a newer registry copy is fetched and used, a stale or broken one is not
R_VENDORED="$ROOT/recipes.json"
RS() { OMARCHY_AI_RECIPES= OMARCHY_AI_RECIPES_URL=https://example.invalid/plugin/recipes.json "$CLI" "$@"; }
out=$(RS recipes); [[ $(jq -r .source <<<"$out") == vendored && $(jq -r .file <<<"$out") == "$R_VENDORED" ]] || fail "vendored by default" "$out"; pass "recipes: the vendored file is in use until a newer one is fetched"
jq -c '.generatedAt="2099-01-01T00:00:00Z" | .registryCommit="feedface00000000000000000000000000000000"' "$R_VENDORED" >"$SHIM/remote-recipes.json"
out=$(RS recipes update); [[ $out == "recipes: updated to registry feedface0000"* && -f $OMARCHY_AI_STATE/recipes.json && $(mode "$OMARCHY_AI_STATE/recipes.json") == 600 ]] || fail "refresh adopts a newer file" "$out"; pass "recipes update: a newer registry file is fetched, kept 0600 in the state dir, and used"
out=$(RS recipes); [[ $(jq -r .source <<<"$out") == live && $(jq -r .registryCommit <<<"$out") == feedface* ]] || fail "live in use" "$out"
[[ $(OMARCHY_AI_RECIPES= "$CLI" snapshot | jq -r '.registryFile.source + " " + .registry') == "live feedface00000000000000000000000000000000" ]] || fail "snapshot names the live file"; pass "the snapshot says which file is in use and its registry commit"
jq -c '.generatedAt="2000-01-01T00:00:00Z"' "$R_VENDORED" >"$SHIM/remote-recipes.json"
out=$(RS recipes update); [[ $out == "recipes: live is current"* && $(jq -r .registryCommit "$OMARCHY_AI_STATE/recipes.json") == feedface* ]] || fail "older file ignored" "$out"; pass "recipes update: an older registry file is ignored"
echo '{"schemaVersion":"omarchy-local-ai/recipes/1","hardware":"nope"}' >"$SHIM/remote-recipes.json"
out=$(RS recipes update 2>/dev/null) && fail "broken file accepted"; [[ $out == "recipes: the fetched file is not a recipes file"* && $(jq -r .registryCommit "$OMARCHY_AI_STATE/recipes.json") == feedface* ]] || fail "broken file refused" "$out"; pass "recipes update: a file that is not a recipes file is refused and the live copy stays"
out=$(SHIM_RECIPES_DOWN=1 RS recipes update 2>/dev/null) && fail "no route accepted"; [[ $out == "recipes: could not fetch the registry"* ]] || fail "no route reported" "$out"; pass "recipes update: no route is a sentence, nothing changes"
out=$(OMARCHY_AI_RECIPES= OMARCHY_AI_RECIPES_URL= "$CLI" recipes update); [[ $out == "recipes: refresh is off"* ]] || fail "refresh off" "$out"; pass "OMARCHY_AI_RECIPES_URL= turns the refresh off"
rm -f "$OMARCHY_AI_STATE/recipes.json"; jq -c '.generatedAt="2099-06-01T00:00:00Z" | .registryCommit="feedface00000000000000000000000000000000"' "$R_VENDORED" >"$SHIM/remote-recipes.json"
OMARCHY_AI_RECIPES= OMARCHY_AI_RECIPES_URL=https://example.invalid/r/recipes.json OMARCHY_AI_RECIPES_TTL=0 "$CLI" snapshot >/dev/null
for ((i=0; i<50; i++)); do [[ -f $OMARCHY_AI_STATE/recipes.json ]] && break; sleep 0.1; done   # the fetch is detached from the snapshot
[[ $(jq -r .generatedAt "$OMARCHY_AI_STATE/recipes.json" 2>/dev/null) == 2099-06-01T00:00:00Z ]] || fail "snapshot did not refresh"; pass "snapshot refreshes in the background once the TTL has passed"
rm -f "$OMARCHY_AI_STATE/recipes.json" "$OMARCHY_AI_STATE/recipes.checked"

# A recipe's published context and media claims must survive the gateway and agent configuration.
"$CLI" unload >/dev/null
write_recipes "$(recipe multimodal true asset | jq '.serving.ctxTokens=262144 | .capabilities += {vision:true,video:true,reasoning:null}')"
SHIM_CONTEXT=131072 "$CLI" load
[[ $(snap .state) == error && $(snap .error) == *"runtime context 131072 is below"* ]] || fail "context mismatch accepted" "$(snap .error)"; pass "a runtime advertising less context than the recipe fails acceptance"
SHIM_CONTEXT=262144 "$CLI" load
[[ $(snap .state) == ready && $(snap '.models[0].caps.video') == true && $(snap '.models[0].caps.reasoning') == null ]] || fail "media acceptance" "$(snap .error)"; pass "vision and video pass through the gateway and unknown capabilities stay unknown"
"$CLI" open-agent pi >/dev/null
jq -e '.providers["omarchy-local"].models[0] | .contextWindow==262144 and .input==["text","image"]' "$OMARCHY_AI_STATE/agents/pi/models.json" >/dev/null || fail "agent metadata"; pass "Pi receives the real 256K context and image input support"
cp "$TMP/bin/pi" "$TMP/bin/omp"
mkdir -p "$OMARCHY_AI_STATE/agents/omp"
printf 'providers: {stale: {baseUrl: "http://127.0.0.1:9999/v1"}}\n' >"$OMARCHY_AI_STATE/agents/omp/models.yml"
"$CLI" open-agent omp >/dev/null
jq -e '.providers["omarchy-local"] | .baseUrl=="http://127.0.0.1:12434/v1" and .models[0].id=="Test-Model" and .models[0].contextWindow==262144' "$OMARCHY_AI_STATE/agents/omp/models.yml" >/dev/null || fail "OMP retained stale model config"
[[ $(mode "$OMARCHY_AI_STATE/agents/omp/models.yml") == 600 ]] || fail "OMP config mode"; pass "OMP refreshes migrated YAML config when launching a different model"
jq -e '.providers["omarchy-local"].models[0].compat.supportsReasoningParams == false' "$OMARCHY_AI_STATE/agents/omp/models.yml" >/dev/null || fail "OMP overrides engine reasoning defaults"; pass "OMP leaves reasoning parameters to the engine defaults"
argv=$("$CLI" open-agent omp)
[[ $argv == *OMP_NO_WEBP=1* ]] || fail "OMP sends unsupported WebP images"; pass "OMP uses image formats supported by local decoders"
for a in grok opencode crush; do cp "$TMP/bin/pi" "$TMP/bin/$a"; done
argv=$("$CLI" open-agent grok)
[[ $argv == *GROK_HOME=* && $argv == *--model\ omarchy-local* && $argv != *GROK_CLI_CHAT_PROXY_BASE_URL* && $argv != *"$(cat "$OMARCHY_AI_STATE/gateway.key")"* ]] || fail "Grok uses cloud routing"
cfg="$OMARCHY_AI_STATE/agents/grok/config.toml"
grep -q '^model = "Test-Model"$' "$cfg" && grep -q '^context_window = 262144$' "$cfg" && grep -q '^env_key = "XAI_API_KEY"$' "$cfg" && [[ $(mode "$cfg") == 600 ]] || fail "Grok custom model config"
pass "Grok selects the local model and key through private custom-model configuration"
argv=$("$CLI" open-agent codex); [[ $argv == *model_context_window=262144* ]] || fail "Codex context"; pass "Codex receives the actual context window"
cat >"$TMP/bin/opencode" <<'EOF'
#!/usr/bin/env bash
printf '%s' "$OPENCODE_CONFIG_CONTENT"
EOF
argv=$("$CLI" open-agent opencode); out=$(eval "$argv")
jq -e '.provider["omarchy-local"].models["Test-Model"] | .limit.context==262144 and .modalities.input==["text","image"]' <<<"$out" >/dev/null || fail "OpenCode context and vision metadata"
pass "OpenCode receives the actual context and image input support"
"$CLI" open-agent crush >/dev/null
jq -e '.providers["omarchy-local"].models[0] | .context_window==262144 and .supports_attachments==true' "$OMARCHY_AI_STATE/agents/crush/crush/crush.json" >/dev/null || fail "Crush vision metadata"
pass "Crush enables image attachments for a model that passed vision acceptance"
cp "$TMP/bin/crush" "$TMP/bin/crush-real"
printf '#!/usr/bin/env bash\n# mise x crush\nexit 99\n' >"$TMP/bin/crush"
printf '#!/usr/bin/env bash\nprintf "%%s\\n" "%s"\n' "$TMP/bin/crush-real" >"$TMP/bin/mise"; chmod +x "$TMP/bin/mise"
argv=$("$CLI" open-agent crush); [[ $argv == *crush-real* ]] || fail "Crush ran the install wrapper"
pass "Crush resolves Omarchy's mise wrapper before changing XDG homes"
"$CLI" unload >/dev/null
SHIM_MEDIA_REPLY=Blue "$CLI" load
[[ $(snap .state) == error && $(snap .error) == *"vision acceptance failed"* ]] || fail "bad vision accepted" "$(snap .error)"; pass "incorrect image output fails readiness"
write_recipes "$(recipe multimodal true asset | jq '.capabilities += {vision:false,video:true}')"
SHIM_MEDIA_REPLY=Blue "$CLI" load
[[ $(snap .state) == error && $(snap .error) == *"video acceptance failed"* ]] || fail "bad video accepted" "$(snap .error)"; pass "incorrect video output fails readiness"

echo "1..$n"
