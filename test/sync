#!/usr/bin/env bash
# The registry authors recipes.json and publishes it at plugin/recipes.json; this repo only vendors
# that file. `make sync` takes the published export and `make sync-check` fails when the vendored copy
# has fallen behind it. This checks that contract without the registry checked out: it publishes the
# vendored copy as a stand-in, then asks what the check makes of a re-stamp and of a changed recipe.
#
# The two provenance fields (registryCommit, generatedAt) are the build's own stamp, derived from the last
# commit that touched registry/. A rebase and a squash both rewrite that commit, so those two values change
# while every exported recipe stays identical — the registry's own check drops them before comparing, and so does
# this one. A stamp-only difference must therefore pass and a genuinely stale copy must fail.
set -euo pipefail
ROOT=$(cd -- "${1:-$(dirname -- "${BASH_SOURCE[0]}")/..}" && pwd -P)
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
n=0
pass() { n=$((n+1)); echo "ok $n - $1"; }
fail() { echo "not ok - $1${2:+: $2}" >&2; exit 1; }

VENDORED="$ROOT/recipes.json"
REG="$TMP/registry/plugin"
mkdir -p "$REG"
cp "$VENDORED" "$REG/recipes.json"
cp "$VENDORED" "$TMP/vendored.json"
# `make sync` writes the repo's own recipes.json, so put back what was there on any exit
trap 'cp "$TMP/vendored.json" "$VENDORED"; rm -rf "$TMP"' EXIT

check() { (cd "$ROOT" && make sync-check REGISTRY="$TMP/registry" 2>&1); }

out=$(check) || fail "the vendored copy is not current with itself" "$out"
pass "the vendored copy is current with the export it was taken from"

# a registry that only re-stamped its build changed no recipe
jq -c '.registryCommit="deadbeef00000000000000000000000000000000" | .generatedAt="2099-01-01T00:00:00Z"' \
  "$REG/recipes.json" >"$TMP/x" && mv "$TMP/x" "$REG/recipes.json"
out=$(check) || fail "a re-stamp was reported as drift" "$out"
pass "a registry re-stamp alone is not drift"

# a card the registry withdrew is drift, and the check names it
first=$(jq -r '.hardware | keys | .[0]' "$VENDORED")
[[ -n $first ]] || fail "the vendored copy has no hardware to withdraw"
jq -c --arg h "$first" 'del(.hardware[$h])' "$REG/recipes.json" >"$TMP/x" && mv "$TMP/x" "$REG/recipes.json"
out=$(check) && fail "a withdrawn card was accepted" "$out"
[[ $out == *"$first"* ]] || fail "the withdrawn card is not named" "$out"
pass "a card the registry withdrew is drift, and the check names it"

# and sync takes what the registry published, stamp and all
out=$(cd "$ROOT" && make sync REGISTRY="$TMP/registry" 2>&1) || fail "sync failed" "$out"
[[ $(jq -r .registryCommit "$VENDORED") == deadbeef* ]] || fail "sync did not take the published file" "$out"
pass "sync takes the published export verbatim, stamp and all"

echo "1..$n"
