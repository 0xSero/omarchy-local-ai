#!/usr/bin/env python3
"""Native wheel/key/navigation checks; run on Omarchy with QtTest installed."""
from pathlib import Path
import json,os,subprocess,shutil,tempfile
source=Path(__file__).resolve().parent.parent
fixture=tempfile.TemporaryDirectory(prefix='local-ai-navigation-')
base=Path(fixture.name)
shutil.copytree(source/'ui',base/'ui')
shell=Path(os.environ.get('OMARCHY_PATH','/usr/share/omarchy'))/'shell'
for name in ['Commons','Ui']:
    p=base/name
    if not p.exists(): p.symlink_to(shell/name)
state=base/'state/omarchy/local-ai';state.mkdir(parents=True,exist_ok=True)
agent_names=['pi','opencode','crush','omp']+[f'agent{i}' for i in range(12)]
group=dict(hardwareId='test-gpu',name='Test GPU with a long descriptive name',count=2,keys=['nvidia:0','nvidia:1'],vramGb=24)
model=dict(recipeId='test-model',name='Test model with a long descriptive name',state='ready',keys=group['keys'],cards=2,port=12434,launchable=agent_names,ctxTokens=100000,decodeTps=42,tokensToday=123,usageSince='2026-09-21T00:00:00Z',caps={'chat':True},kvTokens=100000)
recipes=[dict(id='test-model' if i==0 else f'model{i}',name=f'Test model {i}',hardwareId='test-gpu',cards=1 if i else 2,onDisk=True,ctxTokens=100000,caps={'chat':True}) for i in range(30)]
snap=dict(state='ready',operation={},models=[model],gpus=[],cards=[group],recipes=recipes,agents={'default':'pi','directory':'/tmp/test-project'},share={'available':True},error='',reason='',update={'enabled':True,'plugin':{},'recipes':{}})
(state/'snapshot.json').write_text(json.dumps(snap))
(base/'bin').mkdir(exist_ok=True)
stub=base/'bin/omarchy-local-ai';stub.write_text('#!/bin/sh\n[ "$1" = snapshot ] || exit 99\ncat "$XDG_STATE_HOME/omarchy/local-ai/snapshot.json"\n');stub.chmod(0o700)
env=dict(os.environ,QT_QPA_PLATFORM='wayland',XDG_STATE_HOME=str(base/'state'),OMARCHY_PATH=str(shell.parent))
(base/'shell.qml').write_text((source/'test/navigation.qml').read_text().replace('../ui','ui'))
p=subprocess.run(['qs','-n','-p',str(base)],env=env,capture_output=True,text=True,timeout=55)
log=p.stdout+p.stderr;(base/'test.log').write_text(log);print(log)
assert log.count('NAV_PASS')==42, f"scroll cases passed: {log.count('NAV_PASS')}/42"
assert log.count('FLOW_PASS')==2, f"flow cases passed: {log.count('FLOW_PASS')}/2"
assert log.count('CRUMB_PASS')==2, f"breadcrumb cases passed: {log.count('CRUMB_PASS')}/2"
assert not any(x in log for x in ['ReferenceError','TypeError','Failed to load','Binding loop','NAV_FAIL'])
